# barkpark-provisioner worker env — the systemd EnvironmentFile at
# barkpark-cp:/etc/barkpark-provisioner.env. Read by cmd/barkpark-provisioner.
# Never commit real values; this file documents the contract only.

# ── Job queue / worker principal ─────────────────────────────────────────────
WORKER_TOKEN=your_worker_token_here          # shared secret; Authorization: Bearer

# ── Provisioning ─────────────────────────────────────────────────────────────
WARM_POOL_SIZE=2                             # 0 (default) = warm pool DISABLED, one-shot only
BARKPARK_SERVER_IMAGE=405181298              # fallback warm-pool snapshot id
BARKPARK_DNS_HCLOUD_TOKEN=your_dns_token     # barkpark.cloud-zone DNS token (see cloud/postfix/README.md §1)

# ── Portable-archive resurrect drain (charter S14f) ──────────────────────────
# The RESTORE queue pulls a bp-bundle-v1 archive out of object storage and rebuilds
# a box from it (cross-provider). The store creds + KEK come from the WORKER ENV —
# NEVER the claim JSON — so the drain reads them here. Unset => resurrect jobs fail
# HONESTLY (the worker still provisions); set them to light the drain up. The S3
# credentials + bucket are the SAME ones the archive command uses, minted once in
# the Hetzner Console under Object Storage (there is no API for the credential mint);
# the KEK is the operator secret the archive's identity secrets were sealed with —
# a resurrect CARRIES it, so it MUST match the value the box was archived under.
HETZNER_S3_ACCESS_KEY=your_s3_access_key     # Object Storage access key (Console-minted)
HETZNER_S3_SECRET_KEY=your_s3_secret_key     # Object Storage secret key (Console-minted)
BARKPARK_BUNDLE_BUCKET=barkpark-archives     # the bucket bundles are written to / read from
BARKPARK_BUNDLE_KEK=your_bundle_kek          # AES-256-GCM key sealing the bundle's identity secrets
BARKPARK_BUNDLE_S3_LOCATION=fsn1             # optional; defaults to fsn1 (fsn1/nbg1/hel1)

# ── Transactional mail relay (instance-injected) ─────────────────────────────
# The SHARED relay every provisioned instance is pointed at so magic-link /
# password-reset / verify-email deliver. Injected into each new box's
# /opt/barkpark/.env at go-live (secrets-install step). Unset => instances ship
# without SMTP (Local adapter, no delivery). A partial/malformed set is logged
# ("mail relay DISABLED — …") at worker startup and skipped. See deploy/README.md.
SMTP_RELAY_HOST=mail.barkpark.cloud
SMTP_RELAY_PORT=587                          # optional; defaults to 587
SMTP_RELAY_USERNAME=barkpark-cloud           # SASL user (= cloud/.env SMTP_USERNAME)
SMTP_RELAY_PASSWORD=your_relay_password_here # SASL secret (= cloud/.env SMTP_PASSWORD)
