# Transactional SMTP relay for the api/ app (Barkpark.Mailer) — verify-email,
# password-reset, and already-registered notices (Barkpark.Accounts.UserNotifier).
# Read by api/config/runtime.exs. Source via: set -a; source deploy/smtp.env; set +a
#
# Until SMTP_HOST is set, Barkpark.Mailer stays on Swoosh.Adapters.Local (an
# in-memory mailbox that NEVER delivers) — identity emails silently drop. Set
# SMTP_HOST in the prod .env (EnvironmentFile) to actually send.
#
# Same SMTP_* vocabulary as the cloud control plane, so one env file can drive
# both apps through the shared postfix relay. Never commit real values.

# REQUIRED to activate delivery. Unset => fall back to the Local adapter.
SMTP_HOST=relay.barkpark.cloud

# OPTIONAL. Defaults to 587 (submission / STARTTLS) when unset.
SMTP_PORT=587

# OPTIONAL. Omit both for an unauthenticated local relay hop (e.g. the postfix
# sidecar on the internal network). When set, SMTP AUTH is required.
SMTP_USERNAME=postmaster@barkpark.cloud
SMTP_PASSWORD=your_relay_password_here

# OPTIONAL. TLS peer verification is ON by default. Set to `false` ONLY for a
# trusted internal relay with a self-signed cert (e.g. the postfix sidecar).
# A public third-party relay MUST keep this on.
SMTP_VERIFY_PEER=true
