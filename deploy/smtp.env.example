# Transactional SMTP relay for the api/ app (Barkpark.Mailer) — verify-email,
# password-reset, and already-registered notices (Barkpark.Accounts.UserNotifier).
# Read by api/config/runtime.exs. Source via: set -a; source deploy/smtp.env; set +a
#
# Until SMTP_HOST is set, Barkpark.Mailer stays on Swoosh.Adapters.Local (an
# in-memory mailbox that NEVER delivers) — identity emails silently drop. Set
# SMTP_HOST in the prod .env (EnvironmentFile) to actually send.
#
# Same SMTP_* vocabulary as the cloud control plane, so one env file can drive
# both apps through the shared postfix relay. Never commit real values.

# REQUIRED to activate delivery. Unset => fall back to the Local adapter.
SMTP_HOST=mail.barkpark.cloud

# OPTIONAL. Defaults to 587 (submission / STARTTLS) when unset.
SMTP_PORT=587

# OPTIONAL. Omit both for an unauthenticated local relay hop (e.g. the postfix
# sidecar on the internal network). When set, SMTP AUTH is required.
SMTP_USERNAME=postmaster@barkpark.cloud
SMTP_PASSWORD=your_relay_password_here

# OPTIONAL. TLS peer verification is ON by default. Set to `false` ONLY for a
# trusted internal relay with a self-signed cert (e.g. the postfix sidecar).
# A public third-party relay MUST keep this on.
SMTP_VERIFY_PEER=true

# ---------------------------------------------------------------------------
# The From identity (gh-9531). SEPARATE from the transport above on purpose: a
# relay only carries the message, it does not decide who it claims to be from.
#
# YOU ALMOST CERTAINLY NEED THIS IF YOU SET SMTP_HOST. Most relays reject a
# message whose From is not the address you authenticated as (and where they
# don't, the receiving domain SPF/DKIM/DMARC-fails it). Delivery is
# fire-and-forget, so a rejection is INVISIBLE: register / request-reset still
# answer HTTP 200 and the mail is simply never delivered.
#
# Read at call time by Barkpark.Mailer.from/0 via api/config/runtime.exs, so a
# release picks these up at BOOT — no rebuild. Same MAIL_FROM_* vocabulary as
# the cloud control plane.

# OPTIONAL. Defaults to no-reply@barkpark.cloud when unset. Set this to an
# address your relay is authorised to send as. A malformed value FAILS THE BOOT
# rather than silently falling back — a wrong sender you believe is right is the
# whole bug this replaces.
MAIL_FROM_ADDRESS=no-reply@your-domain.example

# OPTIONAL. The display name shown in the recipient's inbox. Defaults to
# "Barkpark" when unset; set it to "" for a bare-address From.
MAIL_FROM_NAME=Your Organisation
