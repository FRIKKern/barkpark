# Node-slot SSR unit for a spawned Barkpark site (Site-Spawner W7, charter
# D69/D70). ONE generic template drives EVERY node site's EVERY slot: %i is
# `<slug>__<slot>` (e.g. `my-blog__a` / `my-blog__b`). Installed + driven by
# deploy/site-deploy-node.sh, which — blue/green — writes the idle slot's
# EnvironmentFile, `systemctl start`s it, health-gates its port, then flips
# Caddy's per-site reverse_proxy to it. Two slots per site run side by side
# during the swap window (and the current + one warm-previous stay up for <1s
# rollback); Caddy's upstream port is the source of truth for which is live.
[Unit]
Description=Barkpark spawned node SSR site (slot %i)
Documentation=file:///opt/barkpark/deploy/README.md
After=network.target

[Service]
Type=simple
User=root
# The env file is regenerated by site-deploy-node.sh each deploy. It carries
# PORT (the loopback port Caddy proxies to), HOSTNAME=127.0.0.1 (so Next binds
# loopback, never the public interface), RELEASE_DIR (the immutable
# releases/<build_id>/ standalone dir this slot serves) and the per-site
# BARKPARK_* runtime vars SSR fetches content with. It is written 0600 — it holds
# the site read token.
EnvironmentFile=/opt/barkpark/.slots/%i.env
# barkpark-node is a STABLE symlink the deploy materialises at the resolved asdf
# node (`asdf where nodejs`) — NEVER the asdf shim (an unpinned shim exits 126 and
# would crash-loop this unit) and NEVER a version-pinned path (a node upgrade must
# not require editing every unit). systemd cannot expand a variable in the
# executable position, hence the fixed symlink; ${RELEASE_DIR} DOES expand in the
# argument position. Next's standalone server.js self-chdir()s to its own dir, so
# no WorkingDirectory is needed (and systemd could not expand an EnvironmentFile
# var there anyway).
ExecStart=/usr/local/bin/barkpark-node ${RELEASE_DIR}/server.js
Restart=on-failure
RestartSec=2

# ---- Resource bounds (charter D67 density) --------------------------------
# A per-site node process is always resident (65-85MB RSS) and spends request-time
# CPU on the box's ~2 cores — unlike a static site (0 resident, disk-bound). Cap
# both so one busy or leaking site cannot starve Phoenix or its neighbours; the
# density tradeoff is documented in deploy/README.md §"Static vs node density".
MemoryMax=512M
CPUQuota=100%

# ---- Hardening ------------------------------------------------------------
# Tenant-adjacent code runs here (the site's own build output), so lock the
# process down: no privilege escalation, a read-only view of the filesystem
# (PrivateTmp gives it a writable /tmp for any scratch), and no access to /home
# or other users' runtime dirs.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
