[Unit]
Description=Rotate Barkpark public-read API token
Documentation=file:///opt/barkpark/deploy/systemd/README.md
After=network-online.target barkpark.service
Wants=network-online.target
Requires=barkpark.service
# A failed WEEKLY rotation is the worst silence in this tree: the public-read
# token simply never rotates and nothing says so. `%n` hands the handler this
# unit's own name. NOT on the .timer — see barkpark-unit-failure-alert@.service.
OnFailure=barkpark-unit-failure-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/barkpark/api
EnvironmentFile=/opt/barkpark/.env
ExecStart=/opt/barkpark/api/start.sh rotate-public-read
