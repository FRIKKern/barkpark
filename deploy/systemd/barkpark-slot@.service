# Blue/green slot unit for a Barkpark content instance — %i is `blue` or
# `green`. Installed + driven by deploy/instance-deploy.sh (which also writes
# /opt/barkpark/.slots/%i.env with the slot's PORT override and MIX_BUILD_ROOT
# so both slots run side by side out of the same checkout). Exactly one slot
# is enabled at a time; host Caddy proxies the public hostname to it.
[Unit]
Description=Barkpark content instance (slot %i)
Documentation=file:///opt/barkpark/deploy/README.md
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=root
# NAME-ENCODING PIN. The VM's filename encoding mode is pinned here instead of
# inherited from the host image: on the live box file:native_name_encoding() is
# utf8 only by a host-image accident — this unit used to set no Environment= at
# all, and LANG=en_US.UTF-8 arrived from /etc/default/locale through systemd's
# MANAGER environment (measured in /proc/<MainPID>/environ; `systemctl show -p
# Environment` prints an empty Environment= that answers nothing). Replaying
# that environ under `env -i` returns utf8; stripping LANG returns latin1 from
# the same erl, with Elixir printing "the VM is running with native name
# encoding of latin1 which may cause Elixir to malfunction" (LANG=C is latin1
# too) — so a fresh image without /etc/default/locale boots this code in latin1.
# C.UTF-8 needs no locale package on Ubuntu 24.04. It sits BEFORE
# EnvironmentFile= on purpose: a per-slot env file (or an operator export in
# .env, see api/start.sh) still overrides it. THIS IS NOT A STAGING FIX — see
# api/start.sh for what it is and is not for, and for the measurement trap.
Environment=LANG=C.UTF-8
EnvironmentFile=/opt/barkpark/.slots/%i.env
ExecStart=/opt/barkpark/api/start.sh
Restart=on-failure
RestartSec=5
# task-234799142dfd8559: `systemctl disable --now` (instance-deploy.sh's old-
# slot retirement) sends SIGTERM and BLOCKS until the unit reports inactive —
# either the BEAM exits on its own (a graceful OTP application stop) or this
# deadline elapses and systemd SIGKILLs it, which would abort whatever is
# mid-drain rather than let it finish.
#
# THE ARITHMETIC (read before changing either side of it).
# Barkpark.Application's children stop in REVERSE start order (plain OTP), and
# `BarkparkWeb.Endpoint` is explicitly "typically the last entry" in that list
# (api/lib/barkpark/application.ex) — so it is the FIRST child this VM stops,
# not the last. It drains an in-flight HTTP request for up to
# thousand_island_options: [shutdown_timeout: 20_000] (api/config/runtime.exs).
# AFTER that, stopping continues back through everything started later than
# Oban (DeployRunner, SelfUpdate.Runner, the sync/self-update children,
# WebhookDeliverySupervisor, the two WorkspaceBundle guards, TaskSupervisor,
# Presence, Capability.Supervisor, Sheets.Supervisor, PubSub, DNSCluster) and
# only THEN reaches `Oban`, whose queue supervisor's own childspec `:shutdown`
# is `conf.shutdown_grace_period` (deps/oban/lib/oban/queue/supervisor.ex) —
# `:timer.seconds(15)` by Oban's own default, confirmed in
# deps/oban/lib/oban/config.ex, and Barkpark sets no override
# (config/config.exs's `config :barkpark, Oban` + config/runtime.exs both
# leave it unset). So a SERIAL worst case is 20s (Endpoint) + 15s (Oban) =
# 35s, BEFORE a single one of those other children's own (normally
# near-instant, but unmeasured here) teardown time. 35s would leave that sum
# NO margin — exactly the failure mode of SIGKILLing an in-flight Oban job
# mid-run. 60s instead: comfortable slack above the 20+15 floor for
# everything else in the list, still far short of systemd's 90s default
# agreeing with Bandit's 15s default by COINCIDENCE rather than by a
# maintained invariant.
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
