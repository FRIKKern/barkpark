# Blue/green slot unit for a Barkpark content instance — %i is `blue` or
# `green`. Installed + driven by deploy/instance-deploy.sh (which also writes
# /opt/barkpark/.slots/%i.env with the slot's PORT override and MIX_BUILD_ROOT
# so both slots run side by side out of the same checkout). Exactly one slot
# is enabled at a time; host Caddy proxies the public hostname to it.
[Unit]
Description=Barkpark content instance (slot %i)
Documentation=file:///opt/barkpark/deploy/README.md
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=root
# NAME-ENCODING PIN. The VM's filename encoding mode is pinned here instead of
# inherited from the host image: on the live box file:native_name_encoding() is
# utf8 only by a host-image accident — this unit used to set no Environment= at
# all, and LANG=en_US.UTF-8 arrived from /etc/default/locale through systemd's
# MANAGER environment (measured in /proc/<MainPID>/environ; `systemctl show -p
# Environment` prints an empty Environment= that answers nothing). Replaying
# that environ under `env -i` returns utf8; stripping LANG returns latin1 from
# the same erl, with Elixir printing "the VM is running with native name
# encoding of latin1 which may cause Elixir to malfunction" (LANG=C is latin1
# too) — so a fresh image without /etc/default/locale boots this code in latin1.
# C.UTF-8 needs no locale package on Ubuntu 24.04. It sits BEFORE
# EnvironmentFile= on purpose: a per-slot env file (or an operator export in
# .env, see api/start.sh) still overrides it. THIS IS NOT A STAGING FIX — see
# api/start.sh for what it is and is not for, and for the measurement trap.
Environment=LANG=C.UTF-8
EnvironmentFile=/opt/barkpark/.slots/%i.env
ExecStart=/opt/barkpark/api/start.sh
Restart=on-failure
RestartSec=5
# task-234799142dfd8559: `systemctl disable --now` (instance-deploy.sh's old-
# slot retirement) sends SIGTERM and BLOCKS until the unit reports inactive —
# either the BEAM exits on its own (a graceful OTP application stop, which
# drains any in-flight HTTP request through Bandit's own
# thousand_island_options: [shutdown_timeout: 20_000], see config/runtime.exs)
# or this deadline elapses and systemd SIGKILLs it. 35s, not systemd's 90s
# default: still generous margin ABOVE the 20s drain bound (for the BEAM's
# own supervision-tree teardown beyond just the HTTP listener — Oban,
# Ecto pools, etc.), but an explicit, read invariant instead of two unrelated
# defaults (systemd's 90s, Bandit's internal 15s) that happen to agree today
# and could silently stop agreeing on either project's next version bump.
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
