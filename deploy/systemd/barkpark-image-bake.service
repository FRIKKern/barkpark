# barkpark-image-bake.service — one nightly warm-image bake run
# (snapshot-management; installed + kept current by deploy/cp-deploy.sh).
# The script is a no-op when the newest bake already matches origin/main or the
# drift is box-irrelevant; a real bake (boot + rebuild + snapshot + prune) runs
# well under the hour bound. Manual run: systemctl start barkpark-image-bake.
[Unit]
Description=Barkpark warm-image nightly bake (snapshot-management)
Wants=network-online.target
After=network-online.target
# A failed nightly bake is otherwise invisible: the timer keeps firing, the warm
# pool keeps serving the last good snapshot, and it ages silently. `%n` hands the
# handler this unit's own name. NOT on the .timer — a timer's OnFailure= fires
# only if the TIMER fails to activate, never when the job it triggered errored.
OnFailure=barkpark-unit-failure-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/barkpark-provisioner.env
ExecStart=/usr/local/bin/barkpark-bake-server-image
TimeoutStartSec=3600
