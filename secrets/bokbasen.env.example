# Bokbasen credentials — DEV ONLY. Never commit real values.
# Source via: set -a; source secrets/bokbasen.env; set +a
BOKBASEN_API_BASE=https://api.bokbasen.io
BOKBASEN_OAUTH_TOKEN_URL=https://login.bokbasen.io/oauth2/token
BOKBASEN_CLIENT_ID=your_client_id_here
