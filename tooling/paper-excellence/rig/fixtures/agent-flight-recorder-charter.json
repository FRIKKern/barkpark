          "children": [
            {
              "type": "text",
              "value": "Existing seams this rides: "
            }
          ],
          "type": "strong"
        },
        {
          "type": "code",
          "value": "Tasks.claim/close (epoch CAS) · mutation_events durable-then-ack · task.pulse now-line · ttl_sweeper lease_expired · audit-emit · ticket-key identity pattern"
        },
        {
          "type": "text",
