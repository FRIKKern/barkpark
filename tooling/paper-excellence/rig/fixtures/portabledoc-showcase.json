    {
      "content": [
        {
          "type": "text",
          "value": "A diagnosis flow as content: a sequence diagram sets the scene, a pipeline names the stages, notes carry the gotchas."
        }
      ],
      "id": "fd-085",
      "type": "paragraph"
    },
    {
      "caption": "The incident path this runbook walks.",
      "id": "fd-086",
      "source": "sequenceDiagram\n  Pager->>Oncall: fires\n  Oncall->>Prod: inspect slot\n  Prod-->>Oncall: blue is stale\n  Oncall->>Prod: flip + verify",
      "type": "diagram"
    },
    {
      "id": "fd-087",
      "nodes": [
        {
          "detail": "smoke test reds",
          "kind": "detect",
          "title": "alert"
        },
        {
          "detail": "caddy upstream = slot truth",
          "kind": "diagnose",
          "source": true,
          "title": "inspect"
        },
        {
          "detail": "blue/green hot-swap",
          "kind": "fix",
          "title": "flip"
        },
        {
          "detail": "schemas + studio + query",
          "kind": "verify",
          "title": "curl"
        }
      ],
      "type": "pipeline"
    },
    {
      "id": "fd-088",
      "items": [
        {
          "label": "G1",
          "lead": "Never partial-clean.",
          "text": "Nuke all of _build/prod or HEEx goes stale."
        },
        {
          "label": "G2",
          "lead": "Restart the BEAM.",
          "text": "Compiled code is not running code."
        },
        {
          "label": "G3",
          "lead": "Test after deploy.",
          "text": "curl the schemas endpoint at minimum."
        }
      ],
      "type": "notes"
