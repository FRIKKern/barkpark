# The directory Mix will write compiled artifacts to.
/_build

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Runtime secrets for docker compose — NEVER commit. Use .env.example as the
# template; the real .env carries DATABASE_URL / REGISTRY_ENCRYPTION_KEY /
# STRIPE_SECRET_KEY etc.
.env

# Screenshots produced by the SPA preview harness (make cloud-shots) — a build
# artifact, never committed. The fixtures + tooling in __preview__/ ARE tracked.
priv/static/__preview__/__shots__/

# Pre-compressed static siblings (priv/static/app.js.gz, app.css.gz). The
# router's Plug.Static serves these when `gzip: true` finds them, but they are
# BORN IN THE IMAGE — cloud/Dockerfile gzips them from the bytes `COPY priv
# priv` just laid down, in the same build. A committed .gz is the one way that
# invariant can break: it would ship whatever bytes it held on the day it was
# committed, and Plug.Static would serve it in preference to the fresh source
# with no way to notice. Before this line nothing ignored one
# (`git check-ignore cloud/priv/static/app.css.gz` returned rc 1), so a local
# `gzip -k` in the wrong directory was one `git add .` from prod.
# scripts/cloud-static-gz-guard.sh is the tripwire for the `git add -f` path
# this cannot stop.
*.gz
