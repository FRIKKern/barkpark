# Barkpark Cloud control plane — environment template.
#
# Copy to `.env` and fill in real values, OR `export` these in your shell before
# `docker compose up`. The values below are PLACEHOLDERS — never commit real
# secrets. `.env` is gitignored.
#
# runtime.exs (MIX_ENV=prod) RAISES at boot if a REQUIRED var is missing, so the
# control plane fails fast rather than serving half-configured.

# ── REQUIRED — the container will not boot without these ──────────────────────

# Postgres connection for the control plane's OWN database (metadata only, never
# customer content). ecto:// scheme. With the bundled `db` compose service the
# default in docker-compose.yml already points here; set this only to use an
# external Postgres. Format: ecto://USER:PASS@HOST:PORT/DATABASE
DATABASE_URL=ecto://barkpark_cloud:CHANGE_ME@db/barkpark_cloud_prod

# At-rest AES-256-GCM key for connected-provider tokens — a Base64 32-byte key.
# Generate one (do NOT reuse this placeholder):
#   openssl rand -base64 32
REGISTRY_ENCRYPTION_KEY=GENERATE_A_BASE64_32_BYTE_KEY_DO_NOT_USE_THIS

# Stripe secret key. A test key (sk_test_…) satisfies boot and exercises the
# same request shape at zero spend; the LIVE key is a human go-live decision.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# ── OPTIONAL — boots without them, features fail closed until set ─────────────

# Stripe webhook signing secret (whsec_…). Until set, webhook verification
# returns :webhook_secret_not_configured.
STRIPE_WEBHOOK_SECRET=

# Shared bearer token the off-box Go warm-pool provisioner presents to the
# /v1/internal/* endpoints. Until set, every internal request 401s (fail-closed).
# Hand the SAME value to the provisioner (--token / --token-file).
WORKER_TOKEN=

# Platform-operator allowlist: comma-separated emails of accounts that are
# ALREADY REGISTERED on this control plane (an unregistered address is silently
# dropped — the allowlist resolves every entry against a real user before it is
# ever trusted or mailed). There is no platform-admin flag on a user; this list
# IS the operator principal.
#
# Unset/blank = nobody is an operator, and that fails CLOSED both ways: /v1/me
# reports platform_operator:false for everyone, so the Operator console link
# hides and all /v1/operator/* routes 403 — and the daily fleet digest stays a
# logged no-op. Setting it takes effect on the next control-plane boot
# (deploy/cp-deploy.sh).
#
#   PLATFORM_ADMIN_EMAILS=ops@example.com,admin@example.com
PLATFORM_ADMIN_EMAILS=

# ── TUNABLES — sensible defaults, override only if needed ─────────────────────

# Blue/green: which control-plane slot plain `docker compose up -d` starts
# (deploy/cp-deploy.sh alternates slots itself; outside that flow use blue).
COMPOSE_PROFILES=blue

# Host ports the blue/green slots publish (the container always listens on
# 4100 internally; Caddy proxies barkpark.cloud to the active slot's port).
PORT_BLUE=4100
PORT_GREEN=4101

# Ecto connection pool size (default 10).
POOL_SIZE=10

# How many Barkpark instances an account may run, per plan tier. These are the
# code-side defaults (cloud/config/runtime.exs) — leave them alone unless you
# are running your own control plane with different tiers. Set to a whole
# number; a non-numeric value raises at boot rather than silently meaning zero.
LIMIT_FREE=1
LIMIT_TRIAL=1
LIMIT_SUPPORTER=3
LIMIT_SUPPORT_PLUS=10

# ── Mail (notifications-email) ─────────────────────────────────────────────
# Self-hosted by default: the bundled `postfix` service (cloud/postfix/) is an
# outbound relay with DKIM signing — no third-party provider required. Until
# SMTP_USERNAME/PASSWORD are set, password-reset/invite emails fail closed
# (a `failed` row in notification_deliveries, no send). See
# cloud/postfix/README.md for the DNS records and Hetzner prerequisites this
# needs to actually deliver mail, not just accept it locally.

# Shared submission credential between control_plane and the postfix sidecar.
# Generate with: openssl rand -base64 24
SMTP_USERNAME=
SMTP_PASSWORD=

# Relay host reachable from control_plane (default: the bundled postfix
# service's compose hostname). Point this at a real provider's SMTP host
# instead — with SMTP_VERIFY_PEER=true — to switch away from self-hosting.
SMTP_HOST=postfix
SMTP_PORT=587

# Skip TLS peer verification for the internal docker-network hop to the
# self-hosted postfix sidecar. MUST be unset/"true" for any external relay.
SMTP_VERIFY_PEER=false

# From address / display name for outgoing mail.
MAIL_FROM_ADDRESS=noreply@barkpark.cloud
MAIL_FROM_NAME=Barkpark Cloud

# The self-hosted relay's own identity (DKIM d=, HELO, PTR). Only change
# these if you rebuild cloud/postfix with a different domain/selector.
MAIL_HOSTNAME=mail.barkpark.cloud
MAIL_DOMAIN=barkpark.cloud
DKIM_SELECTOR=mail

# ── Push relay (mobile charter D15) — THE HUMAN GATE ───────────────────────
# The needs-you push relay is BUILT, TESTED and INERT. These variables are the
# only thing between it and real notifications: set them, restart the control
# plane, done. With them unset, BarkparkCloud.Push.adapter_for/1 resolves to
# Adapters.NotConfigured and every send cancels terminally — no flag to flip,
# no dead code, no half-delivered state. The two platforms are INDEPENDENT:
# shipping Android alone is a valid configuration.
#
# Acquisition steps (which console page, what each value looks like, and the
# CLIENT-side entitlements that must ship in the same wave) are documented in
# full in the moduledoc of BarkparkCloud.Push.Adapters.NotConfigured
# (cloud/lib/barkpark_cloud/push/adapters/not_configured.ex). Read it before
# opening the gate.
#
# One more step AFTER these: POST /v1/barkparks/:id/push-relay (team admin) to
# provision the instance-side chat_blocked webhook row. Credentials alone do
# not make an instance send; that route is what makes it knock.

# iOS / APNs — needs the Apple Developer ACCOUNT HOLDER.
# The full .p8 auth key contents (developer.apple.com → Keys → new key with the
# APNs service enabled; the file downloads exactly once). Literal "\n" escapes
# are expanded, so a single-line env value is fine.
APNS_KEY_P8=
# The 10-char Key ID of that .p8.
APNS_KEY_ID=
# The 10-char Team ID (developer portal → Membership details).
APNS_TEAM_ID=
# The app bundle identifier — also the apns-topic. Must match
# apps/mobile/app.json → expo.ios.bundleIdentifier.
APNS_BUNDLE_ID=
# "sandbox" (default; development/TestFlight-dev builds) or "production"
# (App Store / TestFlight distribution). The WRONG value 400s every send with
# BadDeviceToken on a perfectly valid token.
APNS_ENV=sandbox

# Android / FCM — needs the Firebase PROJECT OWNER.
# The entire service-account key file, verbatim JSON (console.firebase.google.com
# → Project settings → Service accounts → Generate new private key). The project
# needs the Firebase Cloud Messaging API (V1) enabled.
FCM_SERVICE_ACCOUNT_JSON=

# ── OAuth SSO — hard boot raise + two optional providers ─────────────────────

# HMAC key for the single-use OAuth CSRF state token. REQUIRED in prod:
# runtime.exs raises rather than sign with a guessable default. Generate one:
#   mix run -e 'IO.puts(:crypto.strong_rand_bytes(32) |> Base.encode64())'
OAUTH_STATE_SECRET=

# Public origin the provider callback is registered under. The redirect_uri is
# DERIVED, never stored — register `<base>/v1/auth/oauth/<provider>/callback`
# in each provider's app. A BARE `OAUTH_BASE_URL=` line is NOT the same as
# leaving it out: it defeats both runtime.exs's `|| "https://barkpark.cloud"`
# fallback AND compose's `${OAUTH_BASE_URL:-…}` default, leaving an empty base.
# Keep the whole line commented unless you are setting a real origin.
#   OAUTH_BASE_URL=https://cp.example.com

# Per-provider app credentials. A provider is ENABLED only when BOTH its id and
# secret are present; unset/blank = that provider's route is not advertised and
# not routable. The two providers are INDEPENDENT.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Stripe — prices and return URLs (the PAID path stays inert without them) ──

# The per-plan Stripe price ids. With neither wired the control plane still
# boots and the FREE TRIAL works; it only WARNs that no paid subscription can
# complete. Whole-line commented on purpose: `STRIPE_PRICE_SUPPORTER=` survives
# runtime.exs's `Enum.reject(is_nil)`, so a blank reads as a WIRED price and a
# checkout resolves to an empty id instead of reporting plan_invalid.
#   STRIPE_PRICE_SUPPORTER=price_REPLACE_ME
#   STRIPE_PRICE_SUPPORT_PLUS=price_REPLACE_ME

# Where Stripe Checkout / the Customer Portal send the customer back. Unset =
# the gateway's own prod-domain fallback. Set these on a staging or self-hosted
# plane so a customer returns to the SAME host they checked out from. Blank is
# NOT unset here either — it hands Stripe an empty return URL.
#   STRIPE_SUCCESS_URL=https://cp.example.com/?billing=success
#   STRIPE_CANCEL_URL=https://cp.example.com/?billing=cancelled
#   STRIPE_PORTAL_RETURN_URL=https://cp.example.com/?billing=portal

# Free-trial length in days (default 14). Whole-line commented: a blank value
# reaches `String.to_integer("")` and RAISES at boot.
#   TRIAL_DAYS=14

# ── GitHub App (connect / deploy) — HUMAN-LAST, off is a valid state ─────────
# With the App id AND private key both set, the real GitHub client goes live.
# Without them every GitHub endpoint 503s feature_not_configured and the plane
# still boots — exactly like a plugin being off.

# The numeric App id. Whole-line commented: `GITHUB_APP_ID=` is TRUTHY in
# runtime.exs's `app_id && private_key && private_key != ""` gate, so a blank
# here plus a real key selects the live client with an empty App id.
#   GITHUB_APP_ID=000000

# The App's RSA private key, PEM contents. A blank value is explicitly treated
# as absent, so a bare line is safe.
GITHUB_APP_PRIVATE_KEY=

# Webhook signing secret for the App's deliveries.
GITHUB_APP_WEBHOOK_SECRET=

# The App's URL slug — a DISPLAY value the dashboard builds its install hint
# from, read even when the credentials above are absent. Blank renders an empty
# hint, so keep the line commented until you have the real slug.
#   GITHUB_APP_SLUG=my-barkpark-app

# ── Vercel zero-paste handoff — optional, off is a valid state ───────────────

# Platform token. Unset or blank (both handled) = the deploy endpoint 503s
# feature_not_configured and the SPA keeps the classic clone-URL handoff.
VERCEL_PLATFORM_TOKEN=

# Only for a TEAM-scoped token — appended as `?teamId=` on every Vercel call.
# Whole-line commented: a blank value is appended as an empty query parameter
# rather than omitted.
#   VERCEL_TEAM_ID=team_REPLACE_ME

# ── Cloudflare Origin CA — optional, fails closed ────────────────────────────

# The account-wide Origin CA key (Cloudflare → Origin Server → Origin CA). This
# is a SECOND, distinct credential from the per-team scoped API token, which
# lives in Registry.Vault and never here. Absent or blank, OriginCA.configured?
# is false and minting fails closed BEFORE a request is built — it can never
# fall back to the API token.
CLOUDFLARE_ORIGIN_CA_KEY=

# On-box directory the cert/key PATHS are derived from (default
# /etc/caddy/cloudflare). Paths only — the control plane writes no bytes.
# Blank is explicitly treated as absent, so a bare line is safe.
ORIGIN_CA_CERT_DIR=

# ── Archive store (Hetzner Object Storage) — optional, fails closed ──────────

# S3 credentials + bucket for the portable-archives read conduit. Blank creds
# mean the store answers :not_configured and GET /v1/archives degrades honestly.
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=
BARKPARK_BUNDLE_BUCKET=

# Bucket region (default fsn1). Whole-line commented: a blank value defeats
# runtime.exs's `|| "fsn1"` and signs requests for an empty location.
#   BARKPARK_BUNDLE_LOCATION=fsn1

# ── Deployment identity — this plane's own zone and URLs ─────────────────────
# Every name in this section is whole-line commented for the same reason: each
# is read through `if x = System.get_env(…)`, and the empty string is TRUTHY in
# Elixir. A bare `NAME=` line therefore does NOT mean "leave the default" — it
# overrides the default with "".

# The public zone every managed instance is named under. It names each
# provisioning subdomain, every site URL, and the zone split in
# custom_host_changeset/2. The off-box Go warm-pool worker carries its OWN base
# domain: set both to the same zone or the FQDN this plane shows and the one
# the worker stands up diverge. A malformed value REFUSES the node at boot.
#   PLATFORM_BASE_DOMAIN=cloud.example.com

# The repo the `/new?template=…` clone handoff points at. Set this when running
# the plane against a fork, or users are handed the upstream repo.
#   TEMPLATES_REPO_URL=https://github.com/example/barkpark

# This control plane's own public origin — the host a co-located box POSTs a
# content-publish webhook back to. CONTROL_PLANE_URL is an accepted alias;
# PUBLIC_URL wins when both are set.
#   PUBLIC_URL=https://cp.example.com
#   CONTROL_PLANE_URL=https://cp.example.com

# The public dashboard base URL the emailed `?confirm=` verification link
# points at.
#   DASHBOARD_URL=https://cp.example.com

# The front-door peers whose X-Forwarded-For may move conn.remote_ip, as a
# comma-separated list of INDIVIDUAL addresses — never a CIDR range (the
# internet-facing postfix container shares this network, and trusting the whole
# subnet would let it forge every client's IP). Keep it in step with the pinned
# `networks:` subnet in cloud/docker-compose.yml, whose .1 gateway is the
# compose default. A blank value resolves to an EMPTY list, which turns the pin
# OFF — hence the whole-line comment.
#   TRUSTED_PROXY_PEERS=172.18.0.1

# ── Operational knobs — safe to leave alone ─────────────────────────────────

# Audit-trail retention window in days (default 90). Whole-line commented: a
# blank value reaches `String.to_integer("")` and RAISES at boot.
#   AUDIT_RETENTION_DAYS=90

# Total live artifact bytes ONE team may hold; the upload route answers 429
# artifact_quota_exceeded past it. Default 512 MB. The literal string
# "infinity" disables the ceiling and is an explicit operator choice, never a
# default. Whole-line commented: a blank value raises at boot.
#   ARTIFACT_QUOTA_BYTES=536870912

# Debounce window in seconds for a publish-triggered auto-deploy; the DEFER
# backoff is derived as a multiple of it. Values below the floor of 5, and
# anything unparsable, fall back to the built-in default.
AUTODEPLOY_DEBOUNCE_S=

# Pause the Oban queues without a redeploy — e.g. during a migration window.
# Only the exact string "true" disables them; jobs accrue and run once
# re-enabled, and Cron keeps inserting scheduled jobs that wait. Anything else,
# including blank, keeps the default queues.
OBAN_QUEUES_DISABLED=

# ── Build/deploy stamps — set by deploy/cp-deploy.sh, not by hand ────────────

# The commit this slot is running, surfaced by GET /health. Whole-line
# commented on purpose: absent means `git_sha: null`, an honest "this box
# predates the reader", and a blank value is reported back RAW as an empty sha.
# cp-deploy.sh exports it from the sha it checked out AFTER sourcing this file,
# so a stale value here cannot win.
#   BARKPARK_GIT_SHA=0000000000000000000000000000000000000000

# The INSTALLED provisioner binary's sha, published beside git_sha so the two
# can visibly disagree. Unset and blank both read as absent.
BARKPARK_PROVISIONER_SHA=

# ── Plugin kill switch (charter D24) — NEVER ship this as a bare line ────────
# `BARKPARK_PLUGINS=` (blank) legitimately means REGISTER NOTHING. That is a
# valid, deliberate configuration and it must never be confused with "use the
# default set", which is what leaving the name out means. Uncomment ONLY to
# pick an explicit roster.
#   BARKPARK_PLUGINS=bulldocs,tasks,tickets
