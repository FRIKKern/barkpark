# Barkpark API
BARKPARK_API_URL=http://localhost:4000
BARKPARK_DATASET=production

# Public site URL — used for canonical/OpenGraph URLs, the sitemap, and
# robots.txt. Set this to your deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Workspace + project slugs you created in Barkpark Studio. When both are set,
# requests are scoped to /w/<workspace>/p/<project>/v1/...; clear either to use
# the flat /v1/... routes (back-compat).
BARKPARK_WORKSPACE=default
BARKPARK_PROJECT=default

# Dev token — has read+write+admin. Only for local development.
BARKPARK_TOKEN=changeme-barkpark-dev-token

# Server-side token used by @barkpark/nextjs draft mode. Keep secret.
BARKPARK_SERVER_TOKEN=changeme-barkpark-dev-token

# Postgres (used by docker-compose)
POSTGRES_USER=barkpark
POSTGRES_PASSWORD=changeme-local-dev-only
POSTGRES_DB=barkpark_dev

# Phoenix
SECRET_KEY_BASE=changeme-generate-a-64-char-random-string-before-deploying-anywhere
PHX_HOST=localhost
