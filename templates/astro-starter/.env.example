# ─────────────────────────────────────────────────────────────────────────────
# Barkpark Astro starter — build-time content link
#
# Copy to `.env` and fill in. These are read ONLY at build time (Astro static
# output) inside Node — the token never reaches the browser. This is the same
# cross-framework contract documented in templates/DEPLOYING.md and mirrored by
# web/lib/bp-env.ts. Keep the names identical across Astro / Next / Hugo / etc.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — the SCOPED API base: <origin>/w/:workspace/p/:project
# The workspace + project are ALREADY in this URL. The client appends
# `/v1/...` to it, so do not add a trailing `/v1`.
#   e.g. https://guerrilla.barkpark.cloud/w/acme/p/default
BARKPARK_API_URL=

# REQUIRED — the dataset to read from.
BARKPARK_DATASET=production

# Server-only read token. A fully public dataset can read anonymously (leave
# blank). When set, mint a read-only token per templates/DEPLOYING.md §4.
#
# ⚠️  NEVER name this with a public prefix (no PUBLIC_… / no NEXT_PUBLIC_…).
#     A public-prefixed var would be inlined into client JS and leak the token.
BARKPARK_TOKEN=

# Optional — workspace / project slugs. ONLY consulted when BARKPARK_API_URL is
# NOT already scoped (i.e. a bare origin). When the URL already carries
# `/w/:ws/p/:proj` these are ignored to avoid double-scoping.
BARKPARK_WORKSPACE=
BARKPARK_PROJECT=

# Optional — which document to feature. Defaults to the newest published "post".
BARKPARK_DOC_TYPE=post
# Pin an exact document instead of "newest of type" (optional).
BARKPARK_DOC_ID=

# The path this site is served under, behind the shared Caddy front. Astro's
# `base`. Defaults to /sites/astro-starter/. The deploy engine sets this per slug.
BARKPARK_SITE_BASE=/sites/astro-starter/
# Optional public origin, only used for absolute canonical/OG URLs.
BARKPARK_SITE_ORIGIN=

# Deploy markers — injected by the site-spawner deploy engine, baked into the
# output HTML for its HEALTH stage. Leave blank locally (defaults to dev/unknown).
BARKPARK_BUILD_ID=
BARKPARK_CONTENT_REV=

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  Ambient-env shadow gotcha (live-proven)
#
# Vite (Astro's build) gives `process.env` PRECEDENCE over values loaded from
# this `.env` file. So if your SHELL already exports a `BARKPARK_TOKEN` (or any
# BARKPARK_* var) — common on a dev box where `bp` is configured — that ambient
# value SHADOWS what you put here, and your build silently reads the wrong
# workspace/token.
#
# The site-spawner deploy engine scrubs the environment before each build so
# only the intended values survive. When building by hand, either `unset` the
# ambient BARKPARK_* vars first, or pass them inline on the command:
#
#   env -u BARKPARK_TOKEN -u BARKPARK_API_URL \
#     BARKPARK_API_URL=… BARKPARK_TOKEN=… BARKPARK_DATASET=production npm run build
# ─────────────────────────────────────────────────────────────────────────────
