# astro-search-starter — environment contract. THE finder (dual-engine live
# search) is mounted as a client:only island; the deployed site is pure static
# files. The SAME canonical names work across every adapter (DEPLOYING.md).
BARKPARK_API_URL=https://guerrilla.barkpark.cloud
BARKPARK_DATASET=production
BARKPARK_DOC_TYPE=entry
BARKPARK_WORKSPACE=default
BARKPARK_PROJECT=default
# Deploy-pinned palette default (evergreen | ember | fjord | charple).
# BARKPARK_THEME=evergreen

# ── Search transport (both engines: indx typo-tolerant + Postgres FTS) ───────
# The finder talks to Barkpark DIRECT from the browser. By default it rides the
# flat, ANONYMOUS HTTP search route — no token, both engines work. When a
# public-read token is provisioned it ALSO derives the live WebSocket
# (NEXT_PUBLIC_BARKPARK_WS_URL = <BARKPARK_API_URL origin>/socket, token =
# BARKPARK_TOKEN) at build and upgrades to per-keystroke frames. The token
# reaches every visitor, so it must grant nothing beyond the already-public
# published reads. Do NOT add BARKPARK_PUBLIC_WS_* vars — they are not on the
# deploy allowlist and 400 the deploy (charter D47).
#
# ⚠ THIS VALUE IS INLINED INTO THE BROWSER BUNDLE. It must be a `public-read`
# token and nothing else. Note the trap: the Next edition uses this SAME
# variable name for strictly SERVER-SIDE reads, so an .env carried across
# templates — or the admin token you already have to hand — would be published
# to every visitor. The build now verifies it against the server's own
# auth_tier ("read" only) and REFUSES to build otherwise, so this cannot ship
# by accident; leaving it empty is always safe — it never leaks a token. Search
# then rides the flat anonymous route, which reaches only public-read datasets
# (a non-public dataset returns nothing without a token); the WebSocket upgrade
# stays dark either way.
# Mint one: POST <api>/v1/tokens {"label":"…","permissions":["public-read"]}
BARKPARK_TOKEN=

# Optional hero copy (config-driven; brand without touching code).
# BARKPARK_SITE_EYEBROW=Search
# BARKPARK_SITE_TITLE=Search everything.
# BARKPARK_SITE_TAGLINE=Instant search across every document — misspellings widened server-side by Postgres trigram.

# The deploy engine sets these (markers baked into the served HTML):
BARKPARK_SITE_BASE=/sites/astro-search-starter/
BARKPARK_BUILD_ID=
BARKPARK_CONTENT_REV=
