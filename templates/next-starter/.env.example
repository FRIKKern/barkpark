# ─────────────────────────────────────────────────────────────────────────────
# Barkpark Next.js starter — request-time content link (node-slot runtime)
#
# Copy to `.env` and fill in. These are read at REQUEST time inside the Node SSR
# process (this starter's page is `force-dynamic`) — the token never reaches the
# browser. This is the same cross-framework contract documented in
# templates/DEPLOYING.md and mirrored by templates/astro-starter/.env.example +
# web/lib/bp-env.ts. Keep the names identical across Astro / Next / Nuxt / etc.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — the API base. Either a bare origin
#   e.g. https://guerrilla.barkpark.cloud
# or an already-SCOPED base `<origin>/w/:workspace/p/:project` where the
# workspace + project are ALREADY in the URL. The client appends `/v1/...` to
# it, so do not add a trailing `/v1`.
BARKPARK_API_URL=

# REQUIRED — the dataset to read from.
BARKPARK_DATASET=production

# Server-only read token. A fully public dataset can read anonymously (leave
# blank). When set, mint a read-only token per templates/DEPLOYING.md §4.
#
# ⚠️  NEVER name this with a public prefix (no PUBLIC_… / no NEXT_PUBLIC_…).
#     A NEXT_PUBLIC_ var is inlined into the client bundle and would leak the
#     token. This starter reads it only in server code (`src/lib/barkpark.ts`,
#     guarded by `import 'server-only'`).
BARKPARK_TOKEN=

# Optional — workspace / project slugs. ONLY consulted when BARKPARK_API_URL is
# NOT already scoped (i.e. a bare origin). When the URL already carries
# `/w/:ws/p/:proj` these are ignored to avoid double-scoping.
BARKPARK_WORKSPACE=
BARKPARK_PROJECT=

# Optional — which document to feature. Defaults to the newest published
# "paper" (guerrilla's `production` dataset has papers, not posts).
BARKPARK_DOC_TYPE=paper
# Pin an exact document instead of "newest of type" (optional).
BARKPARK_DOC_ID=

# The path this site is served under, behind the shared Caddy front. Baked into
# the bp-site-base marker. Defaults to /sites/next-starter/. The deploy engine
# sets this per slug.
BARKPARK_SITE_BASE=/sites/next-starter/

# Deploy markers — injected by the site-spawner deploy engine into the NODE-SLOT
# BOOT env (not the build). The engine launches each slot as:
#   PORT=<slot-port> HOSTNAME=127.0.0.1 BUILD_ID=<id> CONTENT_REV=<rev> \
#     node .next/standalone/server.js
# Because the marker page is `force-dynamic`, these are read at request time and
# reflect the running slot. Leave blank locally (defaults to dev/unknown).
BUILD_ID=
CONTENT_REV=

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  NEXT_PUBLIC_ leak gotcha
#
# Next inlines any `NEXT_PUBLIC_`-prefixed env var into the CLIENT bundle. NEVER
# put a token behind such a name. This starter reads BARKPARK_TOKEN only in the
# server-only module (`src/lib/barkpark.ts`), so the token stays on the box.
#
# ⚠️  Published reads are anonymous
#
# `@barkpark/nextjs`'s published-perspective fetch does NOT send the read token
# (the token is used only on the draft-preview branch). This starter therefore
# reads ANONYMOUSLY-published content. A dataset whose published documents are
# NOT publicly readable will 401/403 → the page 500s → the deploy HEALTH probe
# fails → the slot never takes traffic (fail-closed, by design).
# ─────────────────────────────────────────────────────────────────────────────
