{
  "version": 1,
  "blocks": [
    {
      "id": "h1",
      "type": "heading",
      "level": 1,
      "text": "Grid sections"
    },
    {
      "id": "gridsec",
      "type": "section",
      "title": "Two-track grid",
      "layout": { "mode": "grid", "tracks": 2 },
      "blocks": [
        {
          "id": "g1",
          "type": "paragraph",
          "content": [{ "type": "text", "value": "First cell sits in the left track and wraps within its narrower column at every width." }]
        },
        {
          "id": "g2",
          "type": "paragraph",
          "content": [{ "type": "text", "value": "Second cell sits in the right track of the same row." }]
        },
        {
          "id": "g3",
          "type": "paragraph",
          "span": 2,
          "content": [{ "type": "text", "value": "This spanning cell consumes both tracks and fills the whole row on its own line." }]
        },
        {
          "id": "g4",
          "type": "paragraph",
          "order": -1,
          "content": [{ "type": "text", "value": "Ordered first via CSS order:-1, so it leads the grid." }]
        }
      ]
    },
    {
      "id": "stacksec",
      "type": "section",
      "title": "Legacy stack",
      "blocks": [
        {
          "id": "s1",
          "type": "paragraph",
          "content": [{ "type": "text", "value": "A section with no layout attr stacks its children exactly as before." }]
        },
        {
          "id": "s2",
          "type": "paragraph",
          "content": [{ "type": "text", "value": "This is the byte-identical parity tripwire." }]
        }
      ]
    }
  ]
}
