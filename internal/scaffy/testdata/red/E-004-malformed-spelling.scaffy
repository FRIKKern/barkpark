# expect: E-004 12
DIRECTION "add"
VARIABLE 1 "WidgetName" TITLE "t" DESCRIPTION "d" EXAMPLES "W"
IN "internal/widgets/registry.go"
INSERT AFTER FIRST
::: registry head anchor :::
	registry["heading"] = headingWidget{}
::: registry head anchor :::
WITH
