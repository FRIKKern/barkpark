# Keep this app's install fully self-contained — it is NOT part of any pnpm
# workspace. If a pnpm-workspace.yaml ever appears above us and globs apps/*,
# `ignore-workspace-root-check` plus a local lockfile keep this build standalone.
ignore-workspace-root-check=true
# Hoist nothing surprising; a flat, predictable node_modules for a tiny app.
node-linker=hoisted
