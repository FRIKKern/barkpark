# Barkpark read API — server-side only. Never prefix with NEXT_PUBLIC_; the
# token must never reach the browser. Copy to .env.local and fill in the token.
BARKPARK_API_URL=https://api.barkpark.cloud/w/hundesteder/p/default
BARKPARK_DATASET=production
BARKPARK_TOKEN=
# Legacy aliases, still read as a fallback (lib/places.ts): BARKPARK_API_BASE, BARKPARK_API_TOKEN
