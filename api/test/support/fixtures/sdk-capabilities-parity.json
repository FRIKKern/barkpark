  "refresh": "cd api && mix run ../js/packages/core/tests/fixtures/refresh-capabilities.exs",
  "sdk_only": [
    {
      "rationale": "Frozen config object, not a call. No HTTP.",
      "sdk_method": "client.config"
    },
    {
      "rationale": "Returns a derived client. No HTTP.",
      "sdk_method": "client.withConfig"
    },
    {
      "rationale": "Pure URL builder over an asset ref (src/image-url.ts). Emits a CDN/media URL, never a /v1 API call.",
      "sdk_method": "client.imageUrl"
    },
    {
      "rationale": "Caller-supplied escape hatch (src/fetchRaw.ts): the path is an ARGUMENT, so it has no fixed template to cover.",
      "sdk_method": "client.fetchRaw"
    },
    {
      "rationale": "GET /v1/meta. Mounted and served, but deliberately NOT a manifest command — bp reads meta through its own boot path, not a verb. Same class as the router drift guard's @served_by_a_builtin.",
      "sdk_method": "client.handshake"
    },
    {
      "rationale": "GET /v1/data/export/:dataset. An NDJSON stream, not the single JSON body the generic manifest command path decodes; bp dispatches `bp export` directly from internal/cli/cli.go.",
      "sdk_method": "client.exportDataset"
    },
    {
      "rationale": "GET /v1/data/listen/:dataset. A long-lived SSE stream, same reason as export; bp dispatches `bp listen` directly.",
      "sdk_method": "client.listen"
    },
    {
      "rationale": "Internal cache handle exposed for tests. No HTTP.",
      "sdk_method": "client.__handshakeCache"
    }
  ],
  "source": "Barkpark.Plugins.Capabilities.manifest(\"admin\", project: false)[\"commands\"] — the UN-projected superset, so an existence-hiding projection cannot shrink what the fixture records.",
  "source_tier": "admin"
}
