{
  "realm": "barkpark",
  "enabled": true,
  "sslRequired": "none",
  "groups": [
    { "name": "barkpark-admins", "path": "/barkpark-admins" }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@interop.example",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Interop",
      "groups": ["/barkpark-admins"],
      "credentials": [
        { "type": "password", "value": "interop-pass", "temporary": false }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "barkpark-oidc",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "interop-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4000/*"],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "http://localhost:4000/saml/keycloak-org/metadata",
      "protocol": "saml",
      "enabled": true,
      "redirectUris": ["http://localhost:4000/*"],
      "adminUrl": "http://localhost:4000/v1/auth/saml/keycloak-org/acs",
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.force.post.binding": "true",
        "saml_name_id_format": "email",
        "saml.authnstatement": "true",
        "saml_idp_initiated_sso_url_name": "barkpark",
        "saml_single_logout_service_url_post": "http://localhost:4000/v1/auth/saml/keycloak-org/slo"
      }
    }
  ]
}
