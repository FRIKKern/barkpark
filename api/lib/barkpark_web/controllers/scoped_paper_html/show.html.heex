<main class={[
  "bp-paper-shell",
  @article? && "bp-paper-article",
  @wide_article? && "bp-paper-article-wide"
]}>
  <%!-- Sentinel mirrors BulldocsLive's no-reload marker so the scoped reader's
        outer markup matches the public reader's. Static render — no streaming,
        no LiveView. --%>
  <div id="paper-sentinel" data-slug={@slug} hidden></div>
  <article id="paper-body">{raw(@body_html)}</article>
  <%!-- "Linked mentions" — papers that wikilink TO this one, server-rendered
        after the body. Empty string (and so no markup) when nothing links here;
        @backlinks_html already carries the full <section> or "". --%>
  {raw(@backlinks_html)}
  <%!-- "Driven tasks" (lvw-t8 expectation reverse view) — tasks citing this
        paper with their acceptance-criteria state; "" when none. --%>
  {raw(@driven_tasks_html)}
</main>
