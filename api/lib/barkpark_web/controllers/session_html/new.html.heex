<div class="bp-auth">
  <.auth_styles />
  <div class="bp-auth-card">
    <.auth_brand />

    <h1 class="bp-auth-title">Sign in</h1>
    <p class="bp-auth-sub">to continue to Studio on <b>{@instance_host}</b></p>

    <.auth_flash flash={@flash} />

    <%= if @cloud_login_href do %>
      <a class="bp-auth-btn" href={@cloud_login_href} data-cloud-login>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2 6.5 10H9l-4.5 7h6v3.5h3V17h6L15 10h2.5Z" />
        </svg>
        Log in with Barkpark Cloud
      </a>
      <div class="bp-auth-divider"><span>or sign in with email</span></div>
    <% end %>

    <.form :let={_f} for={%{}} as={:account} action={~p"/login/account"} method="post">
      <input type="hidden" name="return_to" value={@return_to} />

      <div class="form-group">
        <label class="form-label" for="account_email">Email</label>
        <input
          type="email"
          name="email"
          id="account_email"
          class="form-input"
          autocomplete="username"
          autofocus
          required
          placeholder="you@example.com"
        />
      </div>

      <div class="form-group">
        <div class="bp-auth-label-row">
          <label class="form-label" for="account_password">Password</label>
          <a href={~p"/login/reset"}>Forgot password?</a>
        </div>
        <div class="bp-auth-input-affix">
          <input
            type="password"
            name="password"
            id="account_password"
            class="form-input"
            autocomplete="current-password"
            required
            placeholder="••••••••••••"
          />
          <button
            type="button"
            class="bp-auth-eye"
            data-eye-for="account_password"
            tabindex="-1"
            aria-label="Show password"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" />
            </svg>
          </button>
        </div>
      </div>

      <button type="submit" class={["bp-auth-btn", @cloud_login_href && "bp-auth-btn-quiet"]}>
        Sign in
      </button>
    </.form>

    <p class="bp-auth-alt">
      or <a href={~p"/login/magic"}>email me a sign-in link</a> — no password needed
    </p>

    <details data-token-signin>
      <summary>Sign in with an API token instead</summary>

      <.form :let={_f} for={%{}} as={:session} action={~p"/login"} method="post">
        <input type="hidden" name="return_to" value={@return_to} />

        <div class="form-group">
          <label class="form-label" for="session_token">API token</label>
          <input
            type="password"
            name="token"
            id="session_token"
            class="form-input"
            autocomplete="off"
            required
            placeholder="paste token"
          />
        </div>

        <button type="submit" class="bp-auth-btn bp-auth-btn-quiet">Sign in with token</button>
      </.form>
    </details>

    <p class="bp-auth-foot">
      Using enterprise SSO? Open your organization's sign-in link —
      <code>/v1/auth/oidc/&lt;org&gt;/start</code> — or ask your admin for it.
    </p>
  </div>

  <p class="bp-auth-pagefoot">Barkpark — the self-hosted content studio</p>

  <script nonce={assigns[:csp_nonce]}>
    // Password show/hide — same affordance as the Cloud dashboard login.
    document.querySelectorAll(".bp-auth-eye").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var input = document.getElementById(btn.dataset.eyeFor);
        if (!input) return;
        var show = input.type === "password";
        input.type = show ? "text" : "password";
        btn.setAttribute("aria-label", show ? "Hide password" : "Show password");
      });
    });
  </script>
</div>
