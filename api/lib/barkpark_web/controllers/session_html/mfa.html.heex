<div class="empty-state" style="min-height: 70vh;">
  <div class="card" style="max-width: 420px; width: 100%;">
    <div class="card-header" style="display: block;">
      <h2 class="h2">Two-factor code</h2>
      <p class="text-sm text-muted" style="margin-top: 4px;">
        Enter the six-digit code from your authenticator app, or a recovery code.
      </p>
    </div>

    <div style="padding: 20px;">
      <%= if Phoenix.Flash.get(@flash, :error) do %>
        <div class="flash flash-error" role="alert">
          {Phoenix.Flash.get(@flash, :error)}
        </div>
      <% end %>

      <.form :let={_f} for={%{}} as={:mfa} action={~p"/login/mfa"} method="post">
        <input type="hidden" name="return_to" value={@return_to} />

        <div class="form-group">
          <label class="form-label" for="mfa_code">Authenticator code</label>
          <input
            type="text"
            name="code"
            id="mfa_code"
            class="form-input"
            inputmode="numeric"
            autocomplete="one-time-code"
            autofocus
            placeholder="123456"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="mfa_recovery">…or a recovery code</label>
          <input
            type="text"
            name="recovery_code"
            id="mfa_recovery"
            class="form-input"
            autocomplete="off"
            placeholder="recovery code"
          />
        </div>

        <div style="display: flex; gap: 8px; margin-top: 12px;">
          <button type="submit" class="btn btn-primary">Verify</button>
          <a href="/login" class="btn btn-ghost">Start over</a>
        </div>
      </.form>
    </div>
  </div>
</div>
