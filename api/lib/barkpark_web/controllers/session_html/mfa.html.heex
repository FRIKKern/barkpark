<div class="bp-auth">
  <.auth_styles />
  <div class="bp-auth-card">
    <.auth_brand />

    <h1 class="bp-auth-title">Two-step verification</h1>
    <p class="bp-auth-sub">Enter the six-digit code from your authenticator app.</p>

    <.auth_flash flash={@flash} />

    <.form :let={_f} for={%{}} as={:mfa} action={~p"/login/mfa"} method="post">
      <input type="hidden" name="return_to" value={@return_to} />

      <div class="form-group">
        <label class="form-label" for="mfa_code">Authenticator code</label>
        <input
          type="text"
          name="code"
          id="mfa_code"
          class="form-input bp-auth-code"
          inputmode="numeric"
          autocomplete="one-time-code"
          maxlength="6"
          autofocus
          placeholder="123456"
        />
      </div>

      <details>
        <summary>Use a recovery code instead</summary>
        <div class="form-group">
          <label class="form-label" for="mfa_recovery">Recovery code</label>
          <input
            type="text"
            name="recovery_code"
            id="mfa_recovery"
            class="form-input"
            autocomplete="off"
            placeholder="recovery code"
          />
        </div>
      </details>

      <div style="margin-top: 16px;">
        <button type="submit" class="bp-auth-btn">Verify</button>
      </div>
    </.form>

    <p class="bp-auth-foot">
      <a href={~p"/login"}>Start over</a>
    </p>
  </div>
</div>
