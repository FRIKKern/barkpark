<div class="bp-auth">
  <.auth_styles />
  <div class="bp-auth-card">
    <.auth_brand />

    <%= if @sent do %>
      <h1 class="bp-auth-title"><%= gettext("Check your email") %></h1>
      <p class="bp-auth-sub">
        <%= gettext("If that address has an account, a password-reset link is on its way. The link is single-use and expires soon — open it promptly.") %>
      </p>
      <a class="bp-auth-btn bp-auth-btn-quiet" href={~p"/login"}><%= gettext("Back to sign in") %></a>
    <% else %>
      <h1 class="bp-auth-title"><%= gettext("Reset your password") %></h1>
      <p class="bp-auth-sub">
        <%= gettext("Enter your account email and we'll send you a link to set a new password.") %>
      </p>

      <.auth_flash flash={@flash} />

      <.form :let={_f} for={%{}} as={:reset} action={~p"/login/reset"} method="post">
        <div class="form-group">
          <label class="form-label" for="reset_email"><%= gettext("Email") %></label>
          <input
            type="email"
            name="email"
            id="reset_email"
            class="form-input"
            autocomplete="username"
            autofocus
            required
            placeholder={gettext("you@example.com")}
          />
        </div>

        <button type="submit" class="bp-auth-btn"><%= gettext("Email me a reset link") %></button>
      </.form>

      <p class="bp-auth-foot">
        <%= gettext("Remembered it after all?") %> <a href={~p"/login"}><%= gettext("Back to sign in") %></a>
      </p>
    <% end %>
  </div>
</div>
