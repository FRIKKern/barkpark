<!DOCTYPE html>
<%!-- data-bp-theme (ts-w4e) — the server-resolved workspace THEME IDENTITY,
      stamped here so the theme skin paints on the FIRST byte (no flash). It is
      orthogonal to the data-theme (light/dark) pre-paint script below and is
      NOT a color literal — it lives OUTSIDE the GENERATED tokens marker, so the
      Part-E exemption ledger is unaffected. Omitted entirely for the default
      (evergreen) theme, so a default page is byte-identical to before. --%>
<html lang="en" data-bp-theme={bp_theme_attr(assigns)}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content={get_csrf_token()} />
  <%!-- Pre-paint stamps: synchronous so both attributes are set before first
        paint (no FOUC / no flash-of-wrong-layout). The ONLY allowed blocking
        <head> script — a few lines that set two <html> attributes
        (Golden Rule 4's sanctioned exception).
        1. data-theme — dark/light. Default follows the OS until the user
           toggles; the choice then persists in localStorage. While no
           explicit pref is stored, OS scheme changes are mirrored live.
        2. data-width-bucket (spd-s1, charter D2/D3) — the desk's width
           bucket (wide ≥1280 · standard 1024–1279 · narrow 640–1023 ·
           phone <640). The responsive-desk CSS keys off it with no server
           round-trip; resize re-buckets via one rAF-throttled listener with
           a +32px widen dead-band per edge (narrow eagerly at the
           threshold, widen reluctantly at threshold+32) so boundary jitter
           never thrashes the layout. Client-only stamping — NO pushEvent
           here; the LiveView seam (spd-s2/s4) reuses the exposed
           window.__bpWidthBucket compute fn after connect. --%>
  <script nonce={assigns[:csp_nonce]}>
    (function () {
      var KEY = "barkpark_theme";
      function osTheme() {
        return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
      }
      var stored = localStorage.getItem(KEY);
      document.documentElement.dataset.theme = stored || osTheme();
      // Follow OS live ONLY while the user has made no explicit choice.
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function (e) {
        if (localStorage.getItem(KEY)) return;
        document.documentElement.dataset.theme = e.matches ? "dark" : "light";
      });
    })();
    (function () {
      // spd-s1 — width-bucket stamp. EDGES[i] separates NAMES[i] from NAMES[i+1].
      var EDGES = [640, 1024, 1280];
      var NAMES = ["phone", "narrow", "standard", "wide"];
      function rankOf(w) {
        var r = 0;
        while (r < EDGES.length && w >= EDGES[r]) r++;
        return r;
      }
      // (width, currentName?) -> bucket name. With a current bucket the +32px
      // dead-band applies on the widen side only (never on narrowing); with no
      // current bucket (first paint) it is the raw band.
      function bucket(w, currentName) {
        var cur = NAMES.indexOf(currentName);
        var raw = rankOf(w);
        if (cur < 0 || raw <= cur) return NAMES[raw];
        while (cur < raw && w >= EDGES[cur] + 32) cur++;
        return NAMES[cur];
      }
      // Exposed for the later LiveView hook (spd-s4). The __-prefixed alias is
      // deliberate: both spellings in the wave briefs resolve to the SAME fn.
      window.bpWidthBucket = bucket;
      window.__bpWidthBucket = bucket;
      var el = document.documentElement;
      el.dataset.widthBucket = bucket(window.innerWidth);
      var raf = 0;
      window.addEventListener("resize", function () {
        if (raf) return;
        raf = requestAnimationFrame(function () {
          raf = 0;
          var next = bucket(window.innerWidth, el.dataset.widthBucket);
          if (next !== el.dataset.widthBucket) el.dataset.widthBucket = next;
        });
      });
    })();
  </script>
  <title>Barkpark Studio</title>
  <style>
    /* ── Inter — self-hosted chrome font (variable woff2 in priv/static/fonts/,
       served at /fonts/ by Plug.Static). One file carries weights 100–900;
       italic is browser-synthesised. Replaces the fonts.googleapis.com CDN
       (unified-aesthetic W2.7). Inter, SIL OFL 1.1 — see fonts/Inter-OFL.txt. */
    @font-face {
      font-family: 'Inter';
      src: url('/fonts/Inter-var.woff2') format('woff2');
      font-weight: 100 900; font-style: normal; font-display: swap;
    }

    /* ── Source Serif 4 — self-hosted variable woff2 (Roman + Italic in
       priv/static/fonts/, served at /fonts/ by Plug.Static; "fonts" is in
       static_paths). Two files carry the full wght 200–900 axis (was four
       static TTFs @ 400/700 — unified-aesthetic S9). The Beta editor "paper"
       surface uses this as its body face; `font-display: swap` accepts a
       brief Georgia FOUT on cold cache. Source Serif 4, SIL OFL 1.1 — see
       fonts/SourceSerif4-OFL.txt. */
    @font-face {
      font-family: 'Source Serif 4';
      src: url('/fonts/SourceSerif4Variable-Roman.woff2') format('woff2');
      font-weight: 200 900; font-style: normal; font-display: swap;
    }
    @font-face {
      font-family: 'Source Serif 4';
      src: url('/fonts/SourceSerif4Variable-Italic.woff2') format('woff2');
      font-weight: 200 900; font-style: italic; font-display: swap;
    }

    /* ── IBM Plex Mono — the house monospace face (design/tokens.json
       font.mono; already self-hosted on the Cloud console since GUI-remake
       GR8). Copied into priv/static/fonts/ and served at /fonts/ by
       Plug.Static ("fonts" is in BarkparkWeb.static_paths/0). Plex Mono is
       NOT a variable font: three discrete latin-subset files carry 400/500/
       600 (~13–14KB each), so each weight needs its own @font-face — do not
       collapse them into an Inter-style `font-weight: 100 900` range, which
       would make the browser synthesise bold from Regular. Leads
       `--font-mono` below. Copyright 2017 IBM Corp., SIL OFL 1.1 — see
       fonts/IBMPlexMono-OFL.txt. */
    @font-face {
      font-family: 'IBM Plex Mono';
      src: url('/fonts/IBMPlexMono-Regular-latin.woff2') format('woff2');
      font-weight: 400; font-style: normal; font-display: swap;
    }
    @font-face {
      font-family: 'IBM Plex Mono';
      src: url('/fonts/IBMPlexMono-Medium-latin.woff2') format('woff2');
      font-weight: 500; font-style: normal; font-display: swap;
    }
    @font-face {
      font-family: 'IBM Plex Mono';
      src: url('/fonts/IBMPlexMono-SemiBold-latin.woff2') format('woff2');
      font-weight: 600; font-style: normal; font-display: swap;
    }

    /* ── shadcn/radix inspired design tokens ──────────────────────────── */
    /* Theme-independent tokens (fonts, radii, layout) live on :root once. */
    :root {
      --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      /* design/tokens.json font.mono.stack, VERBATIM — the one mono stack
         shared with cloud/priv/static/app.css's --mono. */
      --font-mono: "IBM Plex Mono", "SF Mono", "Fira Code", ui-monospace, Menlo, monospace;

      /* THE READING SERIF, for chrome that is PORTALED OUT of the paper surface.
         The slash menu and the format bubble are appended to `document.body`
         (slash-menu.js:283, format-bubble.js:203), so they are NOT descendants
         of `.bp-paper-surface` and cannot inherit the `--paper-font-serif` that
         paper-surface.css declares there. Both used to carry their own literal
         `'Source Serif 4', Georgia, 'Times New Roman', serif` to compensate —
         a DIFFERENT stack from the one the surface actually resolves, so the
         format bubble's B and I glyphs were set in a different face from the
         prose they format.

         Declared here rather than back on the popups because the embedder
         bundle already solves it exactly this way: styles.css's generated
         mirror puts `--paper-font-serif` on `:root, :host`, so a body-portaled
         popup inherits the ratified stack there. The Studio lacked that one
         declaration, which is the whole of the divergence. This line is
         BYTE-IDENTICAL to the bundle's, so the two surfaces agree by
         construction; view_edit_parity_test.exs pins the pair.

         The stack ORDER is NOT chosen here — it is owned by
         au-w5-reading-typography (human-gated) and lives in design/tokens.json
         `font.reading.stack`. `--tok-reading-font` is the ratified token; the
         fallback repeats it verbatim for the body scope, which no
         `.bp-paper-surface` rule reaches. Moving Source Serif 4 to the front is
         that gate's one-line cutover, not this one's. */
      --paper-font-serif: var(--tok-reading-font, "Iowan Old Style", "Palatino Linotype", Palatino, Charter, Georgia, 'Source Serif 4', serif);

      --radius-sm: 6px;
      --radius: 8px;
      --radius-lg: 12px;

      /* Sanity-specific */
      --sidebar-w: 240px;
      --header-h: 52px;
    }

    /* BEGIN GENERATED: tokens (design/tokens.json — regenerate: node design/emit.mjs --write; do not hand-edit) */
    :root {
      --primary: hsl(151.96 71.81% 29.22%);
      --primary-hover: hsl(151.96 71.81% 23.22%);
      --primary-fg: hsl(0 0% 100%);
      --bg: hsl(0 0% 100%);
      --surface: hsl(0 0% 100%);
      --muted-surface: hsl(240 4.8% 95.9%);
      --text: hsl(240 10% 3.9%);
      --muted-text: hsl(240 3.8% 45%);
      --border: hsl(240 5.9% 90%);
      --ring: hsl(163 42% 30%);
      --accent: hsl(30 92% 42%);
      --primary-hsl: 151.96 71.81% 29.22%;
      --primary-soft: hsl(var(--primary-hsl) / 0.15);
      --ok-hsl: 142 72% 26%; --warn-hsl: 35 92% 38%; --danger-hsl: 0 68% 42%; --info-hsl: 217.2 91.2% 59.8%;
      --ok: hsl(var(--ok-hsl)); --warn: hsl(var(--warn-hsl)); --danger: hsl(var(--danger-hsl)); --info: hsl(var(--info-hsl));
      --ok-soft: hsl(var(--ok-hsl) / 0.15); --warn-soft: hsl(var(--warn-hsl) / 0.15); --danger-soft: hsl(var(--danger-hsl) / 0.15); --info-soft: hsl(var(--info-hsl) / 0.15);
      --warn-strong: hsl(var(--warn-hsl) / 0.28);
      --ok-fg: hsl(0 0% 100%);
      --warn-fg: hsl(0 0% 100%);
      --danger-fg: hsl(0 0% 98%);
      --info-fg: hsl(0 0% 100%);
      --bg-accent: hsl(240 4.8% 92%);
      --border-muted: var(--border);
      --fg-dim: hsl(240 4% 47%);
      --fg-accent: hsl(240 5.9% 10%);
      --surface-raised: hsl(139.07 45.01% 98.74%);
      --border-subtle: hsl(139.1 12.79% 94.49%);
      --text-2xl: 26px; --text-2xl-lh: 1.2;
      --text-xl: 20px; --text-xl-lh: 1.3;
      --text-lg: 16px; --text-lg-lh: 1.4;
      --text-base: 14px; --text-base-lh: 1.5;
      --text-sm: 13px; --text-sm-lh: 1.45;
      --text-xs: 12px; --text-xs-lh: 1.4;
      --dur-1: 0.15s;
      --dur-2: 0.18s;
      --dur-3: 0.28s;
      --life-in_progress: #2563eb;
      --life-blocked: #d97706;
      --life-done: #0d9488;
      --life-closed: #0d9488;
      --life-cancelled: #a1a1aa;
      --life-ready: #18181b;
      --life-open: #71717a;
      --life-considering: #a1a1aa;
      --life-researching: #7c3aed;
    }
    html[data-theme="dark"] {
      --primary: hsl(152.92 60% 52.94%);
      --primary-hover: hsl(152.92 60% 60.94%);
      --primary-fg: hsl(163 45% 8%);
      --bg: hsl(240 10% 3.9%);
      --surface: hsl(240 10% 5.5%);
      --muted-surface: hsl(240 3.7% 12%);
      --text: hsl(0 0% 95%);
      --muted-text: hsl(240 5% 64.9%);
      --border: hsl(240 3.7% 15.9%);
      --ring: hsl(152.92 60% 52.94%);
      --accent: hsl(33 92% 60%);
      --primary-hsl: 152.92 60% 52.94%;
      --primary-soft: hsl(var(--primary-hsl) / 0.2);
      --ok-fg: hsl(0 0% 100%);
      --warn-fg: hsl(0 0% 100%);
      --danger-fg: hsl(0 0% 100%);
      --info-fg: hsl(0 0% 100%);
      --bg-accent: hsl(240 3.7% 13%);
      --border-muted: hsl(240 3.7% 11%);
      --fg-dim: hsl(240 5% 51%);
      --fg-accent: var(--text);
      --surface-raised: hsl(144.25 11.33% 9.07%);
      --border-subtle: hsl(144.1 11.39% 6.97%);
      --life-in_progress: #60a5fa;
      --life-blocked: #fbbf24;
      --life-done: #2dd4bf;
      --life-closed: #2dd4bf;
      --life-cancelled: #71717a;
      --life-ready: #e7edf2;
      --life-open: #5f6b78;
      --life-considering: #71717a;
      --life-researching: #a78bfa;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --ok-hsl: 142 52% 52%; --warn-hsl: 38 94% 56%; --danger-hsl: 0 82% 66%; --info-hsl: 217.2 91.2% 59.8%;
        --ok: hsl(var(--ok-hsl)); --warn: hsl(var(--warn-hsl)); --danger: hsl(var(--danger-hsl)); --info: hsl(var(--info-hsl));
        --ok-soft: hsl(var(--ok-hsl) / 0.2); --warn-soft: hsl(var(--warn-hsl) / 0.2); --danger-soft: hsl(var(--danger-hsl) / 0.2); --info-soft: hsl(var(--info-hsl) / 0.2);
        --warn-strong: hsl(var(--warn-hsl) / 0.34);
      }
    }
    /* ── theme identity (data-bp-theme) — orthogonal to light/dark mode; the bare declarations above are the evergreen fallback (no attribute → renders exactly as today) ── */
    html[data-bp-theme="evergreen"] {
      --primary: hsl(151.96 71.81% 29.22%);
      --primary-hover: hsl(151.96 71.81% 23.22%);
      --primary-fg: hsl(0 0% 100%);
