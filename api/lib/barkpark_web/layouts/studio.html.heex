<.studio_shell>
  <%!-- Self-update bar: INSTANCE admins only (instance_admin? chrome flag —
        HOST-level, deliberately NOT the workspace-scoped shares_admin?: this
        bar offers to upgrade the BEAM every workspace runs on, so a host
        operator must keep it while browsing a workspace they merely belong
        to), and only when SelfUpdate reports the instance is behind. Pinned
        ABOVE the topbar as a slim strip; driven by the vanilla `bp-update-bar`
        initialiser in root.html.heex (this bar is layout chrome, outside the
        LiveView diff). --%>
  <BarkparkWeb.StudioComponents.Nav.studio_update_banner
    admin?={assigns[:instance_admin?] == true}
    api_token_raw={assigns[:api_token_raw]}
  />

  <%!-- Environment-identity strip (staging-barkpark): an unmissable band on
        any non-production instance (staging = canary for Barkpark's own
        builds). Reads :instance_env from config internally, so no assign to
        plumb; renders nothing on prod/dev. Layout chrome, outside the diff. --%>
  <BarkparkWeb.StudioComponents.Nav.studio_env_banner />

  <.studio_topbar>
    <:brand>
      <div class="studio-bar-brand">
        <a
          :if={is_binary(assigns[:return_to]) and assigns[:return_to] != ""}
          href={assigns[:return_to]}
          class="btn btn-ghost btn-sm"
          title="Back to Studio"
          aria-label="Back to Studio"
          data-test-id="return-to-scope"
        >
          <span class="bp-action-icon" aria-hidden="true">
            <.icon name="arrow-left" size={16} />
          </span>
        </a>
        <%!-- Sanity-style: the WORKSPACE is the studio's identity — when one
              resolves, the scope chip's avatar carries it (workspace initial),
              so the standalone brand square + wordmark only show without one. --%>
        <div :if={!assigns[:current_workspace]} class="sidebar-brand-icon">B</div>
        <span :if={!assigns[:current_workspace]} style="font-weight: 700; font-size: 15px;">Barkpark</span>
        <%= if assigns[:current_workspace] do %>
          <BarkparkWeb.Studio.WorkspaceSwitcher.switcher
            current_workspace={assigns[:current_workspace]}
            current_project={assigns[:current_project]}
            current_dataset={assigns[:dataset]}
            menu={assigns[:scope_menu]}
            can_create={BarkparkWeb.Studio.ScopeResolver.principal_from_assigns(assigns) != nil}
            create_open={assigns[:create_open]}
          />
        <% else %>
          <%= if assigns[:dataset] do %>
            <BarkparkWeb.Studio.DatasetSwitcher.switcher
              current={@dataset}
              current_section={assigns[:nav_section] || :structure}
            />
          <% end %>
        <% end %>
      </div>
    </:brand>
    <:tabs :if={assigns[:dataset]}>
      <.studio_tabs
        dataset={@dataset}
        scope_prefix={assigns[:scope_prefix] || ""}
        nav_section={assigns[:nav_section]}
        current_path={assigns[:current_path]}
        admin?={assigns[:shares_admin?] == true}
        workspace_id={assigns[:current_workspace] && assigns[:current_workspace].id}
      />
    </:tabs>
    <:actions>
      <%!-- ONE right-aligned group: api-tester controls · presence ·
            share · theme · sign-out. A single flex container (not N
            auto-margined slots) is what keeps these from overlapping —
            presence used to be a position:fixed overlay pinned over
            this corner. .bar-focusable marks what Beta focus hides. --%>
      <div class="studio-bar-right">
        <div :if={assigns[:nav_section] == :api_tester} class="studio-bar-actions bar-focusable">
          <form phx-change="token-change" style="display:contents;">
            <label class="studio-bar-actions-label">Token</label>
            <input type="text" name="token" value={assigns[:token] || ""} class="form-input" style="width:180px;height:26px;font-size:11px;font-family:var(--font-mono);padding:0 8px;" phx-debounce="300" />
          </form>
          <button phx-click="run-all" class="btn btn-primary btn-sm" style="height:26px;font-size:11px;padding:0 12px;" disabled={assigns[:running]}><%= if assigns[:running], do: "Running…", else: "Run all" %></button>
        </div>
        <button
          :if={assigns[:shares_admin?]}
          type="button"
          class="btn btn-ghost btn-sm bar-focusable"
          phx-click="shares-open"
          title="Network shares"
          aria-label="Network shares"
        >
          <span class="bp-action-icon" aria-hidden="true"><.icon name="share-2" size={16} /></span>
        </button>
        <.studio_theme_toggle />
        <%= if assigns[:api_token] do %>
          <.studio_signout_button />
        <% end %>
        <%!-- Sanity-style: the avatar sits at the far right edge. --%>
        <%= if assigns[:presences] do %>
          <.presence_nav
            user_id={@user_id}
            user_name={@user_name}
            user_color={@user_color}
            presences={@presences}
            editor_doc={assigns[:editor_doc]}
            dataset={assigns[:dataset]}
            current_workspace={assigns[:current_workspace]}
            current_project={assigns[:current_project]}
          />
        <% end %>
      </div>
    </:actions>
  </.studio_topbar>

  <.studio_flash flash={@flash} />

  {@inner_content}

  <%!-- Build-version footer: last child of the shell flex column, so it
        pins to the bottom on every Studio + admin surface. The vitals slot
        carries live host stats (Barkpark.HostVitals.Sampler): an embedded
        sticky LiveView in a live context, a static snapshot on dead views
        (controller-rendered admin pages have no @socket). --%>
  <BarkparkWeb.StudioComponents.Nav.studio_footer>
    <:vitals>
      <%= if assigns[:socket] do %>
        <%= live_render(@socket, BarkparkWeb.ServerVitalsLive, id: "server-vitals", sticky: true) %>
      <% else %>
        <BarkparkWeb.ServerVitalsLive.line vitals={Barkpark.HostVitals.Sampler.snapshot()} />
      <% end %>
    </:vitals>
  </BarkparkWeb.StudioComponents.Nav.studio_footer>
</.studio_shell>
