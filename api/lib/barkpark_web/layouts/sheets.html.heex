<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content={get_csrf_token()} />
  <%!-- default carries NO site name: <.live_title> appends the suffix to the
        default too, so "Sheet · Barkpark" + suffix would double the brand. --%>
  <.live_title default="Sheet" suffix=" · Barkpark">{assigns[:page_title]}</.live_title>
  <%!-- Social-share head (preview-contract pc-w2): the SAME shared emitter the
        papers reader uses, driven by the sheet's `:preview` manifest that
        SheetsReaderLive.mount sets. Emitted BEFORE the multi-KB style blob (Slack
        reads only the first 32 KB). Replaces the hand-rolled canned
        description/og:title/og:type — those are now derived from the manifest
        (a sheet's raw type maps to og:type=website, D8). `assigns[:preview]`
        is nil-safe → site-default meta on any render that assigns none. --%>
  <BarkparkWeb.ShareMeta.head preview={assigns[:preview]} page_title={assigns[:page_title]} />
  <style>
    /* The /sheets/:slug public reader (Sheets M4) — the papers-reader
       aesthetic (bulldocs.html.heex's parchment article chrome) over the
       Studio grid's .sheet-* table rules. The grid CSS below mirrors the
       root.html.heex Studio block (read-only subset: no toolbar, menus,
       resize handles or rename inputs render here), retargeted onto the
       parchment palette via the same custom properties the rules consume. */
    *, *::before, *::after { box-sizing: border-box; }
    :root {
      --paper-bg:       #fefdf9;
      --paper-bg-deep:  #eaf1ee;
      --paper-ink:      #15211d;
      --paper-ink-soft: #55635e;
      --paper-rule:     #dde7e2;
      --paper-accent:   #1e5347;
      /* The .sheet-* rules read these (Studio's theme tokens). */
      --bg:     var(--paper-bg);
      --bg-alt: var(--paper-bg-deep);
      --fg:     var(--paper-ink);
      --fg-dim: var(--paper-ink-soft);
      --border: var(--paper-rule);
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper-bg:       #1b1815;
        --paper-bg-deep:  #221e1a;
        --paper-ink:      #ece6dc;
        --paper-ink-soft: #b8ad9e;
        --paper-rule:     rgba(236, 230, 220, 0.2);
        --paper-accent:   #d97a5f;
      }
    }
    /* Info-blue link + focus ring (color.readerInfo): WCAG-safe blue-600 on the
       light parchment, lifting to info-role blue-500 on dark. --ring binds to
       --info so the reader's focus rings stay blue. De-literalized onto
       design/tokens.json via this page-scoped block; regenerate with
       `node design/emit.mjs --write`, never hand-edit. */
    /* BEGIN GENERATED: tokens (design/tokens.json — regenerate: node design/emit.mjs --write; do not hand-edit) */
    :root { --info: #2563eb; --ring: var(--info); }
    @media (prefers-color-scheme: dark) { :root { --info: #3b82f6; } }
    /* ── theme identity (data-bp-theme) — orthogonal to light/dark mode; the bare declarations above are the evergreen fallback (no attribute → renders exactly as today) ── */
    html[data-bp-theme="evergreen"] { --info: #2563eb; --ring: var(--info); }
    @media (prefers-color-scheme: dark) { html[data-bp-theme="evergreen"] { --info: #3b82f6; } }
    html[data-bp-theme="charple"] { --info: #2563eb; --ring: var(--info); }
    @media (prefers-color-scheme: dark) { html[data-bp-theme="charple"] { --info: #3b82f6; } }
    html[data-bp-theme="ember"] { --info: #2563eb; --ring: var(--info); }
    @media (prefers-color-scheme: dark) { html[data-bp-theme="ember"] { --info: #3b82f6; } }
    html[data-bp-theme="fjord"] { --info: #2563eb; --ring: var(--info); }
    @media (prefers-color-scheme: dark) { html[data-bp-theme="fjord"] { --info: #3b82f6; } }
    html[data-bp-theme="iris"] { --info: #2563eb; --ring: var(--info); }
    @media (prefers-color-scheme: dark) { html[data-bp-theme="iris"] { --info: #3b82f6; } }
    /* END GENERATED: tokens */
    body {
      margin: 0; background: var(--paper-bg-deep); color: var(--paper-ink);
      font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Charter, Georgia, 'Source Serif 4', serif;
    }
    .bp-sheet-shell {
      max-width: 1080px; margin: 0 auto; padding: 56px 40px 96px;
      display: flex; flex-direction: column; min-height: 100vh;
    }
    .bp-sheet-head { margin: 0 0 1.75rem; }
    .bp-sheet-eyebrow {
      margin: 0 0 0.75rem;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--paper-accent);
      padding-bottom: 0.5rem; border-bottom: 1px solid rgba(162, 57, 37, 0.2);
    }
    .bp-sheet-title { margin: 0 0 0.4rem; font-size: 2rem; line-height: 1.2; font-weight: 600; }
    .bp-sheet-byline {
      margin: 0; font-style: italic; font-size: 0.9rem; color: var(--paper-ink-soft);
    }
    .bp-sheet-byline code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-style: normal; font-size: 0.82rem;
    }

    /* ── Read-only grid (the Studio .sheet-* subset) ───────────────────────
       COHESION MIRROR: these rules track the root.html.heex Studio .sheet-*
       block (rhythm/overflow/focus). Edit BOTH when touching a shared rule;
       dark seals here key on prefers-color-scheme (Studio uses data-theme). */
    .sheet-editor { flex: 1; display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
    .sheet-reader {
      background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
      max-height: 75vh;
    }
    /* Reader chrome buttons — the .btn subset the read-only render emits
       (pager Prev/Next, find bar, notice dismiss). Ported from the Studio
       .btn block in root.html.heex, retargeted onto the parchment tokens. */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      height: 32px; padding: 0 12px; border-radius: 4px;
      font-size: 13px; font-weight: 500; cursor: pointer; white-space: nowrap;
      border: 1px solid var(--border); background: transparent; color: var(--fg);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .btn:hover { background: var(--bg-alt); }
    .btn:focus-visible { outline: 2px solid var(--ring); outline-offset: -2px; }
    .btn:disabled { opacity: 0.4; cursor: default; }
    .btn:disabled:hover { background: transparent; }
    .btn-ghost { border-color: transparent; color: var(--fg-dim, var(--fg)); }
    .btn-ghost:hover { background: var(--bg-alt); color: var(--fg); }
    .btn-sm { height: 28px; padding: 0 10px; font-size: 12px; }
    /* The filter panel's Apply. Accent-on-paper both ways: the dark-red light
       accent carries near-white ink, the lighter dark-mode accent carries
       near-black — var(--paper-bg) is the right ink in both schemes. */
    .btn-primary { background: var(--paper-accent); border-color: var(--paper-accent); color: var(--paper-bg); }
    .btn-primary:hover { background: var(--paper-accent); filter: brightness(1.12); }
    /* Transient per-op rejection alert (role="alert"): the amber notice band,
       ported from root.html.heex. The parchment base is LIGHT, so the dark
       amber leads and prefers-color-scheme swaps in the light-on-dark pair
       (root keys the same swap on data-theme). */
    .sheet-notice {
      display: flex; align-items: center; justify-content: space-between;
      padding: 3px 12px; font-size: 12px; color: #b54708; /* lit-allow: warn-severity notice amber on the light parchment (dark twin below); bespoke amber-700, no exact reader token — out of this task's info-blue scope */
      background: rgba(247, 144, 9, 0.08); border-bottom: 1px solid var(--border);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    @media (prefers-color-scheme: dark) {
      .sheet-notice { color: #fdb022; background: rgba(247, 144, 9, 0.12); }
    }
    .sheet-grid-wrap { flex: 1; min-height: 0; display: flex; flex-direction: column; outline: none; }
    /* WCAG 2.4.7: visible keyboard-focus ring on the focusable grid wrapper. */
    .sheet-grid-wrap:focus-visible { outline: 2px solid var(--ring); outline-offset: -2px; }
    /* Visually-hidden polite SR status region (see the SheetGrid render). */
    .sheet-sr-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .sheet-scroll { flex: 1; overflow: auto; min-height: 0; }
    /* tabular-nums mirrors the Studio grid: fixed-advance digits keep number
       columns vertically aligned in the read-only view too. */
    .sheet-table { border-collapse: separate; border-spacing: 0; table-layout: fixed; font-size: 12.5px; font-variant-numeric: tabular-nums; }
    /* Value-shaped default alignment classes (mirrors root.html.heex; the
       read-only grid stamps the same Cells.cell_class list). */
    .sheet-cell.sheet-al-right { text-align: right; }
    .sheet-cell.sheet-al-center { text-align: center; }
    .sheet-table th, .sheet-table td {
      border-right: 1px solid var(--border); border-bottom: 1px solid var(--border);
      padding: 0 6px; height: 24px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .sheet-corner, .sheet-colhead, .sheet-rowhead {
      background: var(--bg-alt, var(--bg)); color: var(--fg-dim, var(--fg));
      font-weight: 500; font-size: 11px; text-align: center; user-select: none;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .sheet-corner { position: sticky; top: 0; left: 0; z-index: 6; }
    .sheet-colhead { position: sticky; top: 0; z-index: 4; }
    .sheet-rowhead { position: sticky; left: 0; z-index: 3; }
    .sheet-cell { background: transparent; }
    /* http(s) URL cells render as links in the read-only reader (mirrors the
       Studio grid's display-time link detection). Info-blue via --info: the
       page-scoped token is already theme-tuned (blue-600 light / blue-500 dark),
       so no dark override is needed. */
    .sheet-cell.sheet-link-cell .sheet-cell-v, .sheet-cell .sheet-link { color: var(--info); text-decoration: underline; }
    .sheet-cell.sheet-err { color: #dc2626; font-weight: 600; }
    /* Dark parchment needs the lighter red to clear 4.5:1 (mirrors Studio). */
    @media (prefers-color-scheme: dark) {
      .sheet-cell.sheet-err { color: #f87171; }
    }
    .sheet-cell.sheet-stale .sheet-cell-v::after { content: "•"; color: #f79009; margin-left: 3px; }
    /* ── Reader range selection (client-only, wave 43) ──────────────────────
       `sheet-rsel` is painted by the SheetReaderSelect hook alone — the server
       never stamps it (Geometry.grid_sel(_, _, :reader) is {0,0,0,0}). It is
       deliberately NOT the Studio's `sheet-sel`: aliasing would make the grid
       harness's td.sheet-sel pins ambiguous about which grid produced them.
       `sheet-rsel-on` is added by the same hook on mount, so the native
       text-selection suppression a drag needs exists ONLY when the hook is
       live — a no-JS reader keeps the browser's own select-and-copy. */
    .sheet-rsel-on .sheet-scroll { user-select: none; -webkit-user-select: none; }
    .sheet-cell.sheet-rsel { background: rgba(30, 83, 71, 0.15); }
    @media (prefers-color-scheme: dark) {
      .sheet-cell.sheet-rsel { background: rgba(217, 122, 95, 0.24); }
    }
    /* Find-in-sheet (ALWAYS shown in the reader — no JS hook to Ctrl+F it
       open). .sheet-find/.sheet-find-hit track root.html.heex per the
       shared-.sheet-* cohesion contract; the form/input rules dress the
       default-chrome input for the parchment palette. */
    .sheet-find { display: flex; padding: 4px 12px; border-bottom: 1px solid var(--border); }
    .sheet-find-form { display: flex; align-items: center; gap: 4px; flex: 1; }
    .sheet-find-input {
      flex: 1; max-width: 220px; font-size: 12px; padding: 2px 6px;
      background: var(--bg); color: var(--fg);
      border: 1px solid var(--border); border-radius: 4px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .sheet-cell.sheet-find-hit { background: rgba(250, 204, 21, 0.28); }
    /* Row pager + column-clip notice: a >500-row published sheet pages here.
       Ported from root.html.heex's .sheet-pager (the tabs/statsbar rhythm:
       12px gutter, 11px, top rule) — previously unstyled in the reader. */
    .sheet-pager {
      display: flex; align-items: center; gap: 8px;
      padding: 3px 12px; border-top: 1px solid var(--border);
      font-size: 11px; color: var(--fg-dim, var(--fg));
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .sheet-tabs {
      display: flex; align-items: center; gap: 2px;
      padding: 4px 8px; border-top: 1px solid var(--border); overflow-x: auto;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    /* flex:none + max-width mirrors Studio: long names ellipsize, strip scrolls. */
    .sheet-tab {
      background: none; border: 1px solid transparent; color: var(--fg-dim, var(--fg));
      font-size: 12px; padding: 3px 10px; border-radius: 4px; cursor: pointer;
      font-family: inherit;
      flex: none; max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .sheet-tab:hover { background: var(--bg-accent, var(--bg-alt)); color: var(--fg); }
    .sheet-tab:focus-visible { outline: 2px solid var(--ring); outline-offset: -2px; }
    .sheet-tab.is-active { border-color: var(--paper-accent); color: var(--fg); }

    /* ── Per-column FILTER funnel + editor (SF-AM4) ────────────────────────
       COHESION MIRROR: the funnel is a READ affordance, so the reader carries
       it too — this is the .sheet-popover / .sheet-filter-* SUBSET ported from
       the Studio block in root.html.heex (SF-B), retargeted onto the parchment
       tokens. Edit BOTH when touching a shared funnel rule. NO sort affordance
       is ported — sort is edit-only (SF-AM2d) and never renders here. */
    .sheet-popover {
      position: absolute; z-index: 9;
      min-width: 200px; max-width: 380px; max-height: 240px; overflow-y: auto;
      padding: 4px; font-size: 12px;
      background: var(--bg); border: 1px solid var(--border); border-radius: 6px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    }
    .sheet-filter-funnel {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 2px; margin-left: 1px; border: 0; border-radius: 3px;
      background: transparent; color: var(--fg-dim, var(--fg));
      cursor: pointer; opacity: 0; line-height: 0;
    }
    th:hover > .sheet-filter-funnel,
    th:focus-within > .sheet-filter-funnel,
    .sheet-filter-funnel:focus-visible,
    .sheet-filter-funnel.sheet-funnel-active { opacity: 0.85; }
    .sheet-filter-funnel.sheet-funnel-active { color: var(--paper-accent); opacity: 1; }
    .sheet-filter-funnel:focus-visible { outline: 2px solid var(--ring); outline-offset: 1px; }
    .sheet-filter-panel {
      top: calc(100% + 2px); left: 0; width: 220px; max-width: 92vw;
      padding: 10px 12px; display: flex; flex-direction: column; gap: 8px;
      z-index: 12; cursor: default; font-weight: 400;
      /* the reader body font is serif; the funnel chrome stays UI sans. */
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .sheet-filter-head { display: flex; align-items: center; justify-content: space-between; }
    .sheet-filter-title { font-weight: 600; font-size: 12px; color: var(--fg); }
    .sheet-filter-form { display: flex; flex-direction: column; gap: 7px; }
    .sheet-filter-field { display: flex; flex-direction: column; gap: 3px; font-size: 11px; color: var(--fg-dim, var(--fg)); }
    .sheet-filter-field > input[type="text"], .sheet-filter-field > select {
      padding: 4px 6px; font-size: 12px; color: var(--fg);
      background: var(--bg); border: 1px solid var(--border); border-radius: 4px;
    }
    .sheet-filter-field > input:focus-visible, .sheet-filter-field > select:focus-visible {
      outline: 2px solid var(--ring); outline-offset: -1px;
    }
    /* Light parchment base; the dark seal keys on prefers-color-scheme (the
       Studio twin keys the same swap on data-theme). */
    .sheet-filter-error { margin: 0; font-size: 11px; color: #dc2626; }
    @media (prefers-color-scheme: dark) {
      .sheet-filter-error { color: #f87171; }
    }
    .sheet-filter-actions { display: flex; justify-content: space-between; gap: 6px; }

    /* ── Print: unclip the grid, drop chrome, repeat column heads per page ─── */
    @media print {
      body { background: #fff; } /* lit-allow: print reset — white paper, not a theme color */
      .bp-sheet-shell { max-width: none; padding: 0; }
      .sheet-reader { max-height: none; border: none; }
      .sheet-scroll { overflow: visible; }
      .sheet-tabs { display: none; }
      .sheet-table th, .sheet-table td { break-inside: avoid; }
      /* Static sticky heads avoid duplicated header rows in paged output;
         thead stays a table-header-group so column letters repeat per page. */
      .sheet-corner, .sheet-colhead { position: static; }
      .bp-sheet-byline { display: none; }
      /* Screen-only filter chrome: an ACTIVE funnel is opacity-1 and would
         otherwise print as a glyph in the header; an open panel would overlap
         cells. The filtered VIEW itself prints (hidden rows aren't in the DOM). */
      .sheet-filter-funnel, .sheet-popover { display: none; }
    }

    /* ── Mobile: reclaim horizontal padding, unclip the grid height ────────── */
    @media (max-width: 640px) {
      .bp-sheet-shell { padding: 24px 12px 48px; }
      .bp-sheet-title { font-size: 1.4rem; }
      .sheet-reader { max-height: none; }
    }

    /* CSS-only edge-shadow scroll affordance: cover gradients (local) hide the
       shadow at the true content edges, radial shadows (scroll) fade in when
       there is more to scroll. Cells go transparent in the reader theme so the
       shadows read through; the sticky heads keep their painted bands. */
    .sheet-scroll {
      background:
        linear-gradient(var(--bg) 30%, rgba(0, 0, 0, 0)),
        linear-gradient(rgba(0, 0, 0, 0), var(--bg) 70%) 0 100%,
        radial-gradient(farthest-side at 50% 0, rgba(0, 0, 0, 0.14), rgba(0, 0, 0, 0)),
        radial-gradient(farthest-side at 50% 100%, rgba(0, 0, 0, 0.14), rgba(0, 0, 0, 0)) 0 100%;
      background-repeat: no-repeat;
      background-size: 100% 40px, 100% 40px, 100% 14px, 100% 14px;
      background-attachment: local, local, scroll, scroll;
    }

    /* ── Touch / coarse-pointer: grow the reader tab hit targets toward
       WCAG 2.5.8's 24px minimum. Mirrors the Studio editor's .sheet-tab
       sizing per the shared-.sheet-* cohesion contract. */
    @media (pointer: coarse) {
      .sheet-tab { min-height: 32px; padding: 6px 12px; }
    }
  </style>
</head>
<body>
  {@inner_content}
  <%!-- LiveView client for the live deltas + read-only tab switching. Loaded
        at the BOTTOM of the body (NEVER a blocking <script> in <head> —
        golden rule), same discipline as the bulldocs reader layout. --%>
  <script src="/assets/phoenix.js"></script>
  <script src="/assets/phoenix_live_view.js"></script>
  <%!-- Non-defer ON PURPOSE (same discipline as root.html.heex): it must define
        window.BarkparkSheetReaderSelect BEFORE the inline script below registers
        it as a hook and connects the LiveSocket. Bottom-of-body, so Golden Rule
        #4 (no blocking scripts in head) holds. This file also carries the
        Studio's BarkparkSheetGrid, which is never registered here — the reader
        page has no element with phx-hook="SheetGrid" (the grid's phx-hook keys
        `chrome: :reader` onto SheetReaderSelect), so the Studio hook is inert
        bytes and no editing affordance becomes reachable. --%>
  <script src="/assets/bp-sheet-grid.js"></script>
  <script nonce={assigns[:csp_nonce]}>
    let csrfToken = document.querySelector("meta[name='csrf-token']").getAttribute("content");
    let Hooks = {};
    // SheetReaderSelect — the public reader's CLIENT-ONLY selection + copy
    // layer (main's ruling, 2026-09-02): it paints its own `sheet-rsel` class,
    // reads the `data-v` already on every reader <td>, and pushes ZERO server
    // events, so an anonymous principal never round-trips selection.
    Hooks.SheetReaderSelect = window.BarkparkSheetReaderSelect;
    let liveSocket = new LiveView.LiveSocket("/live", Phoenix.Socket, {
      hooks: Hooks,
      params: { _csrf_token: csrfToken }
    });
    liveSocket.connect();
    window.liveSocket = liveSocket;
  </script>
</body>
</html>
