<!DOCTYPE html>
<%!-- data-bp-theme (ts-w4e) — the paper's workspace THEME IDENTITY, stamped
      server-side so the reader skin paints on the first byte. It is orthogonal
      to light/dark mode: the reader ALWAYS mode-swaps via prefers-color-scheme
      (no data-theme here — reader-dark-parity stays green), and this attribute
      only selects WHICH theme. Omitted for the default (evergreen) theme, so a
      default paper is byte-identical to before this feature. --%>
<html lang="en" data-bp-theme={bp_theme_attr(assigns)}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content={get_csrf_token()} />
  <%!-- A7: the reader is a LiveView — <.live_title> keeps the browser tab in
        sync when :page_title changes (the static ternary never updated live).
        The default carries NO site name: live_title appends the suffix to the
        default too, so "Paper · Barkpark" + suffix would double the brand. --%>
  <.live_title default="Paper" suffix=" · Barkpark">{assigns[:page_title]}</.live_title>
  <%!-- Social-share head (preview-contract pc-w2): og/twitter/JSON-LD emitted
        from the paper's preview manifest, IMMEDIATELY after <title> and BEFORE
        the multi-KB inline style blob (Slack reads only the first 32 KB). The
        `:preview` assign is the write-time `content["preview"]` (or the pc-w1
        read-time projection / a degraded core manifest) that BulldocsLive.mount
        and the share-link / scoped-paper controllers set; `assigns[:preview]`
        is nil-safe — a render path that assigns none renders site-default meta,
        never crashes (charter D12). --%>
  <BarkparkWeb.ShareMeta.head preview={assigns[:preview]} page_title={assigns[:page_title]} />
  <%!-- asciinema-player CSS for `asciicast` blocks (a stylesheet, not a blocking
        <script> — the golden no-blocking-script-in-head rule covers JS; the
        player JS itself loads `defer` in the body alongside mermaid). Pinned to
        3.8.0, the version proven in .artifacts/proofs-index.html. --%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/asciinema-player@3.8.0/dist/bundle/asciinema-player.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; background: #0b0b0d; color: #e7e7ea;
           font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .bp-paper-shell { max-width: 820px; margin: 0 auto; padding: 32px 24px 96px; }

    <%!-- The ONE canonical paper-surface source (paper-surface.css via
          Barkpark.PortableDoc.Render.Stylesheet) — the SAME bytes Studio embeds.
          It provides the `--paper-*`/`--bp-*` tokens + `.bp-paper-surface`
          element rules. It is embedded BEFORE the reader skin below so the
          bp-theme `--paper-*` overrides (later + more specific) win. Surface
          CHROME (page bg/width/padding) is NOT in this source — the reader owns
          its own 820/720px shell above, so nothing here clobbers it. --%>
    <%= raw(Barkpark.PortableDoc.Render.Stylesheet.css()) %>

    /* BEGIN GENERATED: tokens (design/tokens.json — regenerate: node design/emit.mjs --write; do not hand-edit) */
    /* Article chrome — applied only when BulldocsLive marks the doc as
       `content["style"] == "article"` (the LiveView stamps the
       `.bp-paper-article` class on its <main>). Cool bp-theme page, a
       centered ~720px reading column (incl. padding), serif base — so the
       inline-styled article blocks sit on a proper page, not bare white
       full-width. Non-article papers keep the dark chrome above, untouched.

       READER SKIN: token overrides layered over the canonical paper-surface
       source (embedded above). These `--paper-*` values are the historical
       bp-theme reader look. They are set on the <body> AND on the reader
       <main> (`.bp-paper-shell.bp-paper-article`, which now also carries
       `bp-paper-surface`) so they WIN over the shared source's fallback
       `.bp-paper-surface { --paper-* }` block — otherwise render.ex's inline
       `var(--paper-*, hex)` block HTML would resolve to the Studio defaults on
       the reader on the bp-theme (a shared ink #15211d, rule #dde7e2,
       etc.). Dark-mode note: the shared source keys dark on
       `html[data-theme="dark"]`, which the reader NEVER stamps — so the shared
       dark tokens never match here, and the `prefers-color-scheme: dark` block
       below (also carried onto <main>) is what owns reader dark mode, flipping
       the palette to cool bp-dark with light ink so the inline `var(--paper-*)`
       HTML stays readable. Without the <main>-scoped override the shared light
       fallback would paint dark ink on the browser's dark theme — the
       visibility bug. */
    body:has(.bp-paper-article),
    body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
      --paper-bg:         #f6faf9;
      --paper-bg-deep:    #eaf1ee;
      --paper-ink:        #15211d;
      --paper-ink-soft:   #55635e;
      --paper-rule:       #dde7e2;
      --paper-accent:     #1e5347;
      /* Link border-bottom tone (`.bp-paper-surface a` + walk.ex inline links
         read it). Light value matches the shared source's fallback; the dark
         block below MUST re-skin it — otherwise dark-mode link borders resolve
         to this light rgba and vanish against the dark page. */
      --paper-accent-soft: rgba(30, 83, 71, 0.10);
      --paper-reading-accent: #a23925; /* S7 stub — S8 consumes */
    }
    body:has(.bp-paper-article) {
      background: var(--paper-bg-deep);
      color: var(--paper-ink);
      font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Charter, Georgia, 'Source Serif 4', serif;
    }
    @media (prefers-color-scheme: dark) {
      body:has(.bp-paper-article),
      body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
        --paper-bg:         #0e1614;
        --paper-bg-deep:    #131d19;
        --paper-ink:        #e7ede9;
        --paper-ink-soft:   #9aaaa3;
        --paper-rule:       rgba(231, 237, 233, 0.13);
        --paper-accent:     #45b394;
        /* Warm-dark link border (same value as Studio's html[data-theme=dark]
           block in paper-surface.css) — without it links keep the light-theme
           rgba(162,57,37,0.10) border, invisible on the dark page. */
        --paper-accent-soft: rgba(70, 179, 148, 0.16);
        --paper-reading-accent: #d98a6a; /* S7 stub — S8 consumes */
        /* Callout TONE tokens + faint ink + chrome — the SAME reason as the
           --paper-* above: paper-surface.css keys their DARK values on
           `html[data-theme="dark"]`, which the reader NEVER stamps, so an
           OS-dark reader (prefers-color-scheme, no toggle) was left with the
           LIGHT callout tones (#eff6ff on a #131d19 page — a light box on the
           dark article). Re-skin them here, byte-mirroring the dark values in
           paper-surface.css's `html[data-theme="dark"] .bp-paper-surface` block.
           Edit surfaces stamp data-theme and get those directly; this is the
           reader's prefers-color-scheme companion. */
        --paper-ink-faint:    #6c7a74;
        --paper-chrome-bg:    #131d19;
        --paper-chrome-border: rgba(231, 237, 233, 0.13);
        --bp-tone-info-bg:    #172032; --bp-tone-info-fg:    #9db8ff;
        --bp-tone-success-bg: #12241c; --bp-tone-success-fg: #5fcf9c;
        --bp-tone-warning-bg: #2a2210; --bp-tone-warning-fg: #e3b661;
        --bp-tone-danger-bg:  #2a1614; --bp-tone-danger-fg:  #f08a80;
        --bp-tone-neutral-bg: #23211e; --bp-tone-neutral-fg: #c9c2b6;
      }
    }
    /* Mail-client popup chrome (color.mailChrome) — the --mail-* window skin
       for the Email view, relocated here (from #bp-mailapp) so the reader
       palette + the mail chrome are single-sourced in ONE marker region; the
       #bp-mailapp consumers stay below. Theme-aware like a real dark mail
       client showing a light HTML email; the served email bytes never change
       with the theme. */
    #bp-mailapp {
      --mail-paper: #ffffff; --mail-bar: #f6faf9; --mail-rule: #dde7e2;
      --mail-ink: #15211d; --mail-soft: #55635e; --mail-accent: #1e5347;
    }
    @media (prefers-color-scheme: dark) {
      #bp-mailapp {
        --mail-paper: #131d19; --mail-bar: #0e1614; --mail-rule: #26332d;
        --mail-ink: #e7ede9; --mail-soft: #9aaaa3; --mail-accent: #45b394;
      }
    }
    /* ── theme identity (data-bp-theme) — orthogonal to light/dark mode; the bare declarations above are the evergreen fallback (no attribute → renders exactly as today) ── */
    html[data-bp-theme="evergreen"] body:has(.bp-paper-article),
    html[data-bp-theme="evergreen"] body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
      --paper-bg: #f6faf9;
      --paper-bg-deep: #eaf1ee;
      --paper-ink: #15211d;
      --paper-ink-soft: #55635e;
      --paper-rule: #dde7e2;
      --paper-accent: #1e5347;
      --paper-accent-soft: rgba(30, 83, 71, 0.10);
      --paper-reading-accent: #a23925;
    }
    @media (prefers-color-scheme: dark) {
      html[data-bp-theme="evergreen"] body:has(.bp-paper-article),
      html[data-bp-theme="evergreen"] body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
        --paper-bg: #0e1614;
        --paper-bg-deep: #131d19;
        --paper-ink: #e7ede9;
        --paper-ink-soft: #9aaaa3;
        --paper-rule: rgba(231, 237, 233, 0.13);
        --paper-accent: #45b394;
        --paper-accent-soft: rgba(70, 179, 148, 0.16);
        --paper-reading-accent: #d98a6a;
        --paper-ink-faint: #6c7a74;
        --paper-chrome-bg: #131d19;
        --paper-chrome-border: rgba(231, 237, 233, 0.13);
        --bp-tone-info-bg: #172032; --bp-tone-info-fg: #9db8ff;
        --bp-tone-success-bg: #12241c; --bp-tone-success-fg: #5fcf9c;
        --bp-tone-warning-bg: #2a2210; --bp-tone-warning-fg: #e3b661;
        --bp-tone-danger-bg: #2a1614; --bp-tone-danger-fg: #f08a80;
        --bp-tone-neutral-bg: #23211e; --bp-tone-neutral-fg: #c9c2b6;
      }
    }
    html[data-bp-theme="evergreen"] #bp-mailapp {
      --mail-paper: #ffffff; --mail-bar: #f6faf9; --mail-rule: #dde7e2;
      --mail-ink: #15211d; --mail-soft: #55635e; --mail-accent: #1e5347;
    }
    @media (prefers-color-scheme: dark) {
      html[data-bp-theme="evergreen"] #bp-mailapp {
        --mail-paper: #131d19; --mail-bar: #0e1614; --mail-rule: #26332d;
        --mail-ink: #e7ede9; --mail-soft: #9aaaa3; --mail-accent: #45b394;
      }
    }
    html[data-bp-theme="ember"] body:has(.bp-paper-article),
    html[data-bp-theme="ember"] body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
      --paper-bg: #fef9f7;
      --paper-bg-deep: #f4ece9;
      --paper-ink: #291d19;
      --paper-ink-soft: #5b504c;
      --paper-rule: #e2dcda;
      --paper-accent: #c34e13;
      --paper-accent-soft: rgba(195, 78, 19, 0.10);
      --paper-reading-accent: #bf321d;
    }
    @media (prefers-color-scheme: dark) {
      html[data-bp-theme="ember"] body:has(.bp-paper-article),
      html[data-bp-theme="ember"] body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
        --paper-bg: #0d0805;
        --paper-bg-deep: #18120d;
        --paper-ink: #e4ddd8;
        --paper-ink-soft: #a59d98;
        --paper-rule: rgba(228, 221, 216, 0.13);
        --paper-accent: #f7993b;
        --paper-accent-soft: rgba(247, 153, 59, 0.16);
        --paper-reading-accent: #f5855c;
        --paper-ink-faint: #716b67;
        --paper-chrome-bg: #18120d;
        --paper-chrome-border: rgba(228, 221, 216, 0.13);
        --bp-tone-info-bg: #020926; --bp-tone-info-fg: #a6beee;
        --bp-tone-success-bg: #001103; --bp-tone-success-fg: #9ccca5;
        --bp-tone-warning-bg: #140a00; --bp-tone-warning-fg: #dab889;
        --bp-tone-danger-bg: #210001; --bp-tone-danger-fg: #eaaca4;
        --bp-tone-neutral-bg: #0d0c0b; --bp-tone-neutral-fg: #c0bdbb;
      }
    }
    html[data-bp-theme="ember"] #bp-mailapp {
      --mail-paper: #fdfcfb; --mail-bar: #fef9f7; --mail-rule: #e2dcda;
      --mail-ink: #291d19; --mail-soft: #5b504c; --mail-accent: #c34e13;
    }
    @media (prefers-color-scheme: dark) {
      html[data-bp-theme="ember"] #bp-mailapp {
        --mail-paper: #18120d; --mail-bar: #0d0805; --mail-rule: #38332f;
        --mail-ink: #e4ddd8; --mail-soft: #a59d98; --mail-accent: #f7993b;
      }
    }
    html[data-bp-theme="fjord"] body:has(.bp-paper-article),
    html[data-bp-theme="fjord"] body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
      --paper-bg: #f8fafe;
      --paper-bg-deep: #eaeef5;
      --paper-ink: #1c202a;
      --paper-ink-soft: #4e535c;
      --paper-rule: #dbdee2;
      --paper-accent: #2f56b1;
      --paper-accent-soft: rgba(47, 86, 177, 0.10);
      --paper-reading-accent: #0f8299;
    }
    @media (prefers-color-scheme: dark) {
      html[data-bp-theme="fjord"] body:has(.bp-paper-article),
      html[data-bp-theme="fjord"] body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
        --paper-bg: #06090e;
        --paper-bg-deep: #0f1319;
        --paper-ink: #dadfe5;
        --paper-ink-soft: #9aa0a7;
        --paper-rule: rgba(218, 223, 229, 0.13);
        --paper-accent: #68a2e8;
        --paper-accent-soft: rgba(104, 162, 232, 0.16);
        --paper-reading-accent: #53d6ea;
        --paper-ink-faint: #686d72;
        --paper-chrome-bg: #0f1319;
        --paper-chrome-border: rgba(218, 223, 229, 0.13);
        --bp-tone-info-bg: #030a22; --bp-tone-info-fg: #aabee6;
        --bp-tone-success-bg: #001103; --bp-tone-success-fg: #a2c9a9;
        --bp-tone-warning-bg: #140a00; --bp-tone-warning-fg: #d6b992;
        --bp-tone-danger-bg: #1e0202; --bp-tone-danger-fg: #e3afa8;
        --bp-tone-neutral-bg: #0b0c0e; --bp-tone-neutral-fg: #bcbec0;
      }
    }
    html[data-bp-theme="fjord"] #bp-mailapp {
      --mail-paper: #fcfcfd; --mail-bar: #f8fafe; --mail-rule: #dbdee2;
      --mail-ink: #1c202a; --mail-soft: #4e535c; --mail-accent: #2f56b1;
    }
    @media (prefers-color-scheme: dark) {
      html[data-bp-theme="fjord"] #bp-mailapp {
        --mail-paper: #0f1319; --mail-bar: #06090e; --mail-rule: #303439;
        --mail-ink: #dadfe5; --mail-soft: #9aa0a7; --mail-accent: #68a2e8;
      }
    }
    /* END GENERATED: tokens */
    .bp-paper-shell.bp-paper-article {
      max-width: 720px;
      padding: 56px 40px 96px;
      line-height: 1.65;
    }

    /* pdd-t19 → parity: the article stream's VERTICAL RHYTHM now lives in the
       SHARED `.bp-paper-surface hN` rules (top-only margins, parity-gated with
       the edit canvas), so the reader and the editor breathe IDENTICALLY. The
       reader keeps only the first-child clamp — the div-per-block wrapping means
       the first heading's top margin must be zeroed here (the shared
       `> :first-child` clamp sees the wrapper div, not the heading inside it). */
    .bp-paper-article [data-block-id]:first-child h1,
    .bp-paper-article [data-block-id]:first-child h2,
    .bp-paper-article [data-block-id]:first-child h3 { margin-top: 0; }

    /* Native form block styles moved to the canonical paper-surface source
       (paper-surface.css §form/questionnaire, gui-premium w2) — the reader
       article carries .bp-paper-surface, so it resolves them from the shared
       sheet like every other component; a reader-local mirror here would
       fight it on specificity (the form-block-dark-mode lesson). */

    /* P6.U5 action bar — the paper doc action buttons (Create plan /
       Grill / Build / Submit) rendered natively on the paper. A restrained
       sticky row at the top of the article column, in the article palette
       (bp-theme surface, evergreen accent, sans label). Scoped under
       `.bp-paper-article` so non-article papers stay untouched. The bar is
       rendered only when BulldocsLive derived a non-empty action set from
       content["source_doc"]. */
    .bp-paper-article .bp-paper-actions {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem;
      margin: 0 0 1.75rem;
      padding: 0.75rem 0;
      background: var(--paper-bg);
      border-bottom: 1px solid var(--paper-rule);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .bp-paper-article .bp-paper-action {
      appearance: none;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: var(--paper-accent);
      background: var(--paper-bg);
      border: 1px solid var(--paper-rule);
      border-radius: 6px;
      padding: 0.45rem 0.9rem;
      transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
    }
    .bp-paper-article .bp-paper-action:hover {
      background: var(--paper-accent);
      color: var(--paper-bg);
      border-color: var(--paper-accent);
    }
    .bp-paper-article .bp-paper-action:focus-visible {
      outline: 2px solid var(--paper-accent);
      outline-offset: 2px;
    }
    .bp-paper-article .bp-paper-action-ack {
      font-size: 0.78rem;
      font-style: italic;
      color: var(--paper-ink-soft);
      margin-left: 0.25rem;
    }

    /* P6.U4 Simplify control — a small row rendered for any goal-bearing
       paper (independent of the U5 doc-type action set). Reuses the
       `.bp-paper-action` button palette; the Accept/Reject pair appears only
       once a simplify-request is pending. Accept reads as the affirmative
       (filled terracotta on hover, like the other actions); Reject is muted
       gray so the destructive choice doesn't shout. Scoped under
       `.bp-paper-article` so non-article papers stay untouched. */
    .bp-paper-article .bp-paper-simplify {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem;
      margin: 0 0 1.75rem;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .bp-paper-article .bp-paper-simplify-decide {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .bp-paper-article .bp-paper-action-reject {
      color: var(--paper-ink-soft);
      border-color: var(--paper-rule);
    }
    .bp-paper-article .bp-paper-action-reject:hover {
      background: var(--paper-ink-soft);
      color: var(--paper-bg);
      border-color: var(--paper-ink-soft);
    }

    /* P6.U2 goal-path rail — a 240px sticky right-rail showing the paper's
       goal lifecycle as a Mermaid gitGraph plus a clickable event list. Scoped
       under `.bp-paper-article` so non-article papers are untouched. The shell
       centers a 720px reading column; the rail floats to the right of that
       column (offset via a negative right margin) and sticks while scrolling.
       On narrow viewports it falls back to a normal in-flow block under the
       article. The <aside> is a child of <main>, sibling of the <article>. */
    .bp-paper-article .bp-goal-rail {
      width: 240px;
      margin: 2.5rem 0 0 auto;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    @media (min-width: 1100px) {
      .bp-paper-article .bp-goal-rail {
        position: sticky;
        top: 56px;
        float: right;
        margin: 0 -300px 1.5rem 1.5rem;
      }
    }
    .bp-paper-article .bp-goal-rail-title {
      margin: 0 0 0.75rem;
      /* `inherit` re-takes the rail's sans stack: the shared paper-surface
         `.bp-paper-surface h1..h6 { font-family: var(--paper-font-serif) }`
         rule hits this <h2> DIRECTLY and would beat the sans the rail
         container only passes down by inheritance. Same story for
         line-height (shared `h2 { line-height: 1.2 }` vs the shell's 1.65). */
      font-family: inherit;
      line-height: inherit;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--paper-accent);
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--paper-rule);
    }
    .bp-paper-article .bp-goal-rail #goal-path-graph {
      margin: 0 0 1rem;
    }
    .bp-paper-article .bp-goal-rail .mermaid {
      margin: 0;
      background: none;
      font-size: 0.8rem;
      /* Neutralize the shared `.bp-paper-surface pre` code-block chrome
         (border/padding/radius) — the rail's gitGraph is a naked 240px
         diagram, not a code block; without these it grows a bp-theme
         inset box. Reader-chrome override per charter Decision 5. */
      border: 0;
      border-radius: 0;
      padding: 0;
    }
    .bp-paper-article .bp-goal-rail-events {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .bp-paper-article .bp-goal-rail-event {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin: 0.1rem 0;
      padding: 0.35rem 0.5rem;
      border-radius: 4px;
      font-size: 0.85rem;
      color: var(--paper-ink);
      cursor: pointer;
      transition: background 0.12s ease;
    }
    .bp-paper-article .bp-goal-rail-event:hover {
      background: var(--paper-accent-soft);
    }
    .bp-paper-article .bp-goal-rail-event.is-selected {
      background: var(--paper-accent-soft);
      box-shadow: inset 3px 0 0 var(--paper-accent);
    }
    .bp-paper-article .bp-goal-rail-event-idx {
      flex: 0 0 auto;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--paper-accent);
      min-width: 1.1em;
      text-align: right;
    }
    .bp-paper-article .bp-goal-rail-event-type {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.78rem;
    }

    /* P6.U3 diff selection markers — shift-clicking two rail rows marks them
       as the A / B endpoints of a diff. RailDiffSelect toggles these classes;
       they read as a subtle accent outline distinct from the plain
       `is-selected` highlight (which still fires on a non-shift click). */
    .bp-paper-article .bp-goal-rail-event.is-diff-a,
    .bp-paper-article .bp-goal-rail-event.is-diff-b {
      box-shadow: inset 3px 0 0 #2f7a4d;
      background: rgba(47, 122, 77, 0.1);
    }

    /* P6.U3 diff modal — opens when two rail nodes are shift-clicked. A
       full-viewport overlay (backdrop + centered panel) over the article. The
       diff body reuses the article palette: a bp-theme panel, monospace diff
       lines, restrained add/del/ctx coloring. Scoped under `.bp-paper-article`
       like the rest; the modal markup is a child of <main>. */
    .bp-paper-article .bp-diff-overlay {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .bp-paper-article .bp-diff-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(20, 18, 14, 0.55);
    }
    .bp-paper-article .bp-diff-panel {
      position: relative;
      z-index: 1;
      width: min(760px, 100%);
      max-height: 80vh;
      overflow: auto;
      background: var(--paper-bg);
      border: 1px solid rgba(26, 26, 26, 0.12);
      border-radius: 8px;
      box-shadow: 0 12px 40px rgba(20, 18, 14, 0.3);
      padding: 1.25rem 1.5rem 1.5rem;
    }
    .bp-paper-article .bp-diff-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin: 0 0 1rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid var(--paper-rule);
    }
    .bp-paper-article .bp-diff-title {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      /* Pin against the shared `.bp-paper-surface h2 { line-height: 1.2 }`
         element rule (this <h2> sits inside the surface <main>). */
      line-height: inherit;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--paper-ink);
    }
    .bp-paper-article .bp-diff-from,
    .bp-paper-article .bp-diff-to {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--paper-accent);
    }
    .bp-paper-article .bp-diff-arrow {
      margin: 0 0.4rem;
      color: var(--paper-ink-soft);
    }
    .bp-paper-article .bp-diff-close {
      flex: 0 0 auto;
      border: none;
      background: none;
      font-size: 1.4rem;
      line-height: 1;
      color: var(--paper-ink-soft);
      cursor: pointer;
      padding: 0 0.25rem;
      border-radius: 4px;
      transition: background 0.12s ease, color 0.12s ease;
    }
    .bp-paper-article .bp-diff-close:hover {
      background: var(--paper-accent-soft);
      color: var(--paper-accent);
    }

    /* The diff body itself — TextDiff.format_diff_html/1 emits
       <pre class="bp-diff"> of one <span class="bp-diff-line bp-diff-{…}">
       per line. Monospace, line-per-row, add greenish / del reddish / ctx
       muted — restrained so it reads as an article aside, not a terminal. */
    .bp-paper-article .bp-diff {
      margin: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.82rem;
      line-height: 1.5;
      white-space: pre-wrap;
      word-break: break-word;
      /* Neutralize the shared `.bp-paper-surface pre` code-block chrome —
         this diff is a naked aside inside the modal panel; the shared bp-theme
         box would otherwise grow a bordered inset here. Reader-chrome override,
         Decision 5. (The panel + diff lines now theme via the --paper-*/
         --bp-tone-* tokens, so an OS-dark reader gets a dark modal, not a
         blinding-light one.) */
      background: none;
      border: 0;
      border-radius: 0;
      padding: 0;
    }
    .bp-paper-article .bp-diff-line {
      display: block;
      padding: 0 0.5rem;
      border-radius: 2px;
    }
    .bp-paper-article .bp-diff-add {
      background: var(--bp-tone-success-bg);
      color: var(--bp-tone-success-fg);
    }
    .bp-paper-article .bp-diff-del {
      background: var(--bp-tone-danger-bg);
      color: var(--bp-tone-danger-fg);
    }
    .bp-paper-article .bp-diff-ctx {
      color: var(--paper-ink-soft);
    }

    /* Sheet-embed default alignment. The walker (PortableDoc.Render.Walk)
       stamps these as CLASSES, never inline — the sheets-parity suite pins
       the inline b/i/bg/al styles identical across surfaces, and an explicit
       s.al (inline) outranks the class by CSS precedence. Mirror of the
       Studio grid's .sheet-cell.sheet-al-* rules (root.html.heex). */
    td.sheet-al-right { text-align: right; }
    td.sheet-al-center { text-align: center; }

    /* ── TUI view: a terminal skin for the reader, toggled bottom-right ──────
       Opt-in (body.bp-tui), persisted client-side. It re-skins the SAME article
       HTML as a terminal — monospace, near-black ground, box-drawing tables,
       markdown-ish heading prefixes — evoking the Go pdrender surface
       (`bp paper view`). Purely presentational + additive; the render pipeline
       is untouched. Scoped to `.bp-paper-article` so email/non-article papers
       are never affected. */
    .bp-view-toggle {
      position: fixed; right: 20px; bottom: 20px; z-index: 60;
      display: inline-flex; align-items: center; gap: 8px;
      font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 12.5px;
      font-weight: 600; letter-spacing: 0.02em;
      padding: 8px 13px; border-radius: 999px; cursor: pointer;
      color: #2f6b4e; background: rgba(255,255,255,0.86);
      border: 1px solid rgba(20,40,30,0.16);
      box-shadow: 0 2px 10px rgba(20,40,30,0.14); backdrop-filter: blur(6px);
      transition: background 0.15s, color 0.15s, transform 0.08s;
    }
    .bp-view-toggle:hover { transform: translateY(-1px); }
    /* The email pill stacks above the TUI pill. The three views are mutually
       exclusive; inside an alternate view only that view's own pill stays
       visible, as the way back to the reader. */
    .bp-view-toggle--email { bottom: 62px; }
    body.bp-tui .bp-view-toggle--email { display: none; }
    body.bp-email .bp-view-toggle:not(.bp-view-toggle--email) { display: none; }
    .bp-view-toggle:focus-visible { outline: 2px solid #2f7d5b; outline-offset: 2px; }
    .bp-view-toggle .bp-vt-dot { width: 7px; height: 7px; border-radius: 50%; background: #2f7d5b; }
    /* hide the toggle when there is no article paper on the page */
    body:not(:has(.bp-paper-article)) .bp-view-toggle { display: none; }

    /* toggle look in TUI mode */
    body.bp-tui .bp-view-toggle {
      color: #5fcf9c; background: rgba(10,15,12,0.9);
      border-color: rgba(95,207,156,0.35); box-shadow: 0 2px 14px rgba(0,0,0,0.5);
    }
    body.bp-tui .bp-view-toggle .bp-vt-dot { background: #5fcf9c; box-shadow: 0 0 6px #5fcf9c; }

    /* toggle look in Email mode — the pill sits on the inbox ground */
    body.bp-email .bp-view-toggle--email { bottom: 20px; }
    body.bp-email .bp-view-toggle--email .bp-vt-dot { box-shadow: 0 0 6px #2f7d5b; }

    /* ── the REAL TUI render (the actual Go pdrender, compiled to WASM) ──────
       In TUI mode we HIDE the reader article and show a real TERMINAL WINDOW:
       a title bar (traffic lights + slug), and a fixed-width content column
       holding the EXACT pdrender output (ANSI→HTML by the wasm). The column is a
       stable N-column monospace grid (`--bp-cols`, default 100) — it never
       reflows to the viewport, so the render is the same width regardless of
       screen size, exactly like a terminal. This is the same renderer
       `bp paper view` runs; not a CSS imitation. */
    body.bp-tui { background: #05070a; }
    body.bp-tui .bp-paper-shell.bp-paper-article { display: none; }
    #bp-terminal { display: none; }
    body.bp-tui #bp-terminal {
      display: block;
      /* SAME max width as the reader column (.bp-paper-shell.bp-paper-article's
         max-width: 720px) — Reader view and TUI view occupy the identical
         measure, so toggling never reflows the page. 720px happens to fit a
         classic 80-column terminal exactly at this 14px monospace, so the wasm
         renders at a FIXED 80 cols (TUI_COLS below must stay in lockstep). On a
         narrower screen the box shrinks like the reader; the 80-col grid does
         NOT reflow — .bp-term-scroll scrolls horizontally inside the window. */
      width: min(720px, calc(100vw - 32px));
      margin: 26px auto 60px;
      background: #0b0e13;
      border: 1px solid #232a35;
      border-radius: 10px;
      box-shadow: 0 24px 70px rgba(0,0,0,0.6), 0 0 0 1px #05070a;
      overflow: hidden;
    }
    #bp-terminal .bp-term-bar {
      display: flex; align-items: center; gap: 8px;
      height: 34px; padding: 0 13px;
      background: linear-gradient(#1a2029, #141922);
      border-bottom: 1px solid #232a35;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 12px; color: #6b7685;
    }
    #bp-terminal .bp-term-dots { display: inline-flex; gap: 7px; }
    #bp-terminal .bp-term-dots i { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
    #bp-terminal .bp-term-dots i:nth-child(1) { background: #ff5f56; }
    #bp-terminal .bp-term-dots i:nth-child(2) { background: #ffbd2e; }
    #bp-terminal .bp-term-dots i:nth-child(3) { background: #27c93f; }
    #bp-terminal .bp-term-title { flex: 1; text-align: center; letter-spacing: 0.02em; }
    #bp-terminal .bp-term-title b { color: #aab6c4; font-weight: 600; }
    #bp-terminal .bp-term-scroll { overflow-x: auto; overflow-y: hidden; }
    #bp-terminal .bp-term-body { padding: 16px 20px 26px; width: max-content; min-width: 100%; }
    #bp-terminal .bp-term-body::before {
      content: "$ bp paper view " attr(data-slug);
      display: block; color: #5fcf9c; font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 14px; margin-bottom: 12px; opacity: 0.85;
    }
    #bp-terminal .bp-tui-pre {
      font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
      font-size: 14px; line-height: 1.5; color: #c8d3cc; white-space: pre; margin: 0;
      -webkit-font-smoothing: antialiased;
    }
    #bp-terminal .bp-tui-loading { color: #6b7972; font-family: ui-monospace, Menlo, monospace; font-size: 14px; padding: 4px 0; }
    /* ── Email view: the paper as a RECEIVED MAIL ────────────────────────────
       In Email mode we HIDE the reader article and show a MAIL CLIENT WINDOW:
       title bar, message toolbar, sender header (avatar / from / to me /
       received stamp), and the message body — an <iframe> of the literal
       /papers/:slug/email response. Those are the exact bytes a mail backend
       sends (Render.render_document, all styles inline); no CSS imitation,
       the same honesty rule as the TUI view. The chrome is theme-aware — a
       dark mail client showing a light HTML email, exactly like real clients —
       but the message bytes never change with the theme. */
    #bp-mailapp {
      /* --mail-* window-chrome vars are GENERATED into the reader-skin marker
         region above (design/tokens.json color.mailChrome → design/emit.mjs). */
      display: none;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    }
    body.bp-email { background: #e3ece7; }
    body.bp-email .bp-paper-shell.bp-paper-article { display: none; }
    body.bp-email #bp-mailapp {
      display: block;
      /* SAME measure as the reader column and the terminal window — the three
         views occupy identical width, so toggling never reflows the page. */
      width: min(720px, calc(100vw - 32px));
      margin: 26px auto 60px;
      background: var(--mail-paper);
      border: 1px solid var(--mail-rule);
      border-radius: 12px;
      box-shadow: 0 24px 70px rgba(21,33,29,0.18), 0 2px 8px rgba(21,33,29,0.08);
      overflow: hidden;
    }
    @media (prefers-color-scheme: dark) {
      body.bp-email { background: #0a100e; }
      body.bp-email #bp-mailapp { box-shadow: 0 24px 70px rgba(0,0,0,0.55); }
    }
    #bp-mailapp .bp-mail-bar {
      display: flex; align-items: center; gap: 8px;
      height: 34px; padding: 0 13px;
      background: var(--mail-bar);
      border-bottom: 1px solid var(--mail-rule);
      font-size: 12px; color: var(--mail-soft);
    }
    #bp-mailapp .bp-mail-dots { display: inline-flex; gap: 7px; }
    #bp-mailapp .bp-mail-dots i { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
    #bp-mailapp .bp-mail-dots i:nth-child(1) { background: #ff5f56; }
    #bp-mailapp .bp-mail-dots i:nth-child(2) { background: #ffbd2e; }
    #bp-mailapp .bp-mail-dots i:nth-child(3) { background: #27c93f; }
    #bp-mailapp .bp-mail-title { flex: 1; text-align: center; letter-spacing: 0.02em; }
    #bp-mailapp .bp-mail-title b { color: var(--mail-ink); font-weight: 600; }
    /* the unread count settles once the message has been "read" (a beat after open) */
    #bp-mailapp .bp-mail-unread { transition: opacity 0.6s; }
    #bp-mailapp.bp-mail-read .bp-mail-unread { opacity: 0; }
    #bp-mailapp .bp-mail-toolbar {
      display: flex; align-items: center; gap: 4px;
      padding: 7px 12px;
      border-bottom: 1px solid var(--mail-rule);
    }
    #bp-mailapp .bp-mail-tool {
      display: inline-flex; align-items: center; justify-content: center;
      width: 30px; height: 28px; padding: 0;
      border: 0; border-radius: 6px; background: transparent;
      color: var(--mail-soft); cursor: pointer;
    }
    #bp-mailapp .bp-mail-tool:hover { background: var(--mail-bar); color: var(--mail-accent); }
    #bp-mailapp .bp-mail-tool:focus-visible { outline: 2px solid var(--mail-accent); outline-offset: 1px; }
    #bp-mailapp .bp-mail-tool[aria-pressed="true"] { color: #d5a021; }
    #bp-mailapp .bp-mail-tool[aria-pressed="true"] svg { fill: #d5a021; }
    #bp-mailapp .bp-mail-tooldiv { width: 1px; height: 18px; background: var(--mail-rule); margin: 0 6px; }
    #bp-mailapp .bp-mail-toolsp { flex: 1; }
    #bp-mailapp .bp-mail-head { padding: 18px 20px 14px; }
    #bp-mailapp .bp-mail-subjrow { display: flex; align-items: center; gap: 9px; }
    /* unread dot beside the subject — fades as the mail is "read" */
    #bp-mailapp .bp-mail-dot {
      width: 8px; height: 8px; border-radius: 50%; flex: none;
      background: var(--mail-accent); transition: opacity 0.6s;
    }
    #bp-mailapp.bp-mail-read .bp-mail-dot { opacity: 0; }
    #bp-mailapp .bp-mail-subject {
      margin: 0; font-size: 19px; line-height: 1.3; font-weight: 650;
      color: var(--mail-ink); letter-spacing: -0.01em; text-wrap: balance;
    }
    #bp-mailapp .bp-mail-fromrow {
      display: flex; align-items: center; gap: 12px; margin-top: 14px;
    }
    #bp-mailapp .bp-mail-avatar {
      width: 40px; height: 40px; border-radius: 50%; flex: none;
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--mail-accent); color: #f6faf9;
      font-size: 13px; font-weight: 600; letter-spacing: 0.04em;
    }
    #bp-mailapp .bp-mail-who { flex: 1; min-width: 0; }
    #bp-mailapp .bp-mail-fromline { font-size: 14px; color: var(--mail-ink); }
    #bp-mailapp .bp-mail-fromline b { font-weight: 600; }
    #bp-mailapp .bp-mail-addr { color: var(--mail-soft); font-size: 13px; }
    #bp-mailapp .bp-mail-toline { font-size: 12.5px; color: var(--mail-soft); margin-top: 2px; }
    #bp-mailapp .bp-mail-date { font-size: 12.5px; color: var(--mail-soft); white-space: nowrap; align-self: flex-start; margin-top: 2px; }
    #bp-mailapp .bp-mail-bodywrap { border-top: 1px solid var(--mail-rule); }
    /* the served email document carries its own tinted page ground — inside
       the window it reads as the client's message area */
    #bp-mailapp iframe {
      display: block; width: 100%; border: 0; min-height: 320px;
      background: #eaf1ee;
    }
    #bp-mailapp .bp-mail-foot {
      display: flex; align-items: center; gap: 8px;
      padding: 12px 16px;
      border-top: 1px solid var(--mail-rule);
    }
    #bp-mailapp .bp-mail-btn {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 7px 16px; border-radius: 999px;
      border: 1px solid var(--mail-rule);
      font-size: 13px; font-weight: 600; text-decoration: none;
      color: var(--mail-ink); background: transparent;
    }
    #bp-mailapp .bp-mail-btn:hover { border-color: var(--mail-accent); color: var(--mail-accent); }
    #bp-mailapp .bp-mail-browser {
      margin-left: auto; font-size: 12.5px; text-decoration: none;
      color: var(--mail-soft);
    }
    #bp-mailapp .bp-mail-browser:hover { color: var(--mail-accent); }
    @media (prefers-reduced-motion: reduce) {
      .bp-view-toggle { transition: none; }
      #bp-mailapp .bp-mail-dot, #bp-mailapp .bp-mail-unread { transition: none; }
    }
  </style>
</head>
<body>
  {@inner_content}

  <%!-- Reader / TUI / Email view toggles (bottom-right, mutually exclusive).
        TUI mode renders the paper through the REAL Go pdrender, compiled to
        WASM (bp-pdrender.wasm.gz) — the exact renderer `bp paper view` runs,
        converted ANSI→HTML in the wasm. The wasm is lazy-loaded on first
        activation. Blocks come from the public query API (filtered to this
        slug). Email mode shows the mail-client window below. The divs + script
        live at the END of <body> (never a blocking <head> script — golden
        rule). --%>
  <div id="bp-terminal" aria-live="polite">
    <div class="bp-term-bar">
      <span class="bp-term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="bp-term-title"><b>bp paper view</b> · pdrender</span>
      <span style="width:52px" aria-hidden="true"></span>
    </div>
    <div class="bp-term-scroll">
      <div class="bp-term-body" id="bp-tui-out"></div>
    </div>
  </div>
  <button
    type="button"
    class="bp-view-toggle"
    aria-pressed="false"
    aria-label="Toggle terminal (TUI) view"
    onclick="window.__bpToggleTui && window.__bpToggleTui()"
  >
    <span class="bp-vt-dot" aria-hidden="true"></span>
    <span class="bp-vt-label">TUI view</span>
  </button>
  <%!-- Email view: the paper as a RECEIVED MAIL. A mail-client window whose
        message body iframes the literal /papers/:slug/email response — the
        same bytes a mail backend sends (lazy: src set on first activation).
        The toolbar's back/archive/trash all "file the mail away", i.e. return
        to the reader; Reply/Forward are real mailto: links; "View in browser"
        keeps the raw-bytes tab. --%>
  <div id="bp-mailapp" aria-live="polite">
    <div class="bp-mail-bar">
      <span class="bp-mail-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="bp-mail-title"><b>Barkpark Mail</b> · Inbox<span class="bp-mail-unread" id="bp-mail-unread"> (1)</span></span>
      <span style="width:52px" aria-hidden="true"></span>
    </div>
    <div class="bp-mail-toolbar">
      <button type="button" class="bp-mail-tool" data-mail-exit title="Back to inbox" aria-label="Back — return to the reader">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <span class="bp-mail-tooldiv" aria-hidden="true"></span>
      <button type="button" class="bp-mail-tool" data-mail-exit title="Archive" aria-label="Archive — return to the reader">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8v13H3V8M1 3h22v5H1zM10 12h4"/></svg>
      </button>
      <button type="button" class="bp-mail-tool" data-mail-exit title="Delete" aria-label="Delete — return to the reader">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/></svg>
      </button>
      <span class="bp-mail-toolsp" aria-hidden="true"></span>
      <button type="button" class="bp-mail-tool" id="bp-mail-star" title="Star" aria-label="Star this message" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </button>
    </div>
    <div class="bp-mail-head">
      <div class="bp-mail-subjrow">
        <span class="bp-mail-dot" aria-hidden="true"></span>
        <h2 class="bp-mail-subject" id="bp-mail-subject">Paper</h2>
      </div>
      <div class="bp-mail-fromrow">
        <span class="bp-mail-avatar" aria-hidden="true">BP</span>
        <div class="bp-mail-who">
          <div class="bp-mail-fromline"><b>Barkpark Papers</b> <span class="bp-mail-addr">&lt;papers@barkpark.cloud&gt;</span></div>
          <div class="bp-mail-toline">to me ▾</div>
        </div>
        <span class="bp-mail-date" id="bp-mail-date"></span>
      </div>
    </div>
    <div class="bp-mail-bodywrap">
      <iframe id="bp-mail-frame" title="This paper rendered as the email subscribers receive"></iframe>
    </div>
    <div class="bp-mail-foot">
      <a class="bp-mail-btn" id="bp-mail-reply" href="#">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
        Reply
      </a>
      <a class="bp-mail-btn" id="bp-mail-forward" href="#">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 17 20 12 15 7"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/></svg>
        Forward
      </a>
      <a class="bp-mail-browser" id="bp-mail-browser" href="#" target="_blank" rel="noopener">View in browser ↗</a>
    </div>
  </div>
  <button
    type="button"
    class="bp-view-toggle bp-view-toggle--email"
    aria-pressed="false"
    aria-label="Toggle email view"
    onclick="window.__bpToggleEmail && window.__bpToggleEmail()"
  >
    <span class="bp-vt-dot" aria-hidden="true"></span>
    <span class="bp-vt-label">Email view</span>
  </button>
  <script>
    (function () {
      var KEY = "bp-paper-view"; // "reader" | "tui" | "email" — one mode at a time
      var btn = document.querySelector(".bp-view-toggle:not(.bp-view-toggle--email)");
      var label = btn && btn.querySelector(".bp-vt-label");
      var emailBtn = document.querySelector(".bp-view-toggle--email");
      var emailLabel = emailBtn && emailBtn.querySelector(".bp-vt-label");
      var out = document.getElementById("bp-tui-out");
      var wasmReady = null; // a promise once loading starts

      function setLabels(mode) {
        var tui = mode === "tui", email = mode === "email";
        if (btn) btn.setAttribute("aria-pressed", tui ? "true" : "false");
        if (label) label.textContent = tui ? "Reader view" : "TUI view";
        if (emailBtn) emailBtn.setAttribute("aria-pressed", email ? "true" : "false");
        if (emailLabel) emailLabel.textContent = email ? "Reader view" : "Email view";
      }

      function currentSlug() {
        // /papers/:slug OR /w/:ws/p/:proj/papers/:slug
        var m = location.pathname.match(/\/papers\/([^\/?#]+)/);
        return m ? decodeURIComponent(m[1]) : null;
      }

      function loadScript(src) {
        return new Promise(function (res, rej) {
          var s = document.createElement("script");
          s.src = src; s.onload = res; s.onerror = rej;
          document.head.appendChild(s);
        });
      }

      // Lazy-load wasm_exec.js + the gzipped wasm, decompress, instantiate. The Go
      // main sets window.bpRenderTUI then blocks (select{}), so we DON'T await
      // go.run — we poll for the export.
      function ensureWasm() {
        if (wasmReady) return wasmReady;
        wasmReady = (async function () {
          await loadScript("/assets/bp-wasm-exec.js");
          var go = new Go();
          var resp = await fetch("/assets/bp-pdrender.wasm.gz");
          var buf;
          if (typeof DecompressionStream !== "undefined") {
            var ds = new DecompressionStream("gzip");
            buf = await new Response(resp.body.pipeThrough(ds)).arrayBuffer();
          } else {
            buf = await resp.arrayBuffer(); // server may already decode gzip
          }
          var result = await WebAssembly.instantiate(buf, go.importObject);
          go.run(result.instance);
          // wait for the exported function to appear
          for (var i = 0; i < 200 && typeof window.bpRenderTUI !== "function"; i++) {
            await new Promise(function (r) { setTimeout(r, 10); });
          }
          if (typeof window.bpRenderTUI !== "function") throw new Error("wasm export missing");
        })();
        return wasmReady;
      }

      async function fetchBlocks(slug) {
        // resolve=tasks: the API resolve seam (p-resolve-seam) — without it the
        // wasm renders raw `query` blocks as "[task-list — unresolved]" while
        // the article view shows live tasks (tui-task-widget-resolution-parity).
        var url = "/v1/data/query/production/paper?resolve=tasks&filter=" +
          encodeURIComponent('slug=="' + slug + '"');
        var r = await fetch(url, { headers: { accept: "application/json" } });
        var d = await r.json();
        var docs = (d.result && d.result.documents) || [];
        var doc = docs[0];
        if (!doc) return null;
        return (doc.blocks) || (doc.content && doc.content.blocks) || null;
      }

      // A FIXED terminal width — the render is always this many columns, regardless
      // of screen size (a real terminal has a stable column grid). 80 is THE
      // classic terminal width, and 80 cols of 14px monospace fit exactly inside
      // the 720px window (#bp-terminal width — the reader column's max-width, so
      // Reader and TUI occupy the identical measure). Keep in lockstep.
      var TUI_COLS = 80;

      async function renderTUI() {
        if (!out) return;
        var slug = currentSlug();
        // pin the CSS grid width + the "$ bp paper view <slug>" prompt line
        document.documentElement.style.setProperty("--bp-cols", TUI_COLS);
        if (slug) out.setAttribute("data-slug", slug);
        out.innerHTML = '<div class="bp-tui-loading">rendering…</div>';
        try {
          if (!slug) throw new Error("no paper slug in the URL");
          var blocksP = fetchBlocks(slug);
          await ensureWasm();
          var blocks = await blocksP;
          if (!blocks) throw new Error("could not load this paper's blocks");
          var html = window.bpRenderTUI(JSON.stringify(blocks), TUI_COLS, "dark");
          out.innerHTML = html;
        } catch (e) {
          out.innerHTML = '<pre class="bp-tui-pre">TUI render failed: ' +
            String(e && e.message || e).replace(/[<>&]/g, "") + "</pre>";
        }
      }

      // ── Email view: mount the mail-client window once, on first activation.
      // The message body is the LITERAL /papers/:slug/email response in an
      // iframe (same-origin, so we can auto-fit its height) — the exact bytes
      // a mail backend sends, not a re-render.
      var mailMounted = false;
      function mountMail() {
        var app = document.getElementById("bp-mailapp");
        if (!app || mailMounted) return;
        mailMounted = true;
        var h1 = document.querySelector(".bp-paper-article h1");
        var subject = (h1 && h1.textContent.trim()) ||
          (document.title || "").replace(/\s*[·|–—].*$/, "").trim() || "Paper";
        var subjEl = document.getElementById("bp-mail-subject");
        if (subjEl) subjEl.textContent = subject;
        // received stamp, formatted like an inbox
        var now = new Date();
        var dateEl = document.getElementById("bp-mail-date");
        if (dateEl) {
          dateEl.textContent =
            now.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "numeric" }) +
            ", " +
            now.toLocaleTimeString(undefined, { hour: "2-digit", minute: "2-digit" }) +
            " (just now)";
        }
        var raw = location.pathname.replace(/\/+$/, "") + "/email";
        var replyEl = document.getElementById("bp-mail-reply");
        if (replyEl) replyEl.href = "mailto:papers@barkpark.cloud?subject=" + encodeURIComponent("Re: " + subject);
        var fwdEl = document.getElementById("bp-mail-forward");
        if (fwdEl) fwdEl.href = "mailto:?subject=" + encodeURIComponent("Fwd: " + subject) +
          "&body=" + encodeURIComponent(location.origin + raw);
        var browserEl = document.getElementById("bp-mail-browser");
        if (browserEl) browserEl.href = raw;
        var frame = document.getElementById("bp-mail-frame");
        if (frame) {
          var fit = function () {
            try {
              var d = frame.contentDocument;
              if (d) frame.style.height = Math.max(320, d.documentElement.scrollHeight) + "px";
            } catch (e) {}
          };
          frame.addEventListener("load", function () {
            fit(); setTimeout(fit, 400); setTimeout(fit, 1500); // late images/fonts
          });
          window.addEventListener("resize", fit);
          frame.src = raw;
        }
        // the unread dot + Inbox (1) settle once the message has been "read"
        setTimeout(function () { app.classList.add("bp-mail-read"); }, 1400);
      }

      // toolbar: back/archive/trash all file the mail away (return to reader);
      // the star is a local nicety
      document.querySelectorAll("#bp-mailapp [data-mail-exit]").forEach(function (b) {
        b.addEventListener("click", function () { setMode("reader"); });
      });
      var star = document.getElementById("bp-mail-star");
      if (star) star.addEventListener("click", function () {
        star.setAttribute("aria-pressed", star.getAttribute("aria-pressed") === "true" ? "false" : "true");
      });

      function apply(mode, doRender) {
        var tui = mode === "tui", email = mode === "email";
        document.body.classList.toggle("bp-tui", tui);
        document.body.classList.toggle("bp-email", email);
        setLabels(mode);
        if (tui && doRender) renderTUI();
        if (email && doRender) mountMail();
      }

      function setMode(next) {
        apply(next, true);
        try { localStorage.setItem(KEY, next); } catch (e) {}
      }

      // restore persisted choice (render if it was an alternate view)
      try {
        var saved = localStorage.getItem(KEY);
        apply(saved === "tui" ? "tui" : saved === "email" ? "email" : "reader", true);
      } catch (e) { apply("reader", false); }

      window.__bpToggleTui = function () {
        setMode(document.body.classList.contains("bp-tui") ? "reader" : "tui");
      };
      window.__bpToggleEmail = function () {
        setMode(document.body.classList.contains("bp-email") ? "reader" : "email");
      };
    })();
  </script>

  <%!-- Mermaid engine for `diagram` blocks. Loaded `defer` (NEVER a blocking
        <script> in <head> — golden rule). startOnLoad:false: the PaperMermaid
        hook runs it manually so it works with LiveView's streamed DOM, where
        diagram <pre> elements arrive AFTER the initial parse. --%>
  <script defer src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
  <%!-- asciinema-player engine for `asciicast` blocks. Same `defer` discipline
        as mermaid (NEVER blocking in <head>); the PaperMermaid hook's
        runAsciicast() mounts a player per `div.bp-asciicast`, with the same
        deferred-load retry guard. Pinned to 3.8.0 (proven CDN/version). --%>
  <script defer src="https://cdn.jsdelivr.net/npm/asciinema-player@3.8.0/dist/bundle/asciinema-player.min.js"></script>
  <script src="/assets/phoenix.js"></script>
  <script src="/assets/phoenix_live_view.js"></script>
  <script>
    // PaperMermaid: run Mermaid over any unprocessed `pre.mermaid` inside this
    // hook's element. Registered on the streamed <article>, so its mounted()
    // fires once and updated() fires on every stream delta — exactly when a new
    // `diagram` block's <pre class="mermaid"> enters the DOM. Guarded for the
    // case where mermaid.min.js (deferred) hasn't loaded yet: we retry on the
    // script's load event.
    let PaperHooks = {
      PaperMermaid: {
        runMermaid() {
          let nodes = Array.from(
            this.el.querySelectorAll('pre.mermaid:not([data-processed="true"])')
          );
          if (!nodes.length) return;
          // Stash the raw source before the first run — mermaid replaces the
          // <pre>'s text with the SVG, and the scheme-change re-render below
          // needs the original source to re-run under the other palette.
          nodes.forEach((n) => {
            if (n.dataset.bpSrc == null) n.dataset.bpSrc = n.textContent;
          });
          if (window.mermaid && window.mermaid.run) {
            window.mermaid.run({ nodes });
          } else {
            // mermaid.min.js still deferred-loading — retry once it's ready.
            window.addEventListener("load", () => {
              if (window.mermaid && window.mermaid.run) {
                window.mermaid.run({
                  nodes: Array.from(
                    this.el.querySelectorAll('pre.mermaid:not([data-processed="true"])')
                  )
                });
              }
            }, { once: true });
          }
        },
        // runAsciicast: mount an asciinema player over any unprocessed
        // `div.bp-asciicast` inside this hook's element. Mirrors runMermaid:
        // registered on the streamed <article>, runs on mounted() + every
        // updated() delta — exactly when a new `asciicast` block's mount point
        // enters the DOM. Guarded for asciinema-player.min.js (deferred) not
        // being ready yet: we retry on window load.
        runAsciicast() {
          let mountPlayer = (el) => {
            let src = el.dataset.castSrc;
            if (!src) return;
            window.AsciinemaPlayer.create(src, el, {
              fit: "width",
              poster: "npt:0:1",
              idleTimeLimit: 2,
              theme: "asciinema"
            });
            el.dataset.asciicastDone = "true";
          };
          let nodes = Array.from(
            this.el.querySelectorAll('div.bp-asciicast:not([data-asciicast-done="true"])')
          );
          if (!nodes.length) return;
          if (window.AsciinemaPlayer && window.AsciinemaPlayer.create) {
            nodes.forEach(mountPlayer);
          } else {
            // asciinema-player.min.js still deferred-loading — retry once ready.
            window.addEventListener("load", () => {
              if (window.AsciinemaPlayer && window.AsciinemaPlayer.create) {
                Array.from(
                  this.el.querySelectorAll('div.bp-asciicast:not([data-asciicast-done="true"])')
                ).forEach(mountPlayer);
              }
            }, { once: true });
          }
        },
        mounted() { this.runMermaid(); this.runAsciicast(); },
        updated() { this.runMermaid(); this.runAsciicast(); }
      },

      // P6.U3 RailDiffSelect: shift-click two rail event rows to open a
      // line-diff of their payloads. A SHIFT+click marks a row (up to two:
      // .is-diff-a then .is-diff-b); the second shift+click pushes
      // "open-diff" {from, to} and clears the selection. A PLAIN click is left
      // entirely alone so the row's own phx-click="rail-select" still fires —
      // we only act (and only preventDefault) when the shift key is held.
      // Guarded for the no-document/SSR case the file already assumes.
      RailDiffSelect: {
        mounted() {
          if (typeof document === "undefined" || !this.el) return;
          this.selected = [];
          this.onClick = (e) => {
            if (!e.shiftKey) return; // plain click → rail-select unaffected
            let row = e.target.closest("[phx-value-event-id]");
            if (!row || !this.el.contains(row)) return;
            let id = row.getAttribute("phx-value-event-id");
            if (!id) return;
            // Shift+click is a diff-pick, not a select: swallow the event so it
            // doesn't also trigger the row's rail-select.
            e.preventDefault();
            e.stopPropagation();
            if (this.selected.length === 0) {
              this.clearMarks();
              row.classList.add("is-diff-a");
              this.selected = [id];
            } else if (this.selected.length === 1) {
              if (id === this.selected[0]) return; // same row twice → ignore
              row.classList.add("is-diff-b");
              this.pushEvent("open-diff", { from: this.selected[0], to: id });
              this.selected = [];
              this.clearMarks();
            }
          };
          // Capture phase so we intercept the shift+click before the row's own
          // phx-click handler runs.
          this.el.addEventListener("click", this.onClick, true);
        },
        clearMarks() {
          this.el.querySelectorAll(".is-diff-a, .is-diff-b").forEach((n) => {
            n.classList.remove("is-diff-a", "is-diff-b");
          });
        },
        destroyed() {
          if (this.el && this.onClick) {
            this.el.removeEventListener("click", this.onClick, true);
          }
        }
      }
    };

    // Initialise the engine in manual mode (startOnLoad:false). Wrapped so it's
    // a no-op if the deferred script isn't present yet — the hook re-checks.
    //
    // THEME (gui-premium w1): mermaid's stock "default" theme is off-palette
    // (trebuchet + pastel blue). We drive theme:"base" with themeVariables
    // derived from the reader's `--paper-*` evergreen palette (the same values
    // the CSS above sets for light and prefers-color-scheme dark), and label
    // in the reader's mono — the diagrams read as kin to the TUI's box-art.
    // The values are literals (not read from CSS vars) because mermaid bakes
    // colors into the SVG at render time; the scheme listener below re-renders
    // from the stashed source when the OS palette flips.
    function mermaidThemeVariables(dark) {
      const mono =
        "'SF Mono', ui-monospace, 'JetBrains Mono', Menlo, Consolas, monospace";
      if (dark) {
        return {
          fontFamily: mono, fontSize: "14px",
          background: "#0e1614", mainBkg: "#131d19",
          primaryColor: "#131d19", primaryTextColor: "#e7ede9",
          primaryBorderColor: "#45b394", nodeBorder: "#45b394",
          lineColor: "#9aaaa3", textColor: "#e7ede9", titleColor: "#e7ede9",
          secondaryColor: "#1a2b25", tertiaryColor: "#131d19",
          clusterBkg: "#0e1614", clusterBorder: "rgba(231,237,233,0.2)",
          edgeLabelBackground: "#0e1614",
          actorBkg: "#131d19", actorBorder: "#45b394",
          actorTextColor: "#e7ede9", actorLineColor: "#6c7a74",
          signalColor: "#9aaaa3", signalTextColor: "#e7ede9",
          labelBoxBkgColor: "#131d19", labelBoxBorderColor: "#45b394",
          labelTextColor: "#e7ede9", loopTextColor: "#e7ede9",
          noteBkgColor: "#1c2620", noteBorderColor: "#6c7a74",
          noteTextColor: "#e7ede9"
        };
      }
      return {
        fontFamily: mono, fontSize: "14px",
        background: "#f6faf9", mainBkg: "#eaf1ee",
        primaryColor: "#eaf1ee", primaryTextColor: "#15211d",
        primaryBorderColor: "#1e5347", nodeBorder: "#1e5347",
        lineColor: "#55635e", textColor: "#15211d", titleColor: "#15211d",
        secondaryColor: "#d7e8e1", tertiaryColor: "#f6faf9",
        clusterBkg: "#f6faf9", clusterBorder: "#dde7e2",
        edgeLabelBackground: "#f6faf9",
        actorBkg: "#eaf1ee", actorBorder: "#1e5347",
        actorTextColor: "#15211d", actorLineColor: "#82918b",
        signalColor: "#55635e", signalTextColor: "#15211d",
        labelBoxBkgColor: "#eaf1ee", labelBoxBorderColor: "#1e5347",
        labelTextColor: "#15211d", loopTextColor: "#15211d",
        noteBkgColor: "#e6f0eb", noteBorderColor: "#82918b",
        noteTextColor: "#15211d"
      };
    }
    const mermaidScheme = window.matchMedia("(prefers-color-scheme: dark)");
    function initMermaid() {
      if (window.mermaid && window.mermaid.initialize) {
        window.mermaid.initialize({
          startOnLoad: false,
          theme: "base",
          themeVariables: mermaidThemeVariables(mermaidScheme.matches),
          flowchart: { useMaxWidth: true },
          sequence: { useMaxWidth: true }
        });
      }
    }
    if (document.readyState === "complete") initMermaid();
    else window.addEventListener("load", initMermaid, { once: true });
    // Re-render every diagram from its stashed source when the OS scheme
    // flips — mermaid bakes the palette into the SVG, so a live flip would
    // otherwise strand light diagrams on a dark page (and vice versa).
    mermaidScheme.addEventListener("change", () => {
      initMermaid();
      document.querySelectorAll("pre.mermaid[data-processed]").forEach((pre) => {
        if (pre.dataset.bpSrc != null) {
          pre.textContent = pre.dataset.bpSrc;
          pre.removeAttribute("data-processed");
        }
      });
      if (window.mermaid && window.mermaid.run) {
        window.mermaid.run({
          nodes: Array.from(
            document.querySelectorAll('pre.mermaid:not([data-processed="true"])')
          )
        });
      }
    });

    let csrfToken = document.querySelector("meta[name='csrf-token']").getAttribute("content");
    let liveSocket = new LiveView.LiveSocket("/live", Phoenix.Socket, {
      params: { _csrf_token: csrfToken },
      hooks: PaperHooks
    });
    liveSocket.connect();
    // Expose for hooks / debugging (Wave 4 block-streaming).
    window.liveSocket = liveSocket;
  </script>
</body>
</html>
