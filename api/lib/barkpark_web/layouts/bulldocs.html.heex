    @media (prefers-color-scheme: dark) {
      html[data-bp-theme="iris"] body:has(.bp-paper-article),
      html[data-bp-theme="iris"] body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
        --paper-bg: #09080e;
        --paper-bg-deep: #121219;
        --paper-ink: #dedee5;
        --paper-ink-soft: #9e9ea6;
        --paper-rule: rgba(222, 222, 229, 0.13);
        --paper-accent: #9d8cff;
        --paper-accent-soft: rgba(157, 140, 255, 0.16);
        --paper-reading-accent: #8cc8ff;
        --paper-ink-faint: #6c6c72;
        --paper-chrome-bg: #121219;
        --paper-chrome-border: rgba(222, 222, 229, 0.13);
        --bp-tone-info-bg: #010828; --bp-tone-info-fg: #a4bef1;
        --bp-tone-success-bg: #001103; --bp-tone-success-fg: #9acca4;
        --bp-tone-warning-bg: #140a00; --bp-tone-warning-fg: #dcb785;
        --bp-tone-danger-bg: #210001; --bp-tone-danger-fg: #ecaba3;
        --bp-tone-neutral-bg: #0c0c0e; --bp-tone-neutral-fg: #bdbdc0;
      }
    }
    html[data-bp-theme="iris"] #bp-mailapp {
      --mail-paper: #ffffff; --mail-bar: #f9fafe; --mail-rule: #dddee2;
      --mail-ink: #1f1f2a; --mail-soft: #51525b; --mail-accent: #5b46d6;
    }
    @media (prefers-color-scheme: dark) {
      html[data-bp-theme="iris"] #bp-mailapp {
        --mail-paper: #121219; --mail-bar: #09080e; --mail-rule: #343339;
        --mail-ink: #dedee5; --mail-soft: #9e9ea6; --mail-accent: #9d8cff;
      }
    }
    html[data-bp-theme="iris"][data-theme="light"] body:has(.bp-paper-article),
    html[data-bp-theme="iris"][data-theme="light"] body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
      --paper-bg: #f9fafe;
      --paper-bg-deep: #ecedf5;
      --paper-ink: #1f1f2a;
      --paper-ink-soft: #51525b;
      --paper-rule: #dddee2;
      --paper-accent: #5b46d6;
      --paper-accent-soft: rgba(91, 70, 214, 0.10);
      --paper-reading-accent: #3692e6;
      --paper-ink-faint: #7a7b83;
      --paper-chrome-bg: #f9fafe;
      --paper-chrome-border: rgba(31, 31, 42, 0.12);
      --bp-tone-info-bg: #e7efff; --bp-tone-info-fg: #335296;
      --bp-tone-success-bg: #daf8df; --bp-tone-success-fg: #0f662f;
      --bp-tone-warning-bg: #ffecd2; --bp-tone-warning-fg: #734c00;
      --bp-tone-danger-bg: #ffe9e6; --bp-tone-danger-fg: #8b3630;
      --bp-tone-neutral-bg: #eeeff0; --bp-tone-neutral-fg: #555558;
    }
    html[data-bp-theme="iris"][data-theme="dark"] body:has(.bp-paper-article),
    html[data-bp-theme="iris"][data-theme="dark"] body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
      --paper-bg: #09080e;
      --paper-bg-deep: #121219;
      --paper-ink: #dedee5;
      --paper-ink-soft: #9e9ea6;
      --paper-rule: rgba(222, 222, 229, 0.13);
      --paper-accent: #9d8cff;
      --paper-accent-soft: rgba(157, 140, 255, 0.16);
      --paper-reading-accent: #8cc8ff;
      --paper-ink-faint: #6c6c72;
      --paper-chrome-bg: #121219;
      --paper-chrome-border: rgba(222, 222, 229, 0.13);
      --bp-tone-info-bg: #010828; --bp-tone-info-fg: #a4bef1;
      --bp-tone-success-bg: #001103; --bp-tone-success-fg: #9acca4;
      --bp-tone-warning-bg: #140a00; --bp-tone-warning-fg: #dcb785;
      --bp-tone-danger-bg: #210001; --bp-tone-danger-fg: #ecaba3;
      --bp-tone-neutral-bg: #0c0c0e; --bp-tone-neutral-fg: #bdbdc0;
    }
    html[data-bp-theme="iris"][data-theme="light"] #bp-mailapp {
      --mail-paper: #ffffff; --mail-bar: #f9fafe; --mail-rule: #dddee2;
      --mail-ink: #1f1f2a; --mail-soft: #51525b; --mail-accent: #5b46d6;
    }
    html[data-bp-theme="iris"][data-theme="dark"] #bp-mailapp {
      --mail-paper: #121219; --mail-bar: #09080e; --mail-rule: #343339;
      --mail-ink: #dedee5; --mail-soft: #9e9ea6; --mail-accent: #9d8cff;
    }
    /* PRINT: the LIGHT palette, re-stamped from the same token data as the
       light blocks above — paged output is ink on white whatever the screen
       scheme or the stamped [data-theme] was. See printRestamp in
       design/emit.mjs; the white ground + chrome hiding stay in the hand
       region's @media print block further down this sheet. */
    @media print {
      html[data-bp-theme="iris"] body:has(.bp-paper-article),
      html[data-bp-theme="iris"] body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article,
      html[data-bp-theme="iris"][data-theme] body:has(.bp-paper-article),
      html[data-bp-theme="iris"][data-theme] body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
        --paper-bg: #f9fafe;
        --paper-bg-deep: #ecedf5;
        --paper-ink: #1f1f2a;
        --paper-ink-soft: #51525b;
        --paper-rule: #dddee2;
        --paper-accent: #5b46d6;
        --paper-accent-soft: rgba(91, 70, 214, 0.10);
        --paper-reading-accent: #3692e6;
        --paper-ink-faint: #7a7b83;
        --paper-chrome-bg: #f9fafe;
        --paper-chrome-border: rgba(31, 31, 42, 0.12);
        --bp-tone-info-bg: #e7efff; --bp-tone-info-fg: #335296;
        --bp-tone-success-bg: #daf8df; --bp-tone-success-fg: #0f662f;
        --bp-tone-warning-bg: #ffecd2; --bp-tone-warning-fg: #734c00;
        --bp-tone-danger-bg: #ffe9e6; --bp-tone-danger-fg: #8b3630;
        --bp-tone-neutral-bg: #eeeff0; --bp-tone-neutral-fg: #555558;
      }
    }
    /* END GENERATED: tokens */
    <%!-- The article column. 660/40 = a 580px measure, matching the Studio
          `.bp-paper-surface` rule byte-for-byte so a line wraps at the same word
          on both (measure_parity_test pins the pair).

          `line-height` is GONE from this rule, and its absence is the fix, not
          an omission: it hardcoded 1.65 at a specificity (0,2,0) that outranked
          the shared `.bp-paper-surface` rule, so the reader's leading could not
          follow `--bp-body-lh` even once the shared sheet started declaring it.
          The reader now takes size, leading, tracking and font-features from the
          one source like every other paper surface. --%>
    .bp-paper-shell.bp-paper-article {
      --paper-gutter: 40px;
      max-width: 660px;
      padding: 56px var(--paper-gutter) 96px;
      /* Client evidence needs more stage than prose. Keep the shared reading
         measure untouched while letting paired screenshots use the viewport. */
      --bp-evidence-band: 1180px;
      --bp-evidence-band-max: 1360px;
      --bp-evidence-fill: 0.74;
    }

    /* Recording links are supporting evidence, not a stack of form controls.
       Consecutive action blocks therefore read as a loose clip rail: compact,
       rounded, and able to wrap naturally without the old touching boxes. */
    .bp-paper-article [data-block-id*="-clip-"]:has(> .bp-button) {
      display: inline-block;
      max-width: 100%;
      margin: 0.42rem 1.1rem 0.42rem 0;
      vertical-align: top;
    }
    .bp-paper-article [data-block-id*="-clip-"]:has(> .bp-button) > .bp-button {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      max-width: 100%;
      min-height: 44px;
      padding: 0.35rem 0;
      border: 0;
      border-radius: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 0.82rem;
      line-height: 1.25;
      font-weight: 600;
      letter-spacing: 0.005em;
      box-sizing: border-box;
      transition: color 140ms ease, transform 140ms ease;
    }
    .bp-paper-article [data-block-id*="-clip-"]:has(> .bp-button) > .bp-button::before {
      content: "▶";
      flex: none;
      display: inline-grid;
      place-items: center;
      width: 1.85rem;
      height: 1.85rem;
      border: 1px solid color-mix(in srgb, var(--paper-accent) 48%, transparent);
      border-radius: 50%;
      font-size: 0.56em;
      text-indent: 0.12em;
      transition: background 140ms ease, border-color 140ms ease;
    }
    .bp-paper-article [data-block-id*="-clip-"]:has(> .bp-button) > .bp-button:hover {
      transform: translateY(-1px);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
    .bp-paper-article [data-block-id*="-clip-"]:has(> .bp-button) > .bp-button:hover::before {
      background: var(--paper-accent-soft);
      border-color: var(--paper-accent);
    }

    .bp-paper-article figure > .bp-cols { gap: clamp(2rem, 3vw, 2.8rem); }
    .bp-paper-article figure > .bp-cols img {
      display: block;
      width: auto;
      max-width: 100%;
      height: auto;
      max-height: min(72vh, 760px);
      margin-inline: auto;
      object-fit: contain;
      object-position: top center;
    }

    /* Each decision starts on a fresh editorial beat. The rule is deliberately
       quiet: it gives long client reviews structure without turning sections
       into another set of bordered cards. */
    .bp-paper-article #paper-body > [data-block-id]:has(> h3) {
      margin-top: clamp(3.75rem, 8vw, 6.5rem);
      padding-top: clamp(1.2rem, 2.4vw, 1.8rem);
      border-top: 1px solid color-mix(in srgb, var(--paper-rule) 78%, transparent);
    }
    .bp-paper-article #paper-body > [data-block-id]:has(> h3) > h3 {
      margin-top: 0;
      text-wrap: balance;
    }
    /* Authored chapter maps use ordinary Paper cards, then the reader binds
       numbered cards to their matching numbered h2. Only cards with a real
       target gain link chrome, so a decorative card never becomes a dead
       affordance. */
    .bp-paper-article .bp-card[data-bp-chapter-target] {
      position: relative;
      cursor: pointer;
      padding-right: 3rem;
      transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
    }
    .bp-paper-article .bp-card[data-bp-chapter-target]::after {
      content: "↓";
      position: absolute;
      right: 1.1rem;
      top: 50%;
      translate: 0 -50%;
      color: var(--paper-accent);
      font: 600 1rem/1 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .bp-paper-article .bp-card[data-bp-chapter-target]:hover {
      border-color: color-mix(in srgb, var(--paper-accent) 48%, var(--paper-rule));
      background: color-mix(in srgb, var(--paper-accent-soft) 52%, var(--paper-bg-deep));
      transform: translateY(-1px);
    }
    .bp-paper-article .bp-card[data-bp-chapter-target]:focus-visible {
      outline: 3px solid var(--paper-accent);
      outline-offset: 3px;
    }
    .bp-paper-article [data-bp-chapter-anchor] { scroll-margin-top: 1.5rem; }

    /* Paper-image lightbox. Trigger styling lives in paper-surface.css; this
       reader shell owns only the modal chrome and interaction. */
    .bp-image-lightbox {
      color-scheme: dark;
      width: 100vw;
      max-width: none;
      height: 100vh;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      overflow: hidden;
    }
    .bp-image-lightbox::backdrop { background: color-mix(in srgb, Canvas 88%, transparent); }
    .bp-image-lightbox__stage {
      width: 100%;
      height: 100%;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: 0.85rem;
      box-sizing: border-box;
      padding: max(0.85rem, env(safe-area-inset-top)) clamp(0.75rem, 3vw, 2rem) max(0.85rem, env(safe-area-inset-bottom));
    }
    .bp-image-lightbox__toolbar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      min-height: 2.65rem;
      padding-inline: 3.25rem;
      font: 600 0.76rem/1 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .bp-image-lightbox__mode {
      min-height: 2.35rem;
      padding: 0.55rem 0.8rem;
      border: 1px solid color-mix(in srgb, CanvasText 28%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, Canvas 74%, transparent);
      color: CanvasText;
      cursor: pointer;
    }
    .bp-image-lightbox__mode[aria-pressed="true"] {
      border-color: color-mix(in srgb, CanvasText 72%, transparent);
      background: color-mix(in srgb, CanvasText 16%, Canvas);
    }
    .bp-image-lightbox__mode:focus-visible {
      outline: 2px solid CanvasText;
      outline-offset: 2px;
    }
    .bp-image-lightbox__viewport {
      width: 100%;
      height: 100%;
      min-width: 0;
      min-height: 0;
      overflow: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-gutter: stable both-edges;
      border: 1px solid color-mix(in srgb, CanvasText 18%, transparent);
      border-radius: 8px;
      background:
        linear-gradient(45deg, color-mix(in srgb, CanvasText 4%, transparent) 25%, transparent 25%) 0 0 / 20px 20px,
        linear-gradient(45deg, transparent 75%, color-mix(in srgb, CanvasText 4%, transparent) 75%) 0 0 / 20px 20px,
        Canvas;
      cursor: grab;
    }
    .bp-image-lightbox__viewport.is-panning { cursor: grabbing; }
    .bp-image-lightbox__canvas {
      min-width: 100%;
      min-height: 100%;
      display: flex;
      align-items: flex-start;
      justify-content: flex-start;
      box-sizing: border-box;
      padding: clamp(0.65rem, 2vw, 1.25rem);
    }
    .bp-image-lightbox__image {
      display: block;
      width: auto;
      height: auto;
      max-width: none;
      max-height: none;
      margin: auto;
      border-radius: 6px;
      box-shadow: 0 24px 80px color-mix(in srgb, Canvas 46%, transparent);
      user-select: none;
      -webkit-user-drag: none;
    }
    .bp-image-lightbox[data-view="fit"] .bp-image-lightbox__canvas {
      height: 100%;
      align-items: center;
      justify-content: center;
    }
    .bp-image-lightbox[data-view="fit"] .bp-image-lightbox__image {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
    .bp-image-lightbox__caption {
      max-width: 76ch;
      margin: 0 auto;
      color: color-mix(in srgb, CanvasText 82%, transparent);
      font: 500 0.82rem/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      text-align: center;
    }
    .bp-image-lightbox__caption:empty { display: none; }
    .bp-image-lightbox__close {
      position: fixed;
      top: max(1rem, env(safe-area-inset-top));
      right: max(1rem, env(safe-area-inset-right));
      z-index: 1;
      width: 2.65rem;
      height: 2.65rem;
      border: 1px solid color-mix(in srgb, CanvasText 32%, transparent);
      border-radius: 50%;
      background: color-mix(in srgb, Canvas 72%, transparent);
      color: CanvasText;
      font-size: 1.45rem;
      line-height: 1;
      cursor: pointer;
      backdrop-filter: blur(12px);
    }
    .bp-image-lightbox__close:hover { background: color-mix(in srgb, CanvasText 14%, transparent); }
    .bp-image-lightbox__close:focus-visible { outline: 2px solid CanvasText; outline-offset: 3px; }
    @media (max-width: 720px) {
      .bp-image-lightbox__stage { gap: 0.6rem; }
      .bp-image-lightbox__toolbar {
        justify-content: flex-start;
        padding-inline: 0;
        padding-right: 3.25rem;
      }
      .bp-image-lightbox__caption { font-size: 0.74rem; }
    }

    <%!-- THE GUTTER LADDER — 40 / 24 / 16 at 767 / 479, THE SAME STEPS AND THE
          SAME BREAKPOINTS as the Studio's `.bp-paper-surface`
          (root.html.heex). They were 40 -> 24 at 720 here and 40/24/16 at
          767/479 there, and below 720 a later rule pushed this shell's
          `padding-inline` to 20px while the Studio's was 24 or 16. Two shells
          that share one `.bp-paper-surface` type scale but pad differently
          wrap a line at a DIFFERENT WORD in View than in Edit, which is the
          one thing the parity work exists to prevent.

          The 16px step is also what buys the narrow measure back: 390 - 2*16 =
          a 358px column, 42 characters per line, inside the 40-46 the reader
          is designed to. At 20px it was 350px and 41; at the 24px this file
          used to stop at, 342px and 40.

          Each step REDECLARES the token and CONSUMES it — the invariant
          measure_parity_test.exs pins on both shells now, in both directions:
          redeclare without consuming and the padding is stale, consume without
          redeclaring and the ladder has a rung that renders the wrong gutter. --%>
    @media (max-width: 767px) {
      .bp-paper-shell.bp-paper-article {
        --paper-gutter: 24px;
        max-width: 100%;
        padding: 36px var(--paper-gutter) 72px;
      }
    }
    @media (max-width: 479px) {
      .bp-paper-shell.bp-paper-article {
        --paper-gutter: 16px;
        padding: 32px var(--paper-gutter) 72px;
      }
    }

    /* pdd-t19 → parity: the article stream's VERTICAL RHYTHM now lives in the
       SHARED `.bp-paper-surface hN` rules (top-only margins, parity-gated with
       the edit canvas), so the reader and the editor breathe IDENTICALLY. The
       reader keeps only the first-child clamp — the div-per-block wrapping means
       the first heading's top margin must be zeroed here (the shared
       `> :first-child` clamp sees the wrapper div, not the heading inside it). */
    .bp-paper-article [data-block-id]:first-child h1,
    .bp-paper-article [data-block-id]:first-child h2,
    .bp-paper-article [data-block-id]:first-child h3 { margin-top: 0; }

    /* Graph-backed related Papers. Flat editorial cards keep the article's
       quiet hierarchy while making each relationship feel like a real object,
       not a bare backlink. The LiveView swaps this section after projection. */
    .bp-paper-shell .bp-paper-connections {
      margin-top: 4.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--paper-rule);
    }
    .bp-paper-shell .bp-paper-connections + .bp-paper-connections {
      margin-top: 2.5rem;
    }
    .bp-paper-shell .bp-paper-connections-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1.5rem;
      margin-bottom: 1.25rem;
    }
    .bp-paper-shell .bp-paper-connections-kicker {
      margin: 0 0 0.35rem;
      color: var(--paper-accent);
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }
    .bp-paper-shell .bp-paper-connections-head h2 {
      margin: 0;
      color: var(--paper-ink);
      font-size: 1.45rem;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }
    .bp-paper-shell .bp-paper-connections-head h2 + p {
      max-width: 32rem;
      margin: 0.4rem 0 0;
      color: var(--paper-ink-soft);
      font-size: 0.88rem;
      line-height: 1.5;
    }
    .bp-paper-shell .bp-paper-live {
      display: inline-flex;
      flex: none;
      align-items: center;
      gap: 0.4rem;
      margin-top: 0.2rem;
      color: var(--paper-ink-soft);
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 0.68rem;
      font-weight: 650;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .bp-paper-shell .bp-paper-live i {
      width: 0.42rem;
      height: 0.42rem;
      border-radius: 50%;
      background: var(--paper-accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--paper-accent) 14%, transparent);
    }
    .bp-paper-shell .bp-paper-card-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .bp-paper-shell .bp-paper-card {
      display: flex;
      min-width: 0;
      min-height: 10.5rem;
      flex-direction: column;
      padding: 1rem;
      border: 1px solid var(--paper-rule);
      border-radius: 0;
      background: color-mix(in srgb, var(--paper-bg) 84%, transparent);
      color: var(--paper-ink);
      text-decoration: none;
      transition: border-color 150ms ease, background-color 150ms ease, transform 150ms ease;
    }
    .bp-paper-shell .bp-paper-card:hover {
      border-color: color-mix(in srgb, var(--paper-accent) 52%, var(--paper-rule));
      background: var(--paper-bg);
      transform: translateY(-2px);
    }
    .bp-paper-shell .bp-paper-card:focus-visible {
      outline: 2px solid var(--paper-accent);
      outline-offset: 3px;
    }
    .bp-paper-shell .bp-paper-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.1rem;
    }
    .bp-paper-shell .bp-paper-card-badge,
    .bp-paper-shell .bp-paper-card-meta {
      color: var(--paper-ink-soft);
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 0.67rem;
      letter-spacing: 0.075em;
      text-transform: uppercase;
    }
    .bp-paper-shell .bp-paper-card-arrow {
      color: var(--paper-accent);
      font-size: 1rem;
      transition: transform 150ms ease;
    }
    .bp-paper-shell .bp-paper-card:hover .bp-paper-card-arrow { transform: translate(2px, -2px); }
    .bp-paper-shell .bp-paper-card strong {
      display: block;
      color: var(--paper-ink);
      font-family: ui-serif, Georgia, serif;
      font-size: 1.05rem;
      line-height: 1.28;
    }
    .bp-paper-shell .bp-paper-card-summary {
      display: -webkit-box;
      overflow: hidden;
      margin-top: 0.45rem;
      color: var(--paper-ink-soft);
      font-size: 0.79rem;
      line-height: 1.45;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
    .bp-paper-shell .bp-paper-card-meta { margin-top: auto; padding-top: 1rem; }
    @media (max-width: 620px) {
      .bp-paper-shell .bp-paper-card-grid { grid-template-columns: 1fr; }
      .bp-paper-shell .bp-paper-connections-head { gap: 0.75rem; }
    }

    /* Native form block styles moved to the canonical paper-surface source
       (paper-surface.css §form/questionnaire, gui-premium w2) — the reader
       article carries .bp-paper-surface, so it resolves them from the shared
       sheet like every other component; a reader-local mirror here would
       fight it on specificity (the form-block-dark-mode lesson). */

    /* P6.U5 action bar — the paper doc action buttons (Create plan /
       Grill / Build / Submit) rendered natively on the paper. A restrained
       sticky row at the top of the article column, in the article palette
       (bp-theme surface, evergreen accent, sans label). Scoped under
       `.bp-paper-article` so non-article papers stay untouched. The bar is
       rendered only when BulldocsLive derived a non-empty action set from
       content["source_doc"]. */
    .bp-paper-article .bp-paper-actions {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem;
      margin: 0 0 1.75rem;
      padding: 0.75rem 0;
      background: var(--paper-bg);
      border-bottom: 1px solid var(--paper-rule);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .bp-paper-article .bp-paper-action {
      appearance: none;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: var(--paper-accent);
      background: var(--paper-bg);
      border: 1px solid var(--paper-rule);
      border-radius: 6px;
      padding: 0.45rem 0.9rem;
      transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
    }
    .bp-paper-article .bp-paper-action:hover {
      background: var(--paper-accent);
      color: var(--paper-bg);
      border-color: var(--paper-accent);
    }
    .bp-paper-article .bp-paper-action:focus-visible {
      outline: 2px solid var(--paper-accent);
      outline-offset: 2px;
    }
    .bp-paper-article .bp-paper-action-ack {
      font-size: 0.78rem;
      font-style: italic;
      color: var(--paper-ink-soft);
      margin-left: 0.25rem;
    }

    /* P6.U4 Simplify control — a small row rendered for any goal-bearing
       paper (independent of the U5 doc-type action set). Reuses the
       `.bp-paper-action` button palette; the Accept/Reject pair appears only
       once a simplify-request is pending. Accept reads as the affirmative
       (filled terracotta on hover, like the other actions); Reject is muted
       gray so the destructive choice doesn't shout. Scoped under
       `.bp-paper-article` so non-article papers stay untouched. */
    .bp-paper-article .bp-paper-simplify {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem;
      margin: 0 0 1.75rem;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .bp-paper-article .bp-paper-simplify-decide {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .bp-paper-article .bp-paper-action-reject {
      color: var(--paper-ink-soft);
      border-color: var(--paper-rule);
    }
    .bp-paper-article .bp-paper-action-reject:hover {
      background: var(--paper-ink-soft);
      color: var(--paper-bg);
      border-color: var(--paper-ink-soft);
    }

    /* P6.U2 goal-path rail — a 240px sticky right-rail showing the paper's
       goal lifecycle as a Mermaid gitGraph plus a clickable event list. Scoped
       under `.bp-paper-article` so non-article papers are untouched. The shell
       centers a 720px reading column; the rail floats to the right of that
       column (offset via a negative right margin) and sticks while scrolling.
       On narrow viewports it falls back to a normal in-flow block under the
       article. The <aside> is a child of <main>, sibling of the <article>. */
    .bp-paper-article .bp-goal-rail {
      width: 240px;
      margin: 2.5rem 0 0 auto;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    @media (min-width: 1100px) {
      .bp-paper-article .bp-goal-rail {
        position: sticky;
        top: 56px;
        float: right;
        margin: 0 -300px 1.5rem 1.5rem;
      }
    }
    .bp-paper-article .bp-goal-rail-title {
      margin: 0 0 0.75rem;
      /* `inherit` re-takes the rail's sans stack: the shared paper-surface
         `.bp-paper-surface h1..h6 { font-family: var(--paper-font-serif) }`
         rule hits this <h2> DIRECTLY and would beat the sans the rail
         container only passes down by inheritance. Same story for
         line-height (shared `h2 { line-height: 1.2 }` vs the shell's 1.65). */
      font-family: inherit;
      line-height: inherit;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--paper-accent);
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--paper-rule);
    }
    .bp-paper-article .bp-goal-rail #goal-path-graph {
      margin: 0 0 1rem;
    }
    .bp-paper-article .bp-goal-rail .mermaid {
      margin: 0;
      background: none;
      font-size: 0.8rem;
      /* Neutralize the shared `.bp-paper-surface pre` code-block chrome
         (border/padding/radius) — the rail's gitGraph is a naked 240px
         diagram, not a code block; without these it grows a bp-theme
         inset box. Reader-chrome override per charter Decision 5. */
      border: 0;
      border-radius: 0;
      padding: 0;
    }
    .bp-paper-article .bp-goal-rail-events {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .bp-paper-article .bp-goal-rail-event {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin: 0.1rem 0;
      padding: 0.35rem 0.5rem;
      border-radius: 4px;
      font-size: 0.85rem;
      color: var(--paper-ink);
      cursor: pointer;
      transition: background 0.12s ease;
    }
    .bp-paper-article .bp-goal-rail-event:hover {
      background: var(--paper-accent-soft);
    }
    .bp-paper-article .bp-goal-rail-event.is-selected {
      background: var(--paper-accent-soft);
      box-shadow: inset 3px 0 0 var(--paper-accent);
    }
    .bp-paper-article .bp-goal-rail-event-idx {
      flex: 0 0 auto;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--paper-accent);
      min-width: 1.1em;
      text-align: right;
    }
    .bp-paper-article .bp-goal-rail-event-type {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.78rem;
    }

    /* P6.U3 diff selection markers — shift-clicking two rail rows marks them
       as the A / B endpoints of a diff. RailDiffSelect toggles these classes;
       they read as a subtle accent outline distinct from the plain
       `is-selected` highlight (which still fires on a non-shift click). */
    .bp-paper-article .bp-goal-rail-event.is-diff-a,
    .bp-paper-article .bp-goal-rail-event.is-diff-b {
      box-shadow: inset 3px 0 0 #2f7a4d;
      background: rgba(47, 122, 77, 0.1);
    }

    /* P6.U3 diff modal — opens when two rail nodes are shift-clicked. A
       full-viewport overlay (backdrop + centered panel) over the article. The
       diff body reuses the article palette: a bp-theme panel, monospace diff
       lines, restrained add/del/ctx coloring. Scoped under `.bp-paper-article`
       like the rest; the modal markup is a child of <main>. */
    .bp-paper-article .bp-diff-overlay {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .bp-paper-article .bp-diff-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(20, 18, 14, 0.55);
    }
    .bp-paper-article .bp-diff-panel {
      position: relative;
      z-index: 1;
      width: min(760px, 100%);
      max-height: 80vh;
      overflow: auto;
      background: var(--paper-bg);
      border: 1px solid rgba(26, 26, 26, 0.12);
      border-radius: 8px;
      box-shadow: 0 12px 40px rgba(20, 18, 14, 0.3);
      padding: 1.25rem 1.5rem 1.5rem;
    }
    .bp-paper-article .bp-diff-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin: 0 0 1rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid var(--paper-rule);
    }
    .bp-paper-article .bp-diff-title {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      /* Pin against the shared `.bp-paper-surface h2 { line-height: 1.2 }`
         element rule (this <h2> sits inside the surface <main>). */
      line-height: inherit;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--paper-ink);
    }
    .bp-paper-article .bp-diff-from,
    .bp-paper-article .bp-diff-to {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--paper-accent);
    }
    .bp-paper-article .bp-diff-arrow {
      margin: 0 0.4rem;
      color: var(--paper-ink-soft);
    }
    .bp-paper-article .bp-diff-close {
      flex: 0 0 auto;
      border: none;
      background: none;
      font-size: 1.4rem;
      line-height: 1;
      color: var(--paper-ink-soft);
      cursor: pointer;
      padding: 0 0.25rem;
      border-radius: 4px;
      transition: background 0.12s ease, color 0.12s ease;
    }
    .bp-paper-article .bp-diff-close:hover {
      background: var(--paper-accent-soft);
      color: var(--paper-accent);
    }

    /* The diff body itself — TextDiff.format_diff_html/1 emits
       <pre class="bp-diff"> of one <span class="bp-diff-line bp-diff-{…}">
       per line. Monospace, line-per-row, add greenish / del reddish / ctx
       muted — restrained so it reads as an article aside, not a terminal. */
    .bp-paper-article .bp-diff {
      margin: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.82rem;
      line-height: 1.5;
      white-space: pre-wrap;
      word-break: break-word;
      /* Neutralize the shared `.bp-paper-surface pre` code-block chrome —
         this diff is a naked aside inside the modal panel; the shared bp-theme
         box would otherwise grow a bordered inset here. Reader-chrome override,
         Decision 5. (The panel + diff lines now theme via the --paper-*/
         --bp-tone-* tokens, so an OS-dark reader gets a dark modal, not a
         blinding-light one.) */
      background: none;
      border: 0;
      border-radius: 0;
      padding: 0;
    }
    .bp-paper-article .bp-diff-line {
      display: block;
      padding: 0 0.5rem;
      border-radius: 2px;
    }
    .bp-paper-article .bp-diff-add {
      background: var(--bp-tone-success-bg);
      color: var(--bp-tone-success-fg);
    }
    .bp-paper-article .bp-diff-del {
      background: var(--bp-tone-danger-bg);
      color: var(--bp-tone-danger-fg);
    }
    .bp-paper-article .bp-diff-ctx {
      color: var(--paper-ink-soft);
    }

    /* Sheet-embed default alignment. The walker (PortableDoc.Render.Walk)
       stamps these as CLASSES, never inline — the sheets-parity suite pins
       the inline b/i/bg/al styles identical across surfaces, and an explicit
       s.al (inline) outranks the class by CSS precedence. Mirror of the
       Studio grid's .sheet-cell.sheet-al-* rules (root.html.heex). */
    td.sheet-al-right { text-align: right; }
    td.sheet-al-center { text-align: center; }

    /* ── View-toggle pills: switch between Reader, TUI, and Email
       views of the same paper. Opt-in (body.bp-tui / body.bp-email), persisted
       client-side. TUI view is NOT a CSS terminal imitation — it renders the
       paper through the REAL Go pdrender compiled to WASM (the `#bp-terminal`
       block ~50 lines below is the actual pdrender output, ANSI→HTML in the
       wasm; the same renderer `bp paper view` runs). The rules HERE are only the
       toggle-pill chrome — presentational + additive, and scoped to
       `.bp-paper-article` so email/non-article papers are never affected. */
    .bp-view-controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px;
      width: min(calc(100% - 40px), 1040px);
      margin: 24px auto calc(24px + env(safe-area-inset-bottom));
    }
    .bp-view-toggle {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 12.5px;
      font-weight: 600; letter-spacing: 0.02em;
      padding: 8px 13px; border-radius: 999px; cursor: pointer;
      color: #2f6b4e; background: rgba(255,255,255,0.86);
      border: 1px solid rgba(20,40,30,0.16);
      box-shadow: 0 2px 10px rgba(20,40,30,0.14); backdrop-filter: blur(6px);
      transition: background 0.15s, color 0.15s, transform 0.08s;
    }
    .bp-view-toggle:hover { transform: translateY(-1px); }
    /* The three views are mutually
       exclusive; inside an alternate view only that view's own pill stays
       visible, as the way back to the reader. */
    body.bp-tui .bp-view-toggle--email { display: none; }
    body.bp-email .bp-view-toggle:not(.bp-view-toggle--email) { display: none; }
    /* Dark/light mode pill. The label names the
       mode a click switches TO; the stamp itself is written by the nonced
       mode-toggle IIFE at the end of <body>. Hidden inside the TUI view
       (always terminal-dark); the email-mode rule above already hides it
       there, and print + the no-article guard below cover the rest. */
    body.bp-tui .bp-mode-toggle { display: none; }
    .bp-view-toggle:focus-visible { outline: 2px solid #2f7d5b; outline-offset: 2px; }
    .bp-view-toggle .bp-vt-dot { width: 7px; height: 7px; border-radius: 50%; background: #2f7d5b; }
    /* hide the toggle when there is no article paper on the page */
    body:not(:has(.bp-paper-article)) .bp-view-controls { display: none; }

    /* toggle look in TUI mode */
    body.bp-tui .bp-view-toggle {
      color: #5fcf9c; background: rgba(10,15,12,0.9);
      border-color: rgba(95,207,156,0.35); box-shadow: 0 2px 14px rgba(0,0,0,0.5);
    }
    body.bp-tui .bp-view-toggle .bp-vt-dot { background: #5fcf9c; box-shadow: 0 0 6px #5fcf9c; }

    /* toggle look in Email mode — the pill sits below the inbox ground */
    body.bp-email .bp-view-toggle--email .bp-vt-dot { box-shadow: 0 0 6px #2f7d5b; }

    /* Comparison evidence stacks before the reading column gets cramped. */
    @media (max-width: 900px) {
      .bp-paper-article figure > .bp-cols { grid-template-columns: 1fr; }
    }

    @media (max-width: 767px) {
      .bp-paper-shell.bp-paper-article {
        /* The band collapses onto the gutter ladder above rather than onto its
           own literals. `padding-inline: 20px` used to live here and was the
           source of the reader's 20px narrow gutter — a THIRD value, later in
           the sheet than the ladder and therefore the winner, while these two
           band literals were already written for a 16px gutter (32 = 2 x 16).
           The band's edge and the prose's edge were 4px apart by construction.
           Both now read the one token, so they cannot drift again. */
        --bp-evidence-gutter: var(--paper-gutter);
        --bp-evidence-width: calc(100vw - 2 * var(--paper-gutter));
        --bp-evidence-pull: calc(50% - var(--bp-evidence-width) / 2);
      }
      .bp-paper-article [data-block-id*="-clip-"]:has(> .bp-button) {
        display: block;
        margin: 0;
        border-top: 1px solid var(--paper-rule);
      }
      .bp-paper-article [data-block-id*="-clip-"]:has(> .bp-button) > .bp-button {
        width: 100%;
        padding-block: 0.55rem;
      }
      .bp-paper-article figure > .bp-cols img {
        width: 100%;
        height: auto;
        max-height: none;
        object-fit: contain;
      }
      .bp-view-controls {
        justify-content: flex-start;
        gap: 6px;
        width: calc(100% - 32px);
        margin-block: 18px calc(18px + env(safe-area-inset-bottom));
      }
      .bp-view-toggle {
        gap: 6px;
        margin: 0;
        padding: 7px 10px;
        font-size: 11.5px;
        backdrop-filter: none;
      }
    }

    /* ── the REAL TUI render (the actual Go pdrender, compiled to WASM) ──────
       In TUI mode we HIDE the reader article and show a real TERMINAL WINDOW:
       a title bar (traffic lights + slug), and a fixed-width content column
       holding the EXACT pdrender output (ANSI→HTML by the wasm). The column is a
       stable N-column monospace grid (`--bp-cols`, default 100) — it never
       reflows to the viewport, so the render is the same width regardless of
       screen size, exactly like a terminal. This is the same renderer
       `bp paper view` runs; not a CSS imitation. */
    body.bp-tui { background: #05070a; }
    body.bp-tui .bp-paper-shell.bp-paper-article { display: none; }
    #bp-terminal { display: none; }
    body.bp-tui #bp-terminal {
      display: block;
      /* SAME max width as the reader column (.bp-paper-shell.bp-paper-article's
         max-width: 720px) — Reader view and TUI view occupy the identical
         measure, so toggling never reflows the page. 720px happens to fit a
         classic 80-column terminal exactly at this 14px monospace, so the wasm
         renders at a FIXED 80 cols (TUI_COLS below must stay in lockstep). On a
         narrower screen the box shrinks like the reader; the 80-col grid does
         NOT reflow — .bp-term-scroll scrolls horizontally inside the window. */
      width: min(720px, calc(100vw - 32px));
      margin: 26px auto 60px;
      background: #0b0e13;
      border: 1px solid #232a35;
      border-radius: 10px;
      box-shadow: 0 24px 70px rgba(0,0,0,0.6), 0 0 0 1px #05070a;
      overflow: hidden;
    }
    #bp-terminal .bp-term-bar {
      display: flex; align-items: center; gap: 8px;
      height: 34px; padding: 0 13px;
      background: linear-gradient(#1a2029, #141922);
      border-bottom: 1px solid #232a35;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 12px; color: #6b7685;
    }
    #bp-terminal .bp-term-dots { display: inline-flex; gap: 7px; }
    #bp-terminal .bp-term-dots i { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
    #bp-terminal .bp-term-dots i:nth-child(1) { background: #ff5f56; }
    #bp-terminal .bp-term-dots i:nth-child(2) { background: #ffbd2e; }
    #bp-terminal .bp-term-dots i:nth-child(3) { background: #27c93f; }
    #bp-terminal .bp-term-title { flex: 1; text-align: center; letter-spacing: 0.02em; }
    #bp-terminal .bp-term-title b { color: #aab6c4; font-weight: 600; }
    #bp-terminal .bp-term-scroll { overflow-x: auto; overflow-y: hidden; }
    #bp-terminal .bp-term-body { padding: 16px 20px 26px; width: max-content; min-width: 100%; }
    #bp-terminal .bp-term-body::before {
      content: "$ bp paper view " attr(data-slug);
      display: block; color: #5fcf9c; font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 14px; margin-bottom: 12px; opacity: 0.85;
    }
    #bp-terminal .bp-tui-pre {
      font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
      font-size: 14px; line-height: 1.5; color: #c8d3cc; white-space: pre; margin: 0;
      -webkit-font-smoothing: antialiased;
    }
    #bp-terminal .bp-tui-loading { color: #6b7972; font-family: ui-monospace, Menlo, monospace; font-size: 14px; padding: 4px 0; }
    /* ── Email view: the paper as a RECEIVED MAIL ────────────────────────────
       In Email mode we HIDE the reader article and show a MAIL CLIENT WINDOW:
       title bar, message toolbar, sender header (avatar / from / to me /
       received stamp), and the message body — an <iframe> of the literal
       /papers/:slug/email response. Those are the exact bytes a mail backend
       sends (Render.render_document, all styles inline); no CSS imitation,
       the same honesty rule as the TUI view. The chrome is theme-aware — a
       dark mail client showing a light HTML email, exactly like real clients —
       but the message bytes never change with the theme. */
    #bp-mailapp {
      /* --mail-* window-chrome vars are GENERATED into the reader-skin marker
         region above (design/tokens.json color.mailChrome → design/emit.mjs). */
      display: none;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    }
    body.bp-email { background: #e3ece7; }
    body.bp-email .bp-paper-shell.bp-paper-article { display: none; }
    body.bp-email #bp-mailapp {
      display: block;
      /* SAME measure as the reader column and the terminal window — the three
         views occupy identical width, so toggling never reflows the page. */
      width: min(720px, calc(100vw - 32px));
      margin: 26px auto 60px;
      background: var(--mail-paper);
      border: 1px solid var(--mail-rule);
      border-radius: 12px;
      box-shadow: 0 24px 70px rgba(21,33,29,0.18), 0 2px 8px rgba(21,33,29,0.08);
      overflow: hidden;
    }
    @media (prefers-color-scheme: dark) {
      body.bp-email { background: #0a100e; }
      body.bp-email #bp-mailapp { box-shadow: 0 24px 70px rgba(0,0,0,0.55); }
    }
    #bp-mailapp .bp-mail-bar {
      display: flex; align-items: center; gap: 8px;
      height: 34px; padding: 0 13px;
      background: var(--mail-bar);
      border-bottom: 1px solid var(--mail-rule);
      font-size: 12px; color: var(--mail-soft);
    }
    #bp-mailapp .bp-mail-dots { display: inline-flex; gap: 7px; }
    #bp-mailapp .bp-mail-dots i { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
    #bp-mailapp .bp-mail-dots i:nth-child(1) { background: #ff5f56; }
    #bp-mailapp .bp-mail-dots i:nth-child(2) { background: #ffbd2e; }
    #bp-mailapp .bp-mail-dots i:nth-child(3) { background: #27c93f; }
    #bp-mailapp .bp-mail-title { flex: 1; text-align: center; letter-spacing: 0.02em; }
    #bp-mailapp .bp-mail-title b { color: var(--mail-ink); font-weight: 600; }
    /* the unread count settles once the message has been "read" (a beat after open) */
    #bp-mailapp .bp-mail-unread { transition: opacity 0.6s; }
    #bp-mailapp.bp-mail-read .bp-mail-unread { opacity: 0; }
    #bp-mailapp .bp-mail-toolbar {
      display: flex; align-items: center; gap: 4px;
      padding: 7px 12px;
      border-bottom: 1px solid var(--mail-rule);
    }
    #bp-mailapp .bp-mail-tool {
      display: inline-flex; align-items: center; justify-content: center;
      width: 30px; height: 28px; padding: 0;
      border: 0; border-radius: 6px; background: transparent;
      color: var(--mail-soft); cursor: pointer;
    }
    #bp-mailapp .bp-mail-tool:hover { background: var(--mail-bar); color: var(--mail-accent); }
    #bp-mailapp .bp-mail-tool:focus-visible { outline: 2px solid var(--mail-accent); outline-offset: 1px; }
    #bp-mailapp .bp-mail-tool[aria-pressed="true"] { color: #d5a021; }
    #bp-mailapp .bp-mail-tool[aria-pressed="true"] svg { fill: #d5a021; }
    #bp-mailapp .bp-mail-tooldiv { width: 1px; height: 18px; background: var(--mail-rule); margin: 0 6px; }
    #bp-mailapp .bp-mail-toolsp { flex: 1; }
    #bp-mailapp .bp-mail-head { padding: 18px 20px 14px; }
    #bp-mailapp .bp-mail-subjrow { display: flex; align-items: center; gap: 9px; }
    /* unread dot beside the subject — fades as the mail is "read" */
    #bp-mailapp .bp-mail-dot {
      width: 8px; height: 8px; border-radius: 50%; flex: none;
      background: var(--mail-accent); transition: opacity 0.6s;
    }
    #bp-mailapp.bp-mail-read .bp-mail-dot { opacity: 0; }
    #bp-mailapp .bp-mail-subject {
      margin: 0; font-size: 19px; line-height: 1.3; font-weight: 650;
      color: var(--mail-ink); letter-spacing: -0.01em; text-wrap: balance;
    }
    #bp-mailapp .bp-mail-fromrow {
      display: flex; align-items: center; gap: 12px; margin-top: 14px;
    }
    #bp-mailapp .bp-mail-avatar {
      width: 40px; height: 40px; border-radius: 50%; flex: none;
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--mail-accent); color: #f6faf9;
      font-size: 13px; font-weight: 600; letter-spacing: 0.04em;
    }
    #bp-mailapp .bp-mail-who { flex: 1; min-width: 0; }
    #bp-mailapp .bp-mail-fromline { font-size: 14px; color: var(--mail-ink); }
    #bp-mailapp .bp-mail-fromline b { font-weight: 600; }
    #bp-mailapp .bp-mail-addr { color: var(--mail-soft); font-size: 13px; }
    #bp-mailapp .bp-mail-toline { font-size: 12.5px; color: var(--mail-soft); margin-top: 2px; }
    #bp-mailapp .bp-mail-date { font-size: 12.5px; color: var(--mail-soft); white-space: nowrap; align-self: flex-start; margin-top: 2px; }
    #bp-mailapp .bp-mail-bodywrap { border-top: 1px solid var(--mail-rule); }
    /* the served email document carries its own tinted page ground — inside
       the window it reads as the client's message area */
    #bp-mailapp iframe {
      display: block; width: 100%; border: 0; min-height: 320px;
      background: #eaf1ee;
    }
    #bp-mailapp .bp-mail-foot {
      display: flex; align-items: center; gap: 8px;
      padding: 12px 16px;
      border-top: 1px solid var(--mail-rule);
    }
    #bp-mailapp .bp-mail-btn {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 7px 16px; border-radius: 999px;
      border: 1px solid var(--mail-rule);
      font-size: 13px; font-weight: 600; text-decoration: none;
      color: var(--mail-ink); background: transparent;
    }
    #bp-mailapp .bp-mail-btn:hover { border-color: var(--mail-accent); color: var(--mail-accent); }
    #bp-mailapp .bp-mail-browser {
      margin-left: auto; font-size: 12.5px; text-decoration: none;
      color: var(--mail-soft);
    }
    #bp-mailapp .bp-mail-browser:hover { color: var(--mail-accent); }
    @media (prefers-reduced-motion: reduce) {
      .bp-view-toggle { transition: none; }
      #bp-mailapp .bp-mail-dot, #bp-mailapp .bp-mail-unread { transition: none; }
    }

    /* ── Print: white paper, drop screen-only chrome, expand the reading column.
       Modeled on the sibling sheets reader block (sheets.html.heex @media print).
       A paper prints as the reading article on plain paper — the reader theme's
       dark ground and every interactive/navigational affordance are screen-only.
       Scoped like the rest of this sheet: article-only rules stay under
       `.bp-paper-article` so non-article papers are untouched. */
    @media print {
      /* Paged output is a LIGHT surface. The palette re-stamp lives in the
         GENERATED block above (design/emit.mjs `printRestamp` — the light
         `--paper-*` / `--bp-tone-*` values, single-sourced, never hand-copied);
         this is its `color-scheme` half. Without it the UA still renders form
         controls, scrollbar corners and the canvas backdrop for the DARK scheme
         the screen was in, and `color-scheme: dark` is what makes a UA darken an
         unstyled <input> or a `Highlight` colour on the printed sheet. */
      html { color-scheme: light; }
      /* The reader theme paints a tinted/dark ground on <body> and on the
         article shell; reset both to white so ink prints readably on any theme. */
      body,
      body:has(.bp-paper-article),
      body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
        background: #fff; /* lit-allow: print reset — white paper, not a theme color */
      }
      /* Reclaim the full printable measure and drop the screen gutter. */
      .bp-paper-shell { max-width: none; padding: 0; }
      /* Screen-only chrome — the view-toggle pills, the TUI terminal window and
         the mail-client window (alternate VIEWS of the same article), the sticky
         doc-action / simplify bars, the fixed diff overlay, and the goal-path
         rail are all interactive or navigational; none belong on paper. */
      .bp-view-toggle,
      #bp-terminal,
      #bp-mailapp,
      .bp-paper-article .bp-paper-actions,
      .bp-paper-article .bp-paper-simplify,
      .bp-paper-article .bp-diff-overlay,
      .bp-paper-article .bp-goal-rail { display: none !important; }
      .bp-image-lightbox { display: none !important; }
      /* Any surviving sticky/fixed positioning collapses to static so nothing
         floats or clips in paged output. */
      .bp-paper-article .bp-paper-actions,
      .bp-paper-article .bp-goal-rail { position: static; float: none; }
      /* Keep figures, data-viz cards, embeds, and code blocks whole across a
         page break rather than splitting mid-figure. */
      .bp-paper-article figure,
      .bp-paper-article pre,
      .bp-paper-article .bp-embed,
      .bp-paper-article .bp-dataviz,
      .bp-paper-article .bp-stat,
      .bp-paper-article .bp-heat,
      .bp-paper-article .bp-chart { break-inside: avoid; }
    }
  </style>
</head>
<body>
  {@inner_content}

  <dialog id="bp-image-lightbox" class="bp-image-lightbox" aria-label="Enlarged paper image">
    <button
      type="button"
      class="bp-image-lightbox__close"
      aria-label="Close enlarged image"
    >×</button>
    <div class="bp-image-lightbox__stage">
      <div class="bp-image-lightbox__toolbar" aria-label="Image size">
        <button type="button" class="bp-image-lightbox__mode" data-bp-lightbox-view="actual" aria-pressed="false">100%</button>
        <button type="button" class="bp-image-lightbox__mode" data-bp-lightbox-view="fit" aria-pressed="false">Fit image</button>
        <span class="bp-image-lightbox__hint">Drag or scroll to inspect</span>
      </div>
      <div class="bp-image-lightbox__viewport" tabindex="0" aria-label="Scrollable enlarged image">
        <div class="bp-image-lightbox__canvas">
          <img class="bp-image-lightbox__image" src="" alt="" />
        </div>
      </div>
      <p class="bp-image-lightbox__caption"></p>
    </div>
  </dialog>

  <script nonce={assigns[:csp_nonce]}>
    (function () {
      var article = document.querySelector(".bp-paper-article");
      var dialog = document.getElementById("bp-image-lightbox");
      if (!article || !dialog || typeof dialog.showModal !== "function") return;

      var lightboxImg = dialog.querySelector(".bp-image-lightbox__image");
      var caption = dialog.querySelector(".bp-image-lightbox__caption");
      var closeButton = dialog.querySelector(".bp-image-lightbox__close");
      var viewport = dialog.querySelector(".bp-image-lightbox__viewport");
      var modeButtons = Array.from(dialog.querySelectorAll("[data-bp-lightbox-view]"));
      var trigger = null;

      function isEligible(image) {
        return image && image.dataset.bpLightboxable === "true" && article.contains(image) && !image.closest("a, button");
      }

      function prepare(root) {
        var selector = 'img[data-bp-lightboxable="true"]';
        var images = root.matches && root.matches(selector) ? [root] : Array.from(root.querySelectorAll(selector));
        images.filter(isEligible).forEach(function (image) {
          image.tabIndex = 0;
          image.setAttribute("role", "button");
          image.setAttribute("aria-label", (image.alt ? image.alt + ". " : "") + "Open enlarged image");
        });
      }

      function open(image) {
        if (!isEligible(image)) return;
        trigger = image;
        lightboxImg.src = image.currentSrc || image.src;
        lightboxImg.alt = image.alt || "";
        caption.textContent = image.alt || "";
        dialog.showModal();
        if (lightboxImg.complete && lightboxImg.naturalWidth) chooseInitialView();
      }

      function setView(view) {
        dialog.dataset.view = view;
        modeButtons.forEach(function (button) {
          button.setAttribute("aria-pressed", button.dataset.bpLightboxView === view ? "true" : "false");
        });
        viewport.scrollTo({ left: 0, top: 0, behavior: "auto" });
      }

      function chooseInitialView() {
        var ratio = lightboxImg.naturalHeight ? lightboxImg.naturalWidth / lightboxImg.naturalHeight : 1;
        setView(ratio >= 2.2 ? "actual" : "fit");
      }

      function close() {
        if (dialog.open) dialog.close();
      }

      prepare(article);
      lightboxImg.addEventListener("load", chooseInitialView);
      modeButtons.forEach(function (button) {
        button.addEventListener("click", function () { setView(button.dataset.bpLightboxView); });
      });

      var pan = null;
      viewport.addEventListener("pointerdown", function (event) {
        if (event.pointerType !== "mouse" || event.button !== 0 || dialog.dataset.view !== "actual") return;
        pan = { x: event.clientX, y: event.clientY, left: viewport.scrollLeft, top: viewport.scrollTop };
        viewport.classList.add("is-panning");
        viewport.setPointerCapture(event.pointerId);
      });
      viewport.addEventListener("pointermove", function (event) {
        if (!pan) return;
        viewport.scrollLeft = pan.left - (event.clientX - pan.x);
        viewport.scrollTop = pan.top - (event.clientY - pan.y);
      });
      function stopPan() {
        pan = null;
        viewport.classList.remove("is-panning");
      }
      viewport.addEventListener("pointerup", stopPan);
      viewport.addEventListener("pointercancel", stopPan);
      new MutationObserver(function (records) {
        records.forEach(function (record) {
          record.addedNodes.forEach(function (node) {
            if (node.nodeType === Node.ELEMENT_NODE) prepare(node);
          });
        });
      }).observe(article, { childList: true, subtree: true });

      article.addEventListener("click", function (event) {
        var image = event.target.closest("img");
        if (isEligible(image)) open(image);
      });
      article.addEventListener("keydown", function (event) {
        if (event.key !== "Enter" && event.key !== " ") return;
        var image = event.target.closest("img");
        if (!isEligible(image)) return;
        event.preventDefault();
        open(image);
      });
      closeButton.addEventListener("click", close);
      dialog.addEventListener("click", function (event) {
        if (event.target === dialog) close();
      });
      dialog.addEventListener("cancel", function () { close(); });
      dialog.addEventListener("close", function () {
        lightboxImg.removeAttribute("src");
        dialog.removeAttribute("data-view");
        if (trigger && trigger.isConnected) trigger.focus();
        trigger = null;
      });
    })();
  </script>

  <script nonce={assigns[:csp_nonce]}>
    (function () {
      function chapterNumber(text) {
        var match = String(text || "").trim().match(/^0*(\d+)\s*[\u00b7.:–-]/);
        return match ? Number(match[1]) : null;
      }

      function prepareChapters() {
        var article = document.querySelector(".bp-paper-article");
        if (!article) return;

        var headings = Array.from(article.querySelectorAll("#paper-body h2"));
        var targets = new Map();
        headings.forEach(function (heading) {
          var number = chapterNumber(heading.textContent);
          var wrapper = heading.closest("[data-block-id]");
          if (number === null || !wrapper || targets.has(number)) return;
          if (!wrapper.id) wrapper.id = "bp-paper-chapter-" + number;
          wrapper.dataset.bpChapterAnchor = "true";
          targets.set(number, wrapper);
        });

        article.querySelectorAll('[data-block-id*="chapter-map"] .bp-card').forEach(function (card) {
          var title = card.querySelector(".bp-card__t");
          var target = targets.get(chapterNumber(title && title.textContent));
          if (!target) return;
          card.dataset.bpChapterTarget = target.id;
          card.tabIndex = 0;
          card.setAttribute("role", "link");
          card.setAttribute("aria-label", "Go to " + (title ? title.textContent.trim() : "chapter"));
        });
      }

      var prepareScheduled = false;
      function schedulePrepare() {
        if (prepareScheduled) return;
        prepareScheduled = true;
        requestAnimationFrame(function () {
          prepareScheduled = false;
          prepareChapters();
        });
      }

      prepareChapters();
      window.addEventListener("phx:page-loading-stop", schedulePrepare);
      new MutationObserver(schedulePrepare).observe(document.body, { childList: true, subtree: true });

      function follow(card) {
        var target = card && document.getElementById(card.dataset.bpChapterTarget);
        if (!target) return;
        history.replaceState(null, "", "#" + target.id);
        var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        target.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
      }

      document.addEventListener("click", function (event) {
        var card = event.target.closest(".bp-card[data-bp-chapter-target]");
        if (card) follow(card);
      });
      document.addEventListener("keydown", function (event) {
        if (event.key !== "Enter" && event.key !== " ") return;
        var card = event.target.closest(".bp-card[data-bp-chapter-target]");
        if (!card) return;
        event.preventDefault();
        follow(card);
      });
    })();
  </script>

  <%!-- Reader / TUI / Email view toggles (bottom-right, mutually exclusive).
        TUI mode renders the paper through the REAL Go pdrender, compiled to
        WASM (bp-pdrender.wasm.gz) — the exact renderer `bp paper view` runs,
        converted ANSI→HTML in the wasm. The wasm is lazy-loaded on first
        activation. Blocks come from the public query API (filtered to this
        slug). Email mode shows the mail-client window below. The divs + script
        live at the END of <body> (never a blocking <head> script — golden
        rule). --%>
  <div id="bp-terminal" aria-live="polite">
    <div class="bp-term-bar">
      <span class="bp-term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="bp-term-title"><b>bp paper view</b> · pdrender</span>
      <span style="width:52px" aria-hidden="true"></span>
    </div>
    <div class="bp-term-scroll">
      <div class="bp-term-body" id="bp-tui-out"></div>
    </div>
  </div>
  <%!-- CSP layer-2 (csp-paper-reader): the click handler is bound via
        addEventListener inside the nonced toggle IIFE below, NOT an inline
        onclick — an enforcing script-src without 'unsafe-inline' blocks inline
        handlers (which is what neutralises an injected onerror=). --%>
  <%!-- Email view: the paper as a RECEIVED MAIL. A mail-client window whose
        message body iframes the literal /papers/:slug/email response — the
        same bytes a mail backend sends (lazy: src set on first activation).
        The toolbar's back/archive/trash all "file the mail away", i.e. return
        to the reader; Reply/Forward are real mailto: links; "View in browser"
        keeps the raw-bytes tab. --%>
  <div id="bp-mailapp" aria-live="polite">
    <div class="bp-mail-bar">
      <span class="bp-mail-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="bp-mail-title"><b>Barkpark Mail</b> · Inbox<span class="bp-mail-unread" id="bp-mail-unread"> (1)</span></span>
      <span style="width:52px" aria-hidden="true"></span>
    </div>
    <div class="bp-mail-toolbar">
      <button type="button" class="bp-mail-tool" data-mail-exit title="Back to inbox" aria-label="Back — return to the reader">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <span class="bp-mail-tooldiv" aria-hidden="true"></span>
      <button type="button" class="bp-mail-tool" data-mail-exit title="Archive" aria-label="Archive — return to the reader">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8v13H3V8M1 3h22v5H1zM10 12h4"/></svg>
      </button>
      <button type="button" class="bp-mail-tool" data-mail-exit title="Delete" aria-label="Delete — return to the reader">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/></svg>
      </button>
      <span class="bp-mail-toolsp" aria-hidden="true"></span>
      <button type="button" class="bp-mail-tool" id="bp-mail-star" title="Star" aria-label="Star this message" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </button>
    </div>
    <div class="bp-mail-head">
      <div class="bp-mail-subjrow">
        <span class="bp-mail-dot" aria-hidden="true"></span>
        <h2 class="bp-mail-subject" id="bp-mail-subject">Paper</h2>
      </div>
      <div class="bp-mail-fromrow">
        <span class="bp-mail-avatar" aria-hidden="true">BP</span>
        <div class="bp-mail-who">
          <div class="bp-mail-fromline"><b>Barkpark Papers</b> <span class="bp-mail-addr">&lt;papers@barkpark.cloud&gt;</span></div>
          <div class="bp-mail-toline">to me ▾</div>
        </div>
        <span class="bp-mail-date" id="bp-mail-date"></span>
      </div>
    </div>
    <div class="bp-mail-bodywrap">
      <iframe id="bp-mail-frame" title="This paper rendered as the email subscribers receive"></iframe>
    </div>
    <div class="bp-mail-foot">
      <a class="bp-mail-btn" id="bp-mail-reply" href="#">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
        Reply
      </a>
      <a class="bp-mail-btn" id="bp-mail-forward" href="#">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 17 20 12 15 7"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/></svg>
        Forward
      </a>
      <a class="bp-mail-browser" id="bp-mail-browser" href="#" target="_blank" rel="noopener">View in browser ↗</a>
    </div>
  </div>
  <%!-- CSP layer-2: every control is bound via addEventListener in the nonced
        IIFEs below, never through an inline onclick. --%>
  <div class="bp-view-controls" role="group" aria-label="Paper view controls">
    <button
      type="button"
      class="bp-view-toggle"
      aria-pressed="false"
      aria-label="Toggle terminal (TUI) view"
    >
      <span class="bp-vt-dot" aria-hidden="true"></span>
      <span class="bp-vt-label">TUI view</span>
    </button>
    <button
      type="button"
      class="bp-view-toggle bp-view-toggle--email"
      aria-pressed="false"
      aria-label="Toggle email view"
    >
      <span class="bp-vt-dot" aria-hidden="true"></span>
      <span class="bp-vt-label">Email view</span>
    </button>
    <%!-- Dark/light mode pill. CSP layer-2: handler bound in the nonced IIFE
          below, never an inline onclick. aria-pressed mirrors "dark mode on";
          the label names the mode a click switches TO. --%>
    <button
      type="button"
      class="bp-view-toggle bp-mode-toggle"
      aria-pressed="false"
      aria-label="Switch between dark and light mode"
    >
      <span class="bp-vt-dot" aria-hidden="true"></span>
      <span class="bp-vt-label">Mode</span>
    </button>
  </div>
  <script nonce={assigns[:csp_nonce]}>
    (function () {
      var KEY = "barkpark_theme";
      var btn = document.querySelector(".bp-mode-toggle");
      if (!btn) return;
      var label = btn.querySelector(".bp-vt-label");
      function mode() {
        return document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      }
      var last = mode();
      function paint() {
        var m = mode();
        if (label) label.textContent = m === "dark" ? "Light mode" : "Dark mode";
        btn.setAttribute("aria-pressed", m === "dark" ? "true" : "false");
      }
      // Broadcast only on an EFFECTIVE change — consumers that bake colors in
      // (mermaid) re-render on `bp:mode`; an OS flip under a stored choice
      // changes nothing and must not trigger a rebuild.
      function announce() {
        var m = mode();
        if (m === last) return;
        last = m;
        window.dispatchEvent(new CustomEvent("bp:mode", { detail: { mode: m } }));
      }
      btn.addEventListener("click", function () {
        var next = mode() === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem(KEY, next); } catch (e) {}
        paint();
        announce();
      });
      // No stored choice → the pre-paint <head> listener (registered first,
      // so the attribute is already fresh here) mirrors OS flips; track the
      // label and rebroadcast.
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function () {
        paint();
        announce();
      });
      paint();
    })();
  </script>
  <script nonce={assigns[:csp_nonce]}>
    (function () {
      var KEY = "bp-paper-view"; // "reader" | "tui" | "email" — one mode at a time
      var btn = document.querySelector(".bp-view-toggle:not(.bp-view-toggle--email)");
      var label = btn && btn.querySelector(".bp-vt-label");
      var emailBtn = document.querySelector(".bp-view-toggle--email");
      var emailLabel = emailBtn && emailBtn.querySelector(".bp-vt-label");
      var out = document.getElementById("bp-tui-out");
      var wasmReady = null; // a promise once loading starts

      function setLabels(mode) {
        var tui = mode === "tui", email = mode === "email";
        if (btn) btn.setAttribute("aria-pressed", tui ? "true" : "false");
        if (label) label.textContent = tui ? "Reader view" : "TUI view";
        if (emailBtn) emailBtn.setAttribute("aria-pressed", email ? "true" : "false");
        if (emailLabel) emailLabel.textContent = email ? "Reader view" : "Email view";
      }

      function currentSlug() {
        // /papers/:slug OR /w/:ws/p/:proj/papers/:slug
        var m = location.pathname.match(/\/papers\/([^\/?#]+)/);
        return m ? decodeURIComponent(m[1]) : null;
      }

      function loadScript(src) {
        return new Promise(function (res, rej) {
          var s = document.createElement("script");
          s.src = src; s.onload = res; s.onerror = rej;
          document.head.appendChild(s);
        });
      }

      // Lazy-load wasm_exec.js + the gzipped wasm, decompress, instantiate. The Go
      // main sets window.bpRenderTUI then blocks (select{}), so we DON'T await
      // go.run — we poll for the export.
      function ensureWasm() {
        if (wasmReady) return wasmReady;
        wasmReady = (async function () {
          await loadScript("/assets/bp-wasm-exec.js");
          var go = new Go();
          var resp = await fetch("/assets/bp-pdrender.wasm.gz");
          var buf;
          if (typeof DecompressionStream !== "undefined") {
            var ds = new DecompressionStream("gzip");
            buf = await new Response(resp.body.pipeThrough(ds)).arrayBuffer();
          } else {
            buf = await resp.arrayBuffer(); // server may already decode gzip
          }
          var result = await WebAssembly.instantiate(buf, go.importObject);
          go.run(result.instance);
          // wait for the exported function to appear
          for (var i = 0; i < 200 && typeof window.bpRenderTUI !== "function"; i++) {
            await new Promise(function (r) { setTimeout(r, 10); });
          }
          if (typeof window.bpRenderTUI !== "function") throw new Error("wasm export missing");
        })();
        return wasmReady;
      }

      async function fetchBlocks(slug) {
        // Read through a route mounted inside the SAME Papers capability as the
        // current page. This preserves membership, section-share, item-share,
        // workspace/project, dataset, and the `?share=` token without exposing
        // the broader document API to browser code.
        var url = location.pathname.replace(/\/+$/, "") + "/source" + location.search;
        // Browser fetch defaults to Accept: */*, which the Paper page's HTML
        // capability pipeline accepts. Do not opt into a separate JSON pipeline.
        var r = await fetch(url);
        if (!r.ok) return null;
        var d = await r.json();
        var source = d && d.source;
        if (source && source.kind === "blocks" && Array.isArray(source.blocks)) return source.blocks;
        if (source && source.kind === "html" && typeof source.html === "string") {
          var parsed = new DOMParser().parseFromString(source.html, "text/html");
          var text = (parsed.body.textContent || "").replace(/\s+/g, " ").trim();
          return [{
            id: "legacy-html",
            type: "paragraph",
            content: [{ type: "text", value: text }]
          }];
        }
        return null;
      }

      // A FIXED terminal width — the render is always this many columns, regardless
      // of screen size (a real terminal has a stable column grid). 80 is THE
      // classic terminal width, and 80 cols of 14px monospace fit exactly inside
      // the 720px window (#bp-terminal width — the reader column's max-width, so
      // Reader and TUI occupy the identical measure). Keep in lockstep.
      var TUI_COLS = 80;

      async function renderTUI() {
        if (!out) return;
        var slug = currentSlug();
        // pin the CSS grid width + the "$ bp paper view <slug>" prompt line
        document.documentElement.style.setProperty("--bp-cols", TUI_COLS);
        if (slug) out.setAttribute("data-slug", slug);
        out.innerHTML = '<div class="bp-tui-loading">rendering…</div>';
        try {
          if (!slug) throw new Error("no paper slug in the URL");
          var blocksP = fetchBlocks(slug);
          await ensureWasm();
          var blocks = await blocksP;
          if (!blocks) throw new Error("could not load this paper's blocks");
          var html = window.bpRenderTUI(JSON.stringify(blocks), TUI_COLS, "dark");
          out.innerHTML = html;
        } catch (e) {
          out.innerHTML = '<pre class="bp-tui-pre">TUI render failed: ' +
            String(e && e.message || e).replace(/[<>&]/g, "") + "</pre>";
        }
      }

      // ── Email view: mount the mail-client window once, on first activation.
      // The message body is the LITERAL /papers/:slug/email response in an
      // iframe (same-origin, so we can auto-fit its height) — the exact bytes
      // a mail backend sends, not a re-render.
      var mailMounted = false;
      function mountMail() {
        var app = document.getElementById("bp-mailapp");
        if (!app || mailMounted) return;
        mailMounted = true;
        var h1 = document.querySelector(".bp-paper-article h1");
        var subject = (h1 && h1.textContent.trim()) ||
          (document.title || "").replace(/\s*[·|–—].*$/, "").trim() || "Paper";
        var subjEl = document.getElementById("bp-mail-subject");
        if (subjEl) subjEl.textContent = subject;
        // received stamp, formatted like an inbox
        var now = new Date();
        var dateEl = document.getElementById("bp-mail-date");
        if (dateEl) {
          dateEl.textContent =
            now.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "numeric" }) +
            ", " +
            now.toLocaleTimeString(undefined, { hour: "2-digit", minute: "2-digit" }) +
            " (just now)";
        }
        var raw = location.pathname.replace(/\/+$/, "") + "/email" + location.search;
        var replyEl = document.getElementById("bp-mail-reply");
        if (replyEl) replyEl.href = "mailto:papers@barkpark.cloud?subject=" + encodeURIComponent("Re: " + subject);
        var fwdEl = document.getElementById("bp-mail-forward");
        if (fwdEl) fwdEl.href = "mailto:?subject=" + encodeURIComponent("Fwd: " + subject) +
          "&body=" + encodeURIComponent(location.origin + raw);
        var browserEl = document.getElementById("bp-mail-browser");
        if (browserEl) browserEl.href = raw;
        var frame = document.getElementById("bp-mail-frame");
        if (frame) {
          var fit = function () {
            try {
              var d = frame.contentDocument;
              if (d) frame.style.height = Math.max(320, d.documentElement.scrollHeight) + "px";
            } catch (e) {}
          };
          frame.addEventListener("load", function () {
            fit(); setTimeout(fit, 400); setTimeout(fit, 1500); // late images/fonts
          });
          window.addEventListener("resize", fit);
          frame.src = raw;
        }
        // the unread dot + Inbox (1) settle once the message has been "read"
        setTimeout(function () { app.classList.add("bp-mail-read"); }, 1400);
      }

      // toolbar: back/archive/trash all file the mail away (return to reader);
      // the star is a local nicety
      document.querySelectorAll("#bp-mailapp [data-mail-exit]").forEach(function (b) {
        b.addEventListener("click", function () { setMode("reader"); });
      });
      var star = document.getElementById("bp-mail-star");
      if (star) star.addEventListener("click", function () {
        star.setAttribute("aria-pressed", star.getAttribute("aria-pressed") === "true" ? "false" : "true");
      });

      function apply(mode, doRender) {
        var tui = mode === "tui", email = mode === "email";
        document.body.classList.toggle("bp-tui", tui);
        document.body.classList.toggle("bp-email", email);
        setLabels(mode);
        if (tui && doRender) renderTUI();
        if (email && doRender) mountMail();
      }

      function setMode(next) {
        apply(next, true);
        try { localStorage.setItem(KEY, next); } catch (e) {}
      }

      // restore persisted choice (render if it was an alternate view)
      try {
        var saved = localStorage.getItem(KEY);
        apply(saved === "tui" ? "tui" : saved === "email" ? "email" : "reader", true);
      } catch (e) { apply("reader", false); }

      window.__bpToggleTui = function () {
        setMode(document.body.classList.contains("bp-tui") ? "reader" : "tui");
      };
      window.__bpToggleEmail = function () {
        setMode(document.body.classList.contains("bp-email") ? "reader" : "email");
      };

      // CSP layer-2: bind the toggle buttons here instead of inline onclick
      // attributes (blocked by the enforcing script-src). `btn`/`emailBtn` are
      // the same elements resolved at the top of this IIFE; the script tag sits
      // after both buttons in the DOM, so they always exist by now.
      if (btn) btn.addEventListener("click", window.__bpToggleTui);
      if (emailBtn) emailBtn.addEventListener("click", window.__bpToggleEmail);
    })();
  </script>

  <%!-- Mermaid engine for `diagram` blocks. Loaded `defer` (NEVER a blocking
        <script> in <head> — golden rule). startOnLoad:false: the PaperMermaid
        hook runs it manually so it works with LiveView's streamed DOM, where
        diagram <pre> elements arrive AFTER the initial parse. --%>
  <script defer src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
  <%!-- asciinema-player engine for `asciicast` blocks. Same `defer` discipline
        as mermaid (NEVER blocking in <head>); the PaperMermaid hook's
        runAsciicast() mounts a player per `div.bp-asciicast`, with the same
        deferred-load retry guard. Pinned to 3.8.0 (proven CDN/version). --%>
  <script defer src="https://cdn.jsdelivr.net/npm/asciinema-player@3.8.0/dist/bundle/asciinema-player.min.js"></script>
  <script src="/assets/phoenix.js"></script>
  <script src="/assets/phoenix_live_view.js"></script>
  <%!-- The zero-dependency Canvas2D corpus-graph renderer (same asset Studio
        loads). Non-defer like the phoenix pair above: `window.BarkparkGraph`
        (the LiveView hook bp-graph.js exports) must exist BEFORE the
        LiveSocket below registers hooks. Only the /finder page mounts it —
        every other reader page pays one cached script fetch, no execution. --%>
  <script src="/assets/bp-graph.js"></script>
  <%!-- THE shared Mermaid hook + evergreen palette — the SAME asset
        root.html.heex loads for the Studio chat transcript
        (task-e96ac3b80506cf32: the reader used to carry a byte-identical
        inline copy of both). Non-defer like the phoenix/bp-graph pair above:
        `window.BarkparkPaperMermaid` must exist BEFORE the inline script
        below reads it into PaperHooks and connects the LiveSocket. NOT in
        <head> and NOT blocking (Golden Rule #4) — the engine itself
        (mermaid.min.js) still loads `defer` above. --%>
  <script src="/assets/bp-paper-mermaid.js"></script>
  <script nonce={assigns[:csp_nonce]}>
    // PaperMermaid: the reader's per-<article> hook. Registered on the streamed
    // <article>, so mounted() fires once and updated() fires on every stream
    // delta — exactly when a new block's mount point enters the DOM. Diagrams
    // delegate to the SHARED asset; asciicast / code-tabs / tabs are
    // reader-only and implemented here.
    let PaperHooks = {
      PaperMermaid: {
        // runMermaid is NOT reimplemented here: /assets/bp-paper-mermaid.js
        // (loaded non-defer above) owns the diagram engine, the stash-the-
        // source discipline, the deferred-load retry and the legibility
        // unshrink — the same code the Studio chat transcript runs.
        // `.call(this)` because the shared implementation reads `this.el`,
        // the LiveView hook's element. Guarded so a missing asset degrades to
        // "no diagrams" instead of taking the whole hook map down.
        runMermaid() {
          if (window.BarkparkPaperMermaid) {
            window.BarkparkPaperMermaid.runMermaid.call(this);
          }
        },
        // runAsciicast: mount an asciinema player over any unprocessed
        // `div.bp-asciicast` inside this hook's element. Mirrors runMermaid:
        // registered on the streamed <article>, runs on mounted() + every
        // updated() delta — exactly when a new `asciicast` block's mount point
        // enters the DOM. Guarded for asciinema-player.min.js (deferred) not
        // being ready yet: we retry on window load.
        runAsciicast() {
          let mountPlayer = (el) => {
            let src = el.dataset.castSrc;
            if (!src) return;
            // `data-cast-poster` is the block's optional resting frame (an npt
            // timestamp, or "end"), emitted by Figures.asciicast_html only when
            // set — unset falls back to npt:0:1. Twin of client.ts's
            // hydrateAsciicast; keep the two in step.
            window.AsciinemaPlayer.create(src, el, {
              fit: "width",
              poster: el.dataset.castPoster || "npt:0:1",
              idleTimeLimit: 2,
              theme: "asciinema"
            });
            el.dataset.asciicastDone = "true";
          };
          let nodes = Array.from(
            this.el.querySelectorAll('div.bp-asciicast:not([data-asciicast-done="true"])')
          );
          if (!nodes.length) return;
          if (window.AsciinemaPlayer && window.AsciinemaPlayer.create) {
            nodes.forEach(mountPlayer);
          } else {
            // asciinema-player.min.js still deferred-loading — retry once ready.
            window.addEventListener("load", () => {
              if (window.AsciinemaPlayer && window.AsciinemaPlayer.create) {
                Array.from(
                  this.el.querySelectorAll('div.bp-asciicast:not([data-asciicast-done="true"])')
                ).forEach(mountPlayer);
              }
            }, { once: true });
          }
        },
        // runCodeTabs / runTabs: the I1 dual-hydration twin of
        // @barkpark/react/client's hydrateCodeTabs/hydrateTabs (client.ts) —
        // the SAME framework-free DOM-scan shape, reimplemented here rather
        // than shared (this hook has no npm dependency on @barkpark/react).
        // `compose.ex`'s :article leg for both blocks paints EVERY panel
        // visible (NO-JS DEGRADE); these two methods are what hide every
        // non-active panel and wire the click-to-switch strip, guarded by
        // `data-hydrated` so a stream `updated()` never re-wires a live tab
        // strip. code-tabs additionally persists the picked language to
        // localStorage under its `data-sync-key`, applying the stored choice
        // to every OTHER hydrated code-tabs element sharing the key (the
        // "choose npm once, every code-tabs block follows" pitch).
        selectCodeTabsLang(container, lang) {
          let panels = Array.from(container.querySelectorAll(".bp-code-tabs__panel"));
          let buttons = Array.from(container.querySelectorAll(".bp-code-tabs__tab"));
          let target = panels.some((p) => p.dataset.lang === lang)
            ? lang
            : (panels[0] ? panels[0].dataset.lang : "");
          buttons.forEach((btn) => {
            let active = btn.dataset.lang === target;
            btn.setAttribute("aria-selected", String(active));
            btn.classList.toggle("bp-code-tabs__tab--active", active);
          });
          panels.forEach((panel) => {
            if (panel.dataset.lang === target) panel.removeAttribute("hidden");
            else panel.setAttribute("hidden", "");
          });
        },
        runCodeTabs() {
          let containers = Array.from(
            this.el.querySelectorAll('div.bp-code-tabs:not([data-hydrated="true"])')
          );
          containers.forEach((container) => {
            let syncKey = container.dataset.syncKey || "";
            let firstPanel = container.querySelector(".bp-code-tabs__panel");
            let stored = null;
            if (syncKey) {
              try { stored = window.localStorage.getItem("bp-code-tabs:" + syncKey); } catch (e) { /* unavailable */ }
            }
            this.selectCodeTabsLang(container, stored || (firstPanel ? firstPanel.dataset.lang : ""));

            Array.from(container.querySelectorAll(".bp-code-tabs__tab")).forEach((btn) => {
              btn.addEventListener("click", () => {
                let lang = btn.dataset.lang || "";
                this.selectCodeTabsLang(container, lang);
                if (!syncKey) return;
                try { window.localStorage.setItem("bp-code-tabs:" + syncKey, lang); } catch (e) { /* unavailable */ }
                Array.from(
                  document.querySelectorAll('.bp-code-tabs[data-hydrated="true"]')
                ).forEach((other) => {
                  if (other !== container && other.dataset.syncKey === syncKey) {
                    this.selectCodeTabsLang(other, lang);
                  }
                });
              });
            });
            container.dataset.hydrated = "true";
          });
        },
        selectTabIndex(container, index) {
          let panels = Array.from(container.querySelectorAll(".bp-tabs__panel"));
          let buttons = Array.from(container.querySelectorAll(".bp-tabs__tab"));
          if (!panels.length) return;
          let clamped = Math.max(0, Math.min(index, panels.length - 1));
          buttons.forEach((btn, i) => {
            let active = i === clamped;
            btn.setAttribute("aria-selected", String(active));
            btn.classList.toggle("bp-tabs__tab--active", active);
          });
          panels.forEach((panel, i) => {
            if (i === clamped) panel.removeAttribute("hidden");
            else panel.setAttribute("hidden", "");
          });
        },
        runTabs() {
          let containers = Array.from(
            this.el.querySelectorAll('div.bp-tabs:not([data-hydrated="true"])')
          );
          containers.forEach((container) => {
            this.selectTabIndex(container, 0);
            Array.from(container.querySelectorAll(".bp-tabs__tab")).forEach((btn, i) => {
              btn.addEventListener("click", () => this.selectTabIndex(container, i));
            });
            container.dataset.hydrated = "true";
          });
        },
        mounted() { this.runMermaid(); this.runAsciicast(); this.runCodeTabs(); this.runTabs(); },
        updated() { this.runMermaid(); this.runAsciicast(); this.runCodeTabs(); this.runTabs(); }
      },

      // P6.U3 RailDiffSelect: shift-click two rail event rows to open a
      // line-diff of their payloads. A SHIFT+click marks a row (up to two:
      // .is-diff-a then .is-diff-b); the second shift+click pushes
      // "open-diff" {from, to} and clears the selection. A PLAIN click is left
      // entirely alone so the row's own phx-click="rail-select" still fires —
      // we only act (and only preventDefault) when the shift key is held.
      // Guarded for the no-document/SSR case the file already assumes.
      RailDiffSelect: {
        mounted() {
          if (typeof document === "undefined" || !this.el) return;
          this.selected = [];
          this.onClick = (e) => {
            if (!e.shiftKey) return; // plain click → rail-select unaffected
            let row = e.target.closest("[phx-value-event-id]");
            if (!row || !this.el.contains(row)) return;
            let id = row.getAttribute("phx-value-event-id");
            if (!id) return;
            // Shift+click is a diff-pick, not a select: swallow the event so it
            // doesn't also trigger the row's rail-select.
            e.preventDefault();
            e.stopPropagation();
            if (this.selected.length === 0) {
              this.clearMarks();
              row.classList.add("is-diff-a");
              this.selected = [id];
            } else if (this.selected.length === 1) {
              if (id === this.selected[0]) return; // same row twice → ignore
              row.classList.add("is-diff-b");
              this.pushEvent("open-diff", { from: this.selected[0], to: id });
              this.selected = [];
              this.clearMarks();
            }
          };
          // Capture phase so we intercept the shift+click before the row's own
          // phx-click handler runs.
          this.el.addEventListener("click", this.onClick, true);
        },
        clearMarks() {
          this.el.querySelectorAll(".is-diff-a, .is-diff-b").forEach((n) => {
            n.classList.remove("is-diff-a", "is-diff-b");
          });
        },
        destroyed() {
          if (this.el && this.onClick) {
            this.el.removeEventListener("click", this.onClick, true);
          }
        }
      }
    };

    // Mermaid theming for the reader. The palette, the engine init and the
    // re-render-from-stashed-source machinery all live in
    // /assets/bp-paper-mermaid.js (loaded above) — the reader configures its
    // two documented seams instead of carrying a second copy:
    //
    //   * isDark: the reader's EFFECTIVE mode, not the raw OS query. The
    //     pre-paint `data-theme` stamp (OS default, or the dark/light pill's
    //     persisted choice) wins; bare OS scheme is the fallback for the
    //     pathological no-stamp case.
    //   * autoScheme:false — the mode-toggle IIFE above fires `bp:mode` for
    //     toggle clicks AND for OS flips that actually change the effective
    //     mode (never for a no-op OS flip under a stored choice), so it, not
    //     the raw scheme listener, is the reader's re-render trigger.
    //
    // Guarded: a missing asset must never break the hooks map below.
    if (window.BarkparkPaperMermaid) {
      const readerScheme = window.matchMedia("(prefers-color-scheme: dark)");
      window.BarkparkPaperMermaid.isDark = () => {
        const t = document.documentElement.dataset.theme;
        return t ? t === "dark" : readerScheme.matches;
      };
      window.BarkparkPaperMermaid.autoScheme = false;
      // The asset's own deferred init runs on `load`, i.e. AFTER this line, so
      // it already picks up the resolver above; this call only matters for the
      // readyState==="complete" case (a cached, already-loaded page).
      window.BarkparkPaperMermaid.init();
      window.addEventListener("bp:mode", () => {
        window.BarkparkPaperMermaid.rerenderAll();
      });
    }

    // FinderGraph — the /finder corpus graph. bp-graph.js exports the LiveView
    // hook itself (window.BarkparkGraph, the same object Studio registers as
    // GraphPane); guarded so a missing asset never breaks the reader's hooks.
    if (window.BarkparkGraph) PaperHooks.FinderGraph = window.BarkparkGraph;

    let csrfToken = document.querySelector("meta[name='csrf-token']").getAttribute("content");
    let liveSocket = new LiveView.LiveSocket("/live", Phoenix.Socket, {
      params: { _csrf_token: csrfToken },
      hooks: PaperHooks
    });
    liveSocket.connect();
    // Expose for hooks / debugging (Wave 4 block-streaming).
    window.liveSocket = liveSocket;
  </script>
</body>
</html>
