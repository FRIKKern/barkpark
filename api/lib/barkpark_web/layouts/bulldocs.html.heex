<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content={get_csrf_token()} />
  <title>Paper · Barkpark</title>
  <%!-- asciinema-player CSS for `asciicast` blocks (a stylesheet, not a blocking
        <script> — the golden no-blocking-script-in-head rule covers JS; the
        player JS itself loads `defer` in the body alongside mermaid). Pinned to
        3.8.0, the version proven in .artifacts/proofs-index.html. --%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/asciinema-player@3.8.0/dist/bundle/asciinema-player.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; background: #0b0b0d; color: #e7e7ea;
           font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .bp-paper-shell { max-width: 820px; margin: 0 auto; padding: 32px 24px 96px; }

    <%!-- The ONE canonical paper-surface source (paper-surface.css via
          Barkpark.PortableDoc.Render.Stylesheet) — the SAME bytes Studio embeds.
          It provides the `--paper-*`/`--bp-*` tokens + `.bp-paper-surface`
          element rules. It is embedded BEFORE the reader skin below so the
          bp-theme `--paper-*` overrides (later + more specific) win. Surface
          CHROME (page bg/width/padding) is NOT in this source — the reader owns
          its own 820/720px shell above, so nothing here clobbers it. --%>
    <%= raw(Barkpark.PortableDoc.Render.Stylesheet.css()) %>

    /* Article chrome — applied only when BulldocsLive marks the doc as
       `content["style"] == "article"` (the LiveView stamps the
       `.bp-paper-article` class on its <main>). Cool bp-theme page, a
       centered ~720px reading column (incl. padding), serif base — so the
       inline-styled article blocks sit on a proper page, not bare white
       full-width. Non-article papers keep the dark chrome above, untouched.

       READER SKIN: token overrides layered over the canonical paper-surface
       source (embedded above). These `--paper-*` values are the historical
       bp-theme reader look. They are set on the <body> AND on the reader
       <main> (`.bp-paper-shell.bp-paper-article`, which now also carries
       `bp-paper-surface`) so they WIN over the shared source's fallback
       `.bp-paper-surface { --paper-* }` block — otherwise render.ex's inline
       `var(--paper-*, hex)` block HTML would resolve to the Studio defaults on
       the reader on the bp-theme (a shared ink #15211d, rule #dde7e2,
       etc.). Dark-mode note: the shared source keys dark on
       `html[data-theme="dark"]`, which the reader NEVER stamps — so the shared
       dark tokens never match here, and the `prefers-color-scheme: dark` block
       below (also carried onto <main>) is what owns reader dark mode, flipping
       the palette to cool bp-dark with light ink so the inline `var(--paper-*)`
       HTML stays readable. Without the <main>-scoped override the shared light
       fallback would paint dark ink on the browser's dark theme — the
       visibility bug. */
    body:has(.bp-paper-article),
    body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
      --paper-bg:         #f6faf9;
      --paper-bg-deep:    #eaf1ee;
      --paper-ink:        #15211d;
      --paper-ink-soft:   #55635e;
      --paper-rule:       #dde7e2;
      --paper-accent:     #1e5347;
      /* Link border-bottom tone (`.bp-paper-surface a` + walk.ex inline links
         read it). Light value matches the shared source's fallback; the dark
         block below MUST re-skin it — otherwise dark-mode link borders resolve
         to this light rgba and vanish against the dark page. */
      --paper-accent-soft: rgba(30, 83, 71, 0.10);
    }
    body:has(.bp-paper-article) {
      background: var(--paper-bg-deep);
      color: var(--paper-ink);
      font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Charter, Georgia, 'Source Serif 4', serif;
    }
    @media (prefers-color-scheme: dark) {
      body:has(.bp-paper-article),
      body:has(.bp-paper-article) .bp-paper-shell.bp-paper-article {
        --paper-bg:         #0e1614;
        --paper-bg-deep:    #131d19;
        --paper-ink:        #e7ede9;
        --paper-ink-soft:   #9aaaa3;
        --paper-rule:       rgba(231, 237, 233, 0.13);
        --paper-accent:     #45b394;
        /* Warm-dark link border (same value as Studio's html[data-theme=dark]
           block in paper-surface.css) — without it links keep the light-theme
           rgba(162,57,37,0.10) border, invisible on the dark page. */
        --paper-accent-soft: rgba(70, 179, 148, 0.16);
      }
    }
    .bp-paper-shell.bp-paper-article {
      max-width: 720px;
      padding: 56px 40px 96px;
      line-height: 1.65;
    }

    /* Native form block (grill / questionnaire). render.ex emits a render-only
       <section class="bp-form bp-form-grill|bp-form-questionnaire"> of
       <fieldset class="bp-form-question"> cards, each with a <legend> prompt,
       optional muted <p> rationale/recommendation lines, and controls
       (radio/checkbox <label> rows, <textarea>, scale radios). Scoped under
       `.bp-paper-article` so email / non-article papers stay untouched. The
       form reuses the article palette — bp-theme surface, evergreen accent,
       serif body, muted gray for secondary lines. Render-only: no JS, no
       :focus scripting, pure CSS. */
    .bp-paper-article .bp-form {
      margin: 2rem 0;
    }
    .bp-paper-article .bp-form-grill::before,
    .bp-paper-article .bp-form-questionnaire::before {
      content: "Grill";
      display: block;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #1e5347;
      margin-bottom: 0.9rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid rgba(162, 57, 37, 0.2);
    }
    .bp-paper-article .bp-form-questionnaire::before {
      content: "Questionnaire";
    }

    .bp-paper-article .bp-form-question {
      margin: 0 0 1.4rem;
      padding: 1.1rem 1.3rem;
      background: #fdfcf8;
      border: 1px solid rgba(26, 26, 26, 0.08);
      border-left: 3px solid #1e5347;
      border-radius: 6px;
    }
    .bp-paper-article .bp-form-question > legend {
      float: none;
      width: auto;
      padding: 0;
      margin: 0 0 0.5rem;
      font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Charter, Georgia, 'Source Serif 4', serif;
      font-size: 1.12rem;
      font-weight: 600;
      line-height: 1.4;
      color: #15211d;
    }

    /* Muted rationale / recommendation lines. render.ex stamps these as
       inline-styled <p> (color + font-size + margin); we lighten and italicize
       to read as secondary article asides without fighting the inline rules. */
    .bp-paper-article .bp-form-question > p {
      font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Charter, Georgia, 'Source Serif 4', serif;
      font-style: italic;
      color: #55635e;
      line-height: 1.5;
    }

    /* Choice rows — render.ex emits <label style="display:block;margin:…">
       wrapping an <input type=radio|checkbox> + <span>. One option per line,
       generous click target, subtle hover. */
    .bp-paper-article .bp-form-question label {
      display: flex;
      align-items: baseline;
      gap: 0.55rem;
      margin: 0.15rem 0;
      padding: 0.35rem 0.5rem;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.12s ease;
    }
    .bp-paper-article .bp-form-question label:hover {
      background: rgba(162, 57, 37, 0.06);
    }
    .bp-paper-article .bp-form-question label > input {
      accent-color: #1e5347;
      margin: 0;
      flex: 0 0 auto;
    }

    /* Free-text control — full reading-column width, article font. */
    .bp-paper-article .bp-form-question textarea {
      display: block;
      width: 100%;
      min-height: 4.5rem;
      margin-top: 0.4rem;
      padding: 0.6rem 0.7rem;
      font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Charter, Georgia, 'Source Serif 4', serif;
      font-size: 1rem;
      line-height: 1.55;
      color: #15211d;
      background: #fbfaf6;
      border: 1px solid rgba(26, 26, 26, 0.18);
      border-radius: 5px;
      resize: vertical;
    }

    /* P6.U5 action bar — the paper doc action buttons (Create plan /
       Grill / Build / Submit) rendered natively on the paper. A restrained
       sticky row at the top of the article column, in the article palette
       (bp-theme surface, evergreen accent, sans label). Scoped under
       `.bp-paper-article` so non-article papers stay untouched. The bar is
       rendered only when BulldocsLive derived a non-empty action set from
       content["source_doc"]. */
    .bp-paper-article .bp-paper-actions {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem;
      margin: 0 0 1.75rem;
      padding: 0.75rem 0;
      background: #fbfaf6;
      border-bottom: 1px solid rgba(162, 57, 37, 0.2);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .bp-paper-article .bp-paper-action {
      appearance: none;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: #1e5347;
      background: #fdfcf8;
      border: 1px solid rgba(162, 57, 37, 0.35);
      border-radius: 6px;
      padding: 0.45rem 0.9rem;
      transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
    }
    .bp-paper-article .bp-paper-action:hover {
      background: #1e5347;
      color: #fdfcf8;
      border-color: #1e5347;
    }
    .bp-paper-article .bp-paper-action:focus-visible {
      outline: 2px solid #1e5347;
      outline-offset: 2px;
    }
    .bp-paper-article .bp-paper-action-ack {
      font-size: 0.78rem;
      font-style: italic;
      color: #55635e;
      margin-left: 0.25rem;
    }

    /* P6.U4 Simplify control — a small row rendered for any goal-bearing
       paper (independent of the U5 doc-type action set). Reuses the
       `.bp-paper-action` button palette; the Accept/Reject pair appears only
       once a simplify-request is pending. Accept reads as the affirmative
       (filled terracotta on hover, like the other actions); Reject is muted
       gray so the destructive choice doesn't shout. Scoped under
       `.bp-paper-article` so non-article papers stay untouched. */
    .bp-paper-article .bp-paper-simplify {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem;
      margin: 0 0 1.75rem;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .bp-paper-article .bp-paper-simplify-decide {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .bp-paper-article .bp-paper-action-reject {
      color: #55635e;
      border-color: rgba(26, 26, 26, 0.18);
    }
    .bp-paper-article .bp-paper-action-reject:hover {
      background: #55635e;
      color: #fdfcf8;
      border-color: #55635e;
    }

    /* P6.U2 goal-path rail — a 240px sticky right-rail showing the paper's
       goal lifecycle as a Mermaid gitGraph plus a clickable event list. Scoped
       under `.bp-paper-article` so non-article papers are untouched. The shell
       centers a 720px reading column; the rail floats to the right of that
       column (offset via a negative right margin) and sticks while scrolling.
       On narrow viewports it falls back to a normal in-flow block under the
       article. The <aside> is a child of <main>, sibling of the <article>. */
    .bp-paper-article .bp-goal-rail {
      width: 240px;
      margin: 2.5rem 0 0 auto;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    @media (min-width: 1100px) {
      .bp-paper-article .bp-goal-rail {
        position: sticky;
        top: 56px;
        float: right;
        margin: 0 -300px 1.5rem 1.5rem;
      }
    }
    .bp-paper-article .bp-goal-rail-title {
      margin: 0 0 0.75rem;
      /* `inherit` re-takes the rail's sans stack: the shared paper-surface
         `.bp-paper-surface h1..h6 { font-family: var(--paper-font-serif) }`
         rule hits this <h2> DIRECTLY and would beat the sans the rail
         container only passes down by inheritance. Same story for
         line-height (shared `h2 { line-height: 1.2 }` vs the shell's 1.65). */
      font-family: inherit;
      line-height: inherit;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #1e5347;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid rgba(162, 57, 37, 0.2);
    }
    .bp-paper-article .bp-goal-rail #goal-path-graph {
      margin: 0 0 1rem;
    }
    .bp-paper-article .bp-goal-rail .mermaid {
      margin: 0;
      background: none;
      font-size: 0.8rem;
      /* Neutralize the shared `.bp-paper-surface pre` code-block chrome
         (border/padding/radius) — the rail's gitGraph is a naked 240px
         diagram, not a code block; without these it grows a bp-theme
         inset box. Reader-chrome override per charter Decision 5. */
      border: 0;
      border-radius: 0;
      padding: 0;
    }
    .bp-paper-article .bp-goal-rail-events {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .bp-paper-article .bp-goal-rail-event {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin: 0.1rem 0;
      padding: 0.35rem 0.5rem;
      border-radius: 4px;
      font-size: 0.85rem;
      color: #3a3a3a;
      cursor: pointer;
      transition: background 0.12s ease;
    }
    .bp-paper-article .bp-goal-rail-event:hover {
      background: rgba(162, 57, 37, 0.06);
    }
    .bp-paper-article .bp-goal-rail-event.is-selected {
      background: rgba(162, 57, 37, 0.12);
      box-shadow: inset 3px 0 0 #1e5347;
    }
    .bp-paper-article .bp-goal-rail-event-idx {
      flex: 0 0 auto;
      font-size: 0.72rem;
      font-weight: 600;
      color: #1e5347;
      min-width: 1.1em;
      text-align: right;
    }
    .bp-paper-article .bp-goal-rail-event-type {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.78rem;
    }

    /* P6.U3 diff selection markers — shift-clicking two rail rows marks them
       as the A / B endpoints of a diff. RailDiffSelect toggles these classes;
       they read as a subtle accent outline distinct from the plain
       `is-selected` highlight (which still fires on a non-shift click). */
    .bp-paper-article .bp-goal-rail-event.is-diff-a,
    .bp-paper-article .bp-goal-rail-event.is-diff-b {
      box-shadow: inset 3px 0 0 #2f7a4d;
      background: rgba(47, 122, 77, 0.1);
    }

    /* P6.U3 diff modal — opens when two rail nodes are shift-clicked. A
       full-viewport overlay (backdrop + centered panel) over the article. The
       diff body reuses the article palette: a bp-theme panel, monospace diff
       lines, restrained add/del/ctx coloring. Scoped under `.bp-paper-article`
       like the rest; the modal markup is a child of <main>. */
    .bp-paper-article .bp-diff-overlay {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .bp-paper-article .bp-diff-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(20, 18, 14, 0.55);
    }
    .bp-paper-article .bp-diff-panel {
      position: relative;
      z-index: 1;
      width: min(760px, 100%);
      max-height: 80vh;
      overflow: auto;
      background: #fdfcf8;
      border: 1px solid rgba(26, 26, 26, 0.12);
      border-radius: 8px;
      box-shadow: 0 12px 40px rgba(20, 18, 14, 0.3);
      padding: 1.25rem 1.5rem 1.5rem;
    }
    .bp-paper-article .bp-diff-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin: 0 0 1rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid rgba(162, 57, 37, 0.2);
    }
    .bp-paper-article .bp-diff-title {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      /* Pin against the shared `.bp-paper-surface h2 { line-height: 1.2 }`
         element rule (this <h2> sits inside the surface <main>). */
      line-height: inherit;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: #3a3a3a;
    }
    .bp-paper-article .bp-diff-from,
    .bp-paper-article .bp-diff-to {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: #1e5347;
    }
    .bp-paper-article .bp-diff-arrow {
      margin: 0 0.4rem;
      color: #8a8a8a;
    }
    .bp-paper-article .bp-diff-close {
      flex: 0 0 auto;
      border: none;
      background: none;
      font-size: 1.4rem;
      line-height: 1;
      color: #55635e;
      cursor: pointer;
      padding: 0 0.25rem;
      border-radius: 4px;
      transition: background 0.12s ease, color 0.12s ease;
    }
    .bp-paper-article .bp-diff-close:hover {
      background: rgba(162, 57, 37, 0.08);
      color: #1e5347;
    }

    /* The diff body itself — TextDiff.format_diff_html/1 emits
       <pre class="bp-diff"> of one <span class="bp-diff-line bp-diff-{…}">
       per line. Monospace, line-per-row, add greenish / del reddish / ctx
       muted — restrained so it reads as an article aside, not a terminal. */
    .bp-paper-article .bp-diff {
      margin: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.82rem;
      line-height: 1.5;
      white-space: pre-wrap;
      word-break: break-word;
      /* Neutralize the shared `.bp-paper-surface pre` code-block chrome —
         this diff is a naked aside inside the (always-light) modal panel;
         the shared bp-theme box would even resolve DARK here in dark mode
         (the tokens are main-scoped). Reader-chrome override, Decision 5. */
      background: none;
      border: 0;
      border-radius: 0;
      padding: 0;
    }
    .bp-paper-article .bp-diff-line {
      display: block;
      padding: 0 0.5rem;
      border-radius: 2px;
    }
    .bp-paper-article .bp-diff-add {
      background: rgba(47, 122, 77, 0.12);
      color: #1f5c39;
    }
    .bp-paper-article .bp-diff-del {
      background: rgba(162, 57, 37, 0.1);
      color: #8a2d1c;
    }
    .bp-paper-article .bp-diff-ctx {
      color: #55635e;
    }

    /* Sheet-embed default alignment. The walker (PortableDoc.Render.Walk)
       stamps these as CLASSES, never inline — the sheets-parity suite pins
       the inline b/i/bg/al styles identical across surfaces, and an explicit
       s.al (inline) outranks the class by CSS precedence. Mirror of the
       Studio grid's .sheet-cell.sheet-al-* rules (root.html.heex). */
    td.sheet-al-right { text-align: right; }
    td.sheet-al-center { text-align: center; }
  </style>
</head>
<body>
  {@inner_content}
  <%!-- Mermaid engine for `diagram` blocks. Loaded `defer` (NEVER a blocking
        <script> in <head> — golden rule). startOnLoad:false: the PaperMermaid
        hook runs it manually so it works with LiveView's streamed DOM, where
        diagram <pre> elements arrive AFTER the initial parse. --%>
  <script defer src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
  <%!-- asciinema-player engine for `asciicast` blocks. Same `defer` discipline
        as mermaid (NEVER blocking in <head>); the PaperMermaid hook's
        runAsciicast() mounts a player per `div.bp-asciicast`, with the same
        deferred-load retry guard. Pinned to 3.8.0 (proven CDN/version). --%>
  <script defer src="https://cdn.jsdelivr.net/npm/asciinema-player@3.8.0/dist/bundle/asciinema-player.min.js"></script>
  <script src="/assets/phoenix.js"></script>
  <script src="/assets/phoenix_live_view.js"></script>
  <script>
    // PaperMermaid: run Mermaid over any unprocessed `pre.mermaid` inside this
    // hook's element. Registered on the streamed <article>, so its mounted()
    // fires once and updated() fires on every stream delta — exactly when a new
    // `diagram` block's <pre class="mermaid"> enters the DOM. Guarded for the
    // case where mermaid.min.js (deferred) hasn't loaded yet: we retry on the
    // script's load event.
    let PaperHooks = {
      PaperMermaid: {
        runMermaid() {
          let nodes = Array.from(
            this.el.querySelectorAll('pre.mermaid:not([data-processed="true"])')
          );
          if (!nodes.length) return;
          if (window.mermaid && window.mermaid.run) {
            window.mermaid.run({ nodes });
          } else {
            // mermaid.min.js still deferred-loading — retry once it's ready.
            window.addEventListener("load", () => {
              if (window.mermaid && window.mermaid.run) {
                window.mermaid.run({
                  nodes: Array.from(
                    this.el.querySelectorAll('pre.mermaid:not([data-processed="true"])')
                  )
                });
              }
            }, { once: true });
          }
        },
        // runAsciicast: mount an asciinema player over any unprocessed
        // `div.bp-asciicast` inside this hook's element. Mirrors runMermaid:
        // registered on the streamed <article>, runs on mounted() + every
        // updated() delta — exactly when a new `asciicast` block's mount point
        // enters the DOM. Guarded for asciinema-player.min.js (deferred) not
        // being ready yet: we retry on window load.
        runAsciicast() {
          let mountPlayer = (el) => {
            let src = el.dataset.castSrc;
            if (!src) return;
            window.AsciinemaPlayer.create(src, el, {
              fit: "width",
              poster: "npt:0:1",
              idleTimeLimit: 2,
              theme: "asciinema"
            });
            el.dataset.asciicastDone = "true";
          };
          let nodes = Array.from(
            this.el.querySelectorAll('div.bp-asciicast:not([data-asciicast-done="true"])')
          );
          if (!nodes.length) return;
          if (window.AsciinemaPlayer && window.AsciinemaPlayer.create) {
            nodes.forEach(mountPlayer);
          } else {
            // asciinema-player.min.js still deferred-loading — retry once ready.
            window.addEventListener("load", () => {
              if (window.AsciinemaPlayer && window.AsciinemaPlayer.create) {
                Array.from(
                  this.el.querySelectorAll('div.bp-asciicast:not([data-asciicast-done="true"])')
                ).forEach(mountPlayer);
              }
            }, { once: true });
          }
        },
        mounted() { this.runMermaid(); this.runAsciicast(); },
        updated() { this.runMermaid(); this.runAsciicast(); }
      },

      // P6.U3 RailDiffSelect: shift-click two rail event rows to open a
      // line-diff of their payloads. A SHIFT+click marks a row (up to two:
      // .is-diff-a then .is-diff-b); the second shift+click pushes
      // "open-diff" {from, to} and clears the selection. A PLAIN click is left
      // entirely alone so the row's own phx-click="rail-select" still fires —
      // we only act (and only preventDefault) when the shift key is held.
      // Guarded for the no-document/SSR case the file already assumes.
      RailDiffSelect: {
        mounted() {
          if (typeof document === "undefined" || !this.el) return;
          this.selected = [];
          this.onClick = (e) => {
            if (!e.shiftKey) return; // plain click → rail-select unaffected
            let row = e.target.closest("[phx-value-event-id]");
            if (!row || !this.el.contains(row)) return;
            let id = row.getAttribute("phx-value-event-id");
            if (!id) return;
            // Shift+click is a diff-pick, not a select: swallow the event so it
            // doesn't also trigger the row's rail-select.
            e.preventDefault();
            e.stopPropagation();
            if (this.selected.length === 0) {
              this.clearMarks();
              row.classList.add("is-diff-a");
              this.selected = [id];
            } else if (this.selected.length === 1) {
              if (id === this.selected[0]) return; // same row twice → ignore
              row.classList.add("is-diff-b");
              this.pushEvent("open-diff", { from: this.selected[0], to: id });
              this.selected = [];
              this.clearMarks();
            }
          };
          // Capture phase so we intercept the shift+click before the row's own
          // phx-click handler runs.
          this.el.addEventListener("click", this.onClick, true);
        },
        clearMarks() {
          this.el.querySelectorAll(".is-diff-a, .is-diff-b").forEach((n) => {
            n.classList.remove("is-diff-a", "is-diff-b");
          });
        },
        destroyed() {
          if (this.el && this.onClick) {
            this.el.removeEventListener("click", this.onClick, true);
          }
        }
      }
    };

    // Initialise the engine in manual mode (startOnLoad:false). Wrapped so it's
    // a no-op if the deferred script isn't present yet — the hook re-checks.
    function initMermaid() {
      if (window.mermaid && window.mermaid.initialize) {
        window.mermaid.initialize({ startOnLoad: false, theme: "default" });
      }
    }
    if (document.readyState === "complete") initMermaid();
    else window.addEventListener("load", initMermaid, { once: true });

    let csrfToken = document.querySelector("meta[name='csrf-token']").getAttribute("content");
    let liveSocket = new LiveView.LiveSocket("/live", Phoenix.Socket, {
      params: { _csrf_token: csrfToken },
      hooks: PaperHooks
    });
    liveSocket.connect();
    // Expose for hooks / debugging (Wave 4 block-streaming).
    window.liveSocket = liveSocket;
  </script>
</body>
</html>
