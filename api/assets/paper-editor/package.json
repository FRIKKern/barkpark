{
  "name": "@barkpark/paper-editor",
  "version": "1.0.0",
  "description": "Barkpark paper editor: the <bp-paper-canvas> and <bp-paper-editor> custom elements as one prebuilt IIFE bundle plus stylesheet. Framework-neutral; see EMBED-CONTRACT.md.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FRIKKern/barkpark.git",
    "directory": "api/assets/paper-editor"
  },
  "homepage": "https://github.com/FRIKKern/barkpark/tree/main/api/assets/paper-editor#readme",
  "bugs": {
    "url": "https://github.com/FRIKKern/barkpark/issues"
  },
  "keywords": [
    "barkpark",
    "portabledoc",
    "editor",
    "tiptap",
    "web-component",
    "custom-element"
  ],
  "barkpark": {
    "contractVersion": "1.21.0"
  },
  "main": "./dist/bp-paper-editor.bundle.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/bp-paper-editor.bundle.js"
    },
    "./bundle": {
      "types": "./index.d.ts",
      "default": "./dist/bp-paper-editor.bundle.js"
    },
    "./bp-paper-editor.bundle.js": "./dist/bp-paper-editor.bundle.js",
    "./style.css": "./dist/bp-paper-editor.css",
    "./bp-paper-editor.css": "./dist/bp-paper-editor.css",
    "./shell.css": "./dist/bp-paper-editor-shell.css",
    "./bp-paper-editor-shell.css": "./dist/bp-paper-editor-shell.css",
    "./mermaid": "./dist/bp-paper-mermaid.js",
    "./bp-paper-mermaid.js": "./dist/bp-paper-mermaid.js",
    "./contract": {
      "types": "./contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./third-party-notices.json": "./third-party-notices.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "index.d.ts",
    "contract.d.ts",
    "EMBED-CONTRACT.md",
    "THIRD-PARTY-NOTICES.txt",
    "third-party-notices.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-bundle.mjs && esbuild src/styles.css --bundle --outfile=../../priv/static/assets/bp-paper-editor.css --minify && esbuild src/reader-code.js --bundle --format=iife --outfile=../../priv/static/assets/bp-paper-code.js --minify && esbuild ../paper-surface/paper-surface.css --bundle --outfile=../../priv/static/assets/bp-paper-surface.css --minify",
    "build:dev": "node scripts/build-bundle.mjs --dev && esbuild src/styles.css --bundle --outfile=../../priv/static/assets/bp-paper-editor.css --sourcemap && esbuild src/reader-code.js --bundle --format=iife --outfile=../../priv/static/assets/bp-paper-code.js --sourcemap && esbuild ../paper-surface/paper-surface.css --bundle --outfile=../../priv/static/assets/bp-paper-surface.css --sourcemap",
    "build:web": "npm run build && cp ../../priv/static/assets/bp-paper-editor.bundle.js ../../../web/public/bp-paper-editor.bundle.js && mkdir -p ../../../web/public/assets && cp ../../priv/static/assets/bp-paper-editor.css ../../../web/public/assets/bp-paper-editor.css",
    "test:reader-canvas-render": "MIX_ENV=test node src/__reader_canvas_render.mjs",
    "test:view-edit-parity": "MIX_ENV=test node src/__view_edit_parity_matrix.mjs",
    "smoke": "node src/__smoke.mjs",
    "nested-split:keys": "node src/__nested_split_keys.mjs",
    "narrow:render": "node src/__narrow_render.mjs",
    "fullbleed:render": "node src/__compose_fullbleed_render.mjs",
    "enter-empty-line:keys": "node src/__enter_empty_line_keys.mjs",
    "caret-before-keys:keys": "node src/__caret_before_keys_keys.mjs",
    "picker:render": "node src/canvas/__picker_footer_render.mjs",
    "test": "node scripts/test-chain.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "pack:stage": "node scripts/pack-stage.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "prepack": "npm run build && node scripts/third-party-notices.mjs --check && node scripts/pack-stage.mjs"
  },
  "devDependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-typography": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.0"
  }
}
