# Release runtime environment (T5.1 — Wave 5 personal-local packaging).
#
# This file is evaluated by every `bin/barkpark <command>` invocation BEFORE
# config/runtime.exs runs. Mix copies it into the release as `releases/<vsn>/env.sh`.
#
# We default PHX_SERVER=true so `bin/barkpark start` (and `bin/barkpark daemon`)
# actually bring up the Phoenix endpoint. runtime.exs only flips the endpoint's
# `server: true` flag when PHX_SERVER is set — without this line a release would
# boot the supervision tree but never listen on a port.
#
# `barkpark up` (bin/barkpark) sources ~/.barkpark/.env and exports
# DATABASE_URL for the managed Postgres before exec-ing the release, so we do
# NOT set those here — this file only carries release-invariant defaults.
export PHX_SERVER=true

# Uncomment to run a clustered release (see DNSCluster / dns_cluster_query).
# export RELEASE_DISTRIBUTION=name
# export RELEASE_NODE=barkpark@127.0.0.1
