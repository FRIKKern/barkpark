# Barkpark (self-hosted, docker compose) — environment template.
#
# Copy to `.env` and fill in real values before `docker compose up -d`. The
# values below are PLACEHOLDERS — never commit real secrets. `.env` is
# gitignored.
#
# api/config/runtime.exs (MIX_ENV=prod) RAISES at boot when a REQUIRED var is
# missing, so the container fails fast rather than serving half-configured.
#
# Two rules that hold for every value in this file:
#
#   1. Generate secrets with the command printed directly above each one. Do
#      not invent them by hand and do not reuse a value across two vars.
#   2. Never put a `$` character in a hand-typed password or secret. Compose
#      interpolates `$` in an env file, so `p$ssw0rd` silently becomes `p` +
#      an empty expansion — the value that reaches the container is TRUNCATED,
#      with no warning anywhere. Escape it as `$$` or, better, use only the
#      generated base64 values below (base64 never emits `$`).
#
# This deployment shape is experimental.

# ── REQUIRED — the container will not boot without these ──────────────────────

# Phoenix session/token signing base. MUST decode to at least 64 bytes: Plug
# checks the length LAZILY, at first session use — a short value boots clean,
# serves `/` fine, and then 500s the moment anyone hits /login. `-base64 64`
# yields an 88-character string, comfortably above that floor.
#   openssl rand -base64 64
SECRET_KEY_BASE=GENERATE_A_BASE64_64_BYTE_SECRET_DO_NOT_USE_THIS

# Cloak vault key — encrypts plugin settings and TOTP secrets at rest. A
# Base64 32-byte key, independent of every other secret here (rotating one
# never invalidates the others).
#   openssl rand -base64 32
BARKPARK_CLOAK_KEY=GENERATE_A_BASE64_32_BYTE_KEY_DO_NOT_USE_THIS

# Key-encryption key for field-level encryption (it wraps the envelope DEKs).
#   openssl rand -base64 32
#
# TRAP: BARKPARK_KEK MUST be base64 of EXACTLY 32 bytes (Barkpark.Crypto.LocalKek
# does Base.decode64 → <<_::256>>). `mix phx.gen.secret 32` emits a TRUNCATED
# 32-CHARACTER string (decodes to ~24 bytes), which LocalKek rejects → the app
# raises at boot. `openssl rand -base64 32` is exactly base64(32 bytes) — use it
# for this var even if you generate the others some other way.
BARKPARK_KEK=GENERATE_A_BASE64_32_BYTE_KEY_DO_NOT_USE_THIS

# Signer for draft-preview links.
#   openssl rand -base64 48
PREVIEW_JWT_SECRET=GENERATE_A_BASE64_48_BYTE_SECRET_DO_NOT_USE_THIS

# HMAC secret for release-capture payloads. At least 32 bytes.
#   openssl rand -base64 32
BARKPARK_RELEASE_CAPTURE_HMAC_SECRET=GENERATE_A_BASE64_32_BYTE_KEY_DO_NOT_USE_THIS

# Postgres connection, ecto:// scheme. The value below is the bundled `db`
# compose service — keep it as-is to use the container's own Postgres, or point
# it at an external server. Format: ecto://USER:PASS@HOST:PORT/DATABASE
# (a hand-typed PASS is exactly where the no-`$` rule above bites).
DATABASE_URL=ecto://postgres:postgres@db/barkpark_prod

# The public hostname this instance is reached at — a DNS name for a real
# deployment, or `localhost` when you only ever open it on this machine. It is
# NOT cosmetic: Phoenix whitelists exactly this host in Endpoint.check_origin,
# so a wrong value silently breaks Studio (the LiveView websocket 403s and the
# UI goes click-dead) while the HTTP API keeps answering normally — which is
# why the failure reads as "Studio is broken" and not as a config mistake.
PHX_HOST=your.hostname.example.com

# ── OPTIONAL — identity and boot behavior ─────────────────────────────────────

# `http` (default) or `https`. Set `https` only when something in front of this
# container actually terminates TLS: it also flips the session cookie to
# Secure, so `https` without real TLS means the cookie is never sent back and
# nobody stays logged in. With PHX_HOST set to a literal IPv4 address,
# PHX_SCHEME=https refuses to boot (browsers reject a cert for a bare IP).
PHX_SCHEME=http

# Host port the API is published on (the container always listens on 4000
# internally; this is the left side of the compose port mapping).
PORT=4000

# Boot-time seed profile. Legal values are `clean` and `demo` ONLY — any other
# string raises and the container refuses to boot. `clean` (the compose
# default) is an empty instance; `demo` loads the heavy demo dataset and wants
# noticeably more memory.
BARKPARK_SEED_PROFILE=clean

# Admin token bootstrap, first boot only.
#
#   set   → the seed installs exactly this token and never echoes it.
#   unset → the seed generates one and prints it ONCE to the container log.
#           Tokens are SHA256-hashed at rest, so that print is the only chance
#           to read it. Capture it with:
#             docker compose logs api | grep -i "admin token"
#
# An EMPTY value takes the print branch, so COMMENT THIS LINE OUT rather than
# leaving it blank — a blank line here reads like "no token" but is not.
#   BARKPARK_SEED_ADMIN_TOKEN=bp_admin_...

# ── TUNABLES — every line commented out on purpose ────────────────────────────
#
# These are defaults you rarely need to change. They stay COMMENTED rather than
# shipped as bare `NAME=` lines: an empty value is a real, meaningful value for
# several of them, and a bare line becomes live the moment this file is wired in
# as a compose `env_file`. Uncomment only what you are deliberately setting.

# Plugin selection — and the kill switch. Barkpark still works with every
# plugin off, which is exactly why the empty case is dangerous:
#
#   unset      → ALL plugins load (the default; this is what a commented line
#                gives you).
#   a list     → exactly those plugins, e.g. `bulldocs,media` (`media` is
#                unioned in automatically — it is core in disguise).
#   EMPTY      → NO plugins load, silently. So do `BARKPARK_PLUGINS=`, and so
#                do whitespace-only (`BARKPARK_PLUGINS=   `) and comma-only
#                (`BARKPARK_PLUGINS=,,`) values, because names are split on
#                commas, trimmed, and blanks dropped — all three parse to the
#                same empty list. There is no warning; Papers, Tasks and Media
#                just are not there.
#
# Comment the whole line out to mean "all plugins". Never blank it.
#   BARKPARK_PLUGINS=bulldocs,media

# Ecto connection pool size (default 10). Raise it only alongside Postgres's
# own max_connections.
#   POOL_SIZE=10

# Media blob root inside the container (defaults to the compiled api/uploads).
# The compose file already mounts a named volume there; change this only if you
# move that mount too, or your media lands somewhere the volume does not cover.
#   BARKPARK_MEDIA_DIR=/app/uploads

# Serve Studio to anonymous visitors instead of redirecting them to /login.
# Only sensible for a throwaway demo instance — it is a public read surface.
#   BARKPARK_PUBLIC_DEMO_STUDIO=true
