# Barkpark environment — copy to .env and fill in.
#   cp .env.example .env
#
# Docker Compose auto-loads this .env in the project dir for ${VAR}
# interpolation. The native installer (deploy.sh / scripts/install.sh) writes
# /opt/barkpark/.env directly; this file documents the same contract.
#
# Generate each secret with (from the api/ dir):  mix phx.gen.secret
# (use `mix phx.gen.secret 32` for BARKPARK_CLOAK_KEY).

# ── Required (prod boot RAISES if any of these is unset) ──────────────────────
# Database. Native: ...@localhost/barkpark_prod. Compose: ...@db/barkpark_prod.
DATABASE_URL=ecto://barkpark:CHANGE_ME@localhost/barkpark_prod

# Phoenix secret key base. mix phx.gen.secret
SECRET_KEY_BASE=

# Preview-link JWT secret (runtime.exs). mix phx.gen.secret
PREVIEW_JWT_SECRET=

# Cloak-at-rest key — MUST be independent of SECRET_KEY_BASE. mix phx.gen.secret 32
BARKPARK_CLOAK_KEY=

# Public DNS hostname — NEVER the bare IP when PHX_SCHEME=https (check_origin
# raises on IPv4 + https; see docs/ops/studio-nav-bug-2026-04-19.md).
PHX_HOST=cms.example.com
PHX_SCHEME=https
PORT=4000
MIX_ENV=prod

# ── Indx search sidecar (only when running the Indx engine) ───────────────────
# JWT signing key for the loopback Indx service. mix phx.gen.secret
Jwt__Key=

# ── Do NOT set ───────────────────────────────────────────────────────────────
# MEDIA_SIGNING_SECRET — auto-derives from SECRET_KEY_BASE (runtime.exs). Leave unset.

# ── Optional (have safe defaults) ────────────────────────────────────────────
# PREVIEW_JWT_TTL_SECONDS=600
