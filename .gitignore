# Binaries
/barkpark
# bin/ holds the committed launcher scripts (Wave 5 personal-local packaging),
# so we do NOT ignore the directory wholesale. Git can't re-include a file once
# its parent dir is excluded, so instead we ignore everything inside bin/ and
# then negate the two scripts we track. Compiled binaries dropped into bin/
# (e.g. by `air`) stay ignored by the wildcard.
bin/*
!bin/barkpark
!bin/barkpark-pg
*.exe
*.dll
*.so
*.dylib

# Erlang crash dumps (left by a failed BEAM boot)
erl_crash.dump

# Go
vendor/

# bp CLI release binaries (cross-compile artifacts — `make cli-release`)
dist/

# Air (hot reload)
tmp/

# Data
data.json

# Secrets
.env
# Local dev secrets (committed: secrets/*.env.example only)
secrets/*.env

# Phoenix API (Elixir)
api/_build/
api/deps/

# JS monorepo
node_modules/
packages/**/dist/
.artifacts/visual/**/node_modules/
*.log

# doc-truth P5 remake gate — transient reject log (kept out of git).
# Already covered by *.log above; named explicitly so its purpose is
# documented and an editor never re-adds it.
tooling/doc-truth/remake-failures.log

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
.worktrees/

# Dolt / DB artifacts
.dolt/
*.db

# Working artifacts — never commit (swept in accidentally by docs-refactor merge, removed 2026-06-10)
.artifacts/
api/.artifacts/
.fidelity-captures/
.visual-runtime/
.claude/scheduled_tasks.lock
api/.claude/
