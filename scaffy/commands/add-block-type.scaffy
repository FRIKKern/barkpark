COMMAND "Add PortableDoc Block Type" DESCRIPTION "Scaffold a new PortableDoc block type across all three required code surfaces — Go pdrender (renderer + named test + DefaultRegistry entry), JS react SDK (emitter + coreEmitters entry + fail-closed test parity), Elixir compose (one compose_block clause before the unknown-type catch-all) — plus the cross-surface golden-parity harness leg (@inputs fixture, both count pins, regenerated golden mirrors: the exact gate CI runs on any compose.ex diff, closing the local-green/CI-red gap), plus the three downstream count-sync sites the generated golden set feeds — the create-barkpark-app showcase seed, the cloud vendored template copy, and the type-keyed toPlainText partition — idempotently, with parity at birth: every surface emits the same starter form (the block's `text` in a `bp-<type>` wrapper)." LAST_UPDATED "17-07-2026-00-00-00" DOMAIN "barkpark" TAGS "portabledoc", "block", "render" CONCEPT "block-type" VARIANT "starter" DIRECTION "add" VARIABLES
  VARIABLE 1 "BlockName" TITLE "Name your block type" DESCRIPTION "PascalCase concept name. Drives every surface through the four spellings-as-transforms: {{.BlockName}} (Go test name, comments), {{.block-name}} (the PortableDoc `type` string, the `bp-` CSS class, MARK suffixes), {{.blockName}} (Go renderer type, JS emitter fn), {{.block_name}} (Go file paths — Go and Elixir paths derive via snake)." EXAMPLES "Timeline", "FactBox", "Milestone"
  VARIABLE 2 "CountBefore" OPAQUE TITLE "Registry count before this run" DESCRIPTION "The JS registry's current in-scope type count — the number inside expect(registered).toHaveLength(N) in js/packages/react/tests/PortableDoc.test.tsx (46 at authoring time). OPAQUE numeric literal, never re-cased. Scaffy has no arithmetic, so the count crosses as a declared pair; SUCCESSOR on CountAfter is what the validator lints." EXAMPLES "46"
  VARIABLE 3 "CountAfter" OPAQUE SUCCESSOR "CountBefore" TITLE "Registry count after this run" DESCRIPTION "CountBefore plus one — what the toHaveLength assertion must say once this block type is registered. OPAQUE numeric literal; SUCCESSOR declares the +1 relation the validator checks across the EXAMPLES pair." EXAMPLES "47"
  VARIABLE 4 "ParityCountBefore" OPAQUE TITLE "Golden-parity census before this run" DESCRIPTION "The compose-dispatch census the parity harness currently pins — the number in EXPECTED_COUNT= in scripts/pd-parity-completeness.sh AND inside `== N` in pd_golden_parity_test.exs (46 at authoring time). This SAME golden-dir-derived census also pins three downstream sites the gen_pd_parity golden set feeds: the three showcase-seed count assertions in create-barkpark-app's showcase-content.test.ts and the pd-golden corpus pin (`cases.length`) in react's toPlainText.typekeyed.test.ts — every count that tracks the golden-dir size moves as one. A DIFFERENT number line from the JS registry's CountBefore — the two pins move independently (compose.ex dispatches 60 types with 14 excluded; the react SDK scopes its own registry) and only coincidentally both read 46 today. OPAQUE numeric literal, never re-cased." EXAMPLES "46"
  VARIABLE 5 "ParityCountAfter" OPAQUE SUCCESSOR "ParityCountBefore" TITLE "Golden-parity census after this run" DESCRIPTION "ParityCountBefore plus one — what both parity count pins must say once the compose clause and its golden fixture exist. OPAQUE numeric literal; SUCCESSOR declares the +1 relation the validator checks across the EXAMPLES pair." EXAMPLES "47"
  VARIABLE 6 "TextlessSkipBefore" OPAQUE TITLE "toPlainText TEXTLESS_SKIP size before this run" DESCRIPTION "The textless half of the type-keyed toPlainText partition — the number inside `expect(Object.keys(TEXTLESS_SKIP).length).toBe(N)` in js/packages/react/tests/toPlainText.typekeyed.test.ts (28 at this amendment's authoring time; the prose half, 20-21, stays fixed). A THIRD independent number line: the starter block has no blockText clause so it extracts to '' → it is always classified TEXTLESS, so the textless half takes the +1 while the prose half does not. OPAQUE numeric literal, never re-cased." EXAMPLES "28"
  VARIABLE 7 "TextlessSkipAfter" OPAQUE SUCCESSOR "TextlessSkipBefore" TITLE "toPlainText TEXTLESS_SKIP size after this run" DESCRIPTION "TextlessSkipBefore plus one — what the textless-partition pin must say once the new type is added to the TEXTLESS_SKIP allow-list. OPAQUE numeric literal; SUCCESSOR declares the +1 relation the validator checks across the EXAMPLES pair." EXAMPLES "29"

# ─────────────────────────────────────────────────────────────────────────────
# WHAT THIS COMMAND HONESTLY DOES
#
# 3 required code surfaces + fail-closed JS test parity + the required
# golden-parity harness leg + the 3 downstream count-sync sites the generated
# golden set feeds (Surface 5) + optional CSS and classification. Never
# "4 surfaces auto-injected":
#
#   ● internal/pdrender/{{.block_name}}.go          created — Go renderer
#   ● internal/pdrender/{{.block_name}}_test.go     created — named Go test
#   ○ internal/pdrender/pdrender.go                 injected — DefaultRegistry entry
#   ○ js/packages/react/src/blocks/core.ts          injected ×2 — emitter + map entry
#   ○ js/packages/react/tests/PortableDoc.test.tsx  injected ×2 — CASES fixture + count bump
#   ○ api/lib/barkpark/portable_doc/render/compose.ex injected — compose_block clause
#   ○ api/lib/mix/tasks/barkpark.portable_doc.gen_pd_parity.ex injected — @inputs parity fixture
#   ○ scripts/pd-parity-completeness.sh             injected — EXPECTED_COUNT pin bump
#   ○ api/test/barkpark/portable_doc/render/pd_golden_parity_test.exs injected — census pin bump
#   ○ js/packages/create-barkpark-app/tests/showcase-content.test.ts injected ×3 — showcase census pins
#   ○ js/packages/react/tests/toPlainText.typekeyed.test.ts injected ×2 — corpus + textless-partition pins
#   ○ js/packages/react/tests/fixtures/pd-plaintext-golden.ts injected — TEXTLESS_SKIP allow-list entry
#
# The gen_pd_parity ASSERT CMD below additionally GENERATES (never injects) the
# frozen golden pair api/test/support/fixtures/pd-parity/{{.block-name}}.golden.json
# + js/packages/react/tests/fixtures/pd-golden/{{.block-name}}.golden.json —
# derived artifacts, receipt-unowned; manual step 5 is their rollback recipe.
#
# Surface 5's ASSERT CMDs GENERATE (never inject) two more receipt-unowned
# artifacts from that golden set: gen-showcase-content.mjs REWRITES the
# blog-starter showcase seed (js/packages/create-barkpark-app/templates/
# blog-starter/seeds/showcase-content.ts), and `make cloud-templates-sync`
# re-vendors that seed into cloud/priv/templates/blog-starter/. Manual step 5
# is their rollback too; the cloud vendored copy carries NO injected pin — it is
# a byte-mirror the drift ASSERT CMD proves clean.
#
# The JS surface is FAIL-CLOSED at four edits: the react test suite asserts
# CASES ≡ REGISTERED_TYPES and pins the exact count, so an emitter + map entry
# alone reds exactly one assertion (expect(registered).toHaveLength(N)). The Go
# registry is OPEN (no count test) and the Elixir clause set is OPEN (unknown
# types degrade through the catch-all) — for those two surfaces the MARK-planted
# injection is the whole story.
#
# The starter render is identical on every surface: the block's `text` attr in
# a `bp-{{.block-name}}` wrapper (terminal: sanitized + width-wrapped text).
# Grow each surface from its exemplar afterwards; the scaffold guarantees the
# block EXISTS everywhere with parity at birth, not that it is finished.
#
# GUARDS: every payload below plants a `scaffy:add-block-type … MARK:…` comment,
# so INSERT guards derive from the payload itself (D3c — the mark line IS the
# re-run check). The one REPLACE carries an explicit ASLONG because a REPLACE
# without a payload-derived guard is a lint error (A4).
#
# CONDITIONAL / MANUAL STEPS (prose, deliberately NOT blind ops — read these):
#
# 1. Composition tier (MANDATORY — ALWAYS run classify-block-type next). tiers.ex
#    classifies every block type as :element | :widget | :section
#    (api/lib/barkpark/portable_doc/tiers.ex). At RUNTIME an unclassified type
#    degrades safely to :element (slots.ex:98 — `tier_of(block) || :element`),
#    which once read as "a leaf block needs nothing" — WRONG for CI. A compose
#    clause (Surface 3 above) makes the type renderable, and tiers_test.exs pins
#    a completeness invariant ("completeness vs. the render surface" describe
#    block) that REDS on any renderable type with no tier. So classification is
#    NOT conditional: the moment Surface 3 lands, run
#    `bp scaffy run classify-block-type --var BlockName={{.block-name}}
#    --var Tier=<element|widget|section>` — leaf blocks pick :element EXPLICITLY,
#    never nothing. Run it once per block, always — any number of same-tier
#    classifies land cleanly since the tiers.ex append-friendly restructure
#    (classify v3; the D79 one-word hand-edit recipe is RETIRED).
#
# 2. walk.ex kind dispatch (conditional — NOT needed here). walk.ex only needs
#    a new clause for a NEW Pd node kind. This scaffold composes to the `_raw`
#    pre-rendered-HTML kind, which walk.ex already passes through verbatim
#    (walk.ex:153, `def walk(%{"kind" => "_raw", "html" => html}, …), do: html`
#    — the same hatch ~68 sibling compose clauses use). If you later replace
#    the starter with a genuinely new node kind, THAT is when walk.ex gets a
#    clause — by hand, next to its siblings.
#
# 3. Block-view CSS (optional). If the block needs styling beyond bare text,
#    add a rule to api/assets/paper-surface/paper-surface.css scoped as
#    `.bp-paper-surface .bp-{{.block-name}} { … }` (exemplar: `.bp-callout` at
#    paper-surface.css:213). NEVER inject root.html.heex — it has no per-type
#    anchor, only ad-hoc editor-affordance rules. The dummy-block proof run
#    rendered fine with zero CSS; this step is genuinely optional.
#
# 4. Count prose (optional tidy). Comments mention the two censuses in prose
#    and go stale by one: the test title "covers EXACTLY the 46 in-scope
#    types" (PortableDoc.test.tsx:340), the CASES doc comment ("all 46 render",
#    PortableDoc.test.tsx:12), the REGISTERED_TYPES doc comment ("the 46
#    in-scope", src/blocks/registry.ts:32) — and on the
#    parity side the "46" mentions in gen_pd_parity.ex's moduledoc, the
#    pd_golden_parity_test.exs test title "the array holds exactly 46 in-scope
#    types" + its moduledoc, and pd-parity-completeness.sh's comments. Cosmetic
#    — no assertion reads them; tidy them when you touch those files.
#
# 5. Derived parity fixtures (rollback recipe). The gen_pd_parity ASSERT CMD
#    writes the golden PAIR
#    api/test/support/fixtures/pd-parity/{{.block-name}}.golden.json +
#    js/packages/react/tests/fixtures/pd-golden/{{.block-name}}.golden.json.
#    These are DERIVED artifacts — the receipt does NOT own them (the mix task
#    wrote the bytes, not scaffy), so `bp scaffy remove` alone cannot retract
#    them. Nor are the two Surface-5 generated artifacts (the regenerated
#    showcase seed + its cloud vendored copy) receipt-owned. Full rollback:
#    (a) `bp scaffy remove` (inverts every .go/.ts/.tsx/.ex/.exs/.sh edit above,
#        including the Surface-5 pin bumps + the TEXTLESS_SKIP entry);
#    (b) trash the two generated golden fixture files by hand (the golden dir
#        now back to {{.ParityCountBefore}});
#    (c) `cd js/packages/create-barkpark-app && node scripts/gen-showcase-content.mjs`
#        (the seed reverts to the {{.ParityCountBefore}}-block body);
#    (d) `make cloud-templates-sync` (the vendored copy reverts with it);
#    (e) `bash scripts/pd-parity-completeness.sh` to prove the tree re-greened at
#        the original {{.ParityCountBefore}} census.
#
# 6. Growing the renderer STALES the golden — mandatory SECOND regen (NOT this
#    run). The @inputs sample this command plants
#    (`"text" => "Parity starter text"`) and the frozen golden pair both capture
#    the STARTER contract: `text` escaped into a `bp-{{.block-name}}` wrapper.
#    The moment you grow the compose clause / renderer past that starter (real
#    attrs, a real Pd-node composition), the surfaces stop emitting the starter
#    shape and pd_golden_parity_test.exs reds against the now-stale golden.
#    Growing is a SEPARATE, later edit than this scaffold, so its regen cannot
#    be pre-baked here — after you grow the block, by HAND:
#      (a) edit the {{.block-name}} entry in gen_pd_parity.ex's @inputs to the
#          grown block's real authored shape;
#      (b) `cd api && MIX_ENV=test CC=/usr/bin/clang mix barkpark.portable_doc.gen_pd_parity`
#          (rewrites BOTH golden mirrors from the new @inputs);
#      (c) `bash scripts/pd-parity-completeness.sh`;
#      (d) `cd api && CC=/usr/bin/clang mix test test/barkpark/portable_doc/render/pd_golden_parity_test.exs`.
#    NO census bump this time — the type already exists; only the golden bytes
#    change. Skip this and the grow PR ships a green local scaffold over a red CI.
#
# 7. Growing the block into PROSE moves it out of TEXTLESS_SKIP (NOT this run).
#    This scaffold classifies the new type into the toPlainText TEXTLESS_SKIP
#    allow-list (Surface 5) because the starter has NO `blockText` dispatch
#    clause in js/packages/react/src/toPlainText.ts — so toPlainText returns ''
#    for it, honestly textless AT BIRTH. If you later grow the block to carry
#    reading-flow prose (an excerpt/SEO-meta/search-index would want its text),
#    that is a SEPARATE, later edit: by HAND (a) add a `case '{{.block-name}}':`
#    clause to `blockText` returning the block's prose; (b) move the
#    `'{{.block-name}}'` key from TEXTLESS_SKIP to PROSE_GOLDEN in
#    js/packages/react/tests/fixtures/pd-plaintext-golden.ts with the exact
#    expected string (derived from THIS type's frozen pd-golden `.input`); (c)
#    flip the two partition pins in toPlainText.typekeyed.test.ts (prose +1,
#    textless −1 — the corpus pin does NOT move, the type already counts). The
#    partition test reds until the type is in EXACTLY ONE half, so a half-done
#    migration cannot ship green.
# ─────────────────────────────────────────────────────────────────────────────

# ── Surface 1: Go (internal/pdrender) ────────────────────────────────────────

# Topical renderer file. Implements the Renderer interface
# (pdrender.go:168-170; the `Render(b Block, ctx RenderCtx) []string`
# signature is :169). Modeled on
# eyebrowRenderer (richblocks.go:389) — the minimal single-attr exemplar; see
# gaugelist.go for a full data block. Helpers used: attrStr (attrs.go:16),
# sanitizeText (inline.go:427 — strips control bytes so a hostile `text` can't
# inject ANSI), wrapLines (blocks.go:15).
CREATE FILE IF ABSENT "internal/pdrender/{{.block_name}}.go"
WITH
::: {{.block-name}} renderer :::
package pdrender

// ── {{.block-name}} ─────────────────────────────────────────────────────────
// Mirrors compose_block({{.block-name}}) (compose.ex): the starter render is
// the block's `text` attr, sanitized and width-wrapped. Empty text renders
// nothing (honest empty state — no phantom blank line in the document flow).
// Grow this into the block's real terminal form; eyebrowRenderer
// (richblocks.go) shows themed styling, gaugelist.go a full data block.
type {{.blockName}}Renderer struct{}

func ({{.blockName}}Renderer) Render(b Block, ctx RenderCtx) []string {
	text := sanitizeText(attrStr(b.Attrs, "text"))
	if text == "" {
		return nil
	}
	return wrapLines(text, ctx.Width)
}
::: {{.block-name}} renderer :::

# Named test — the scoped ASSERT CMD below runs exactly this (never the whole
# pdrender suite: worktree-pollution red). testRegistry() (render_test.go:27)
# pins the lipgloss profile so output is byte-stable; going through the
# registry (not the bare struct) also proves the DefaultRegistry injection.
CREATE FILE IF ABSENT "internal/pdrender/{{.block_name}}_test.go"
WITH
::: {{.block-name}} test :::
package pdrender

import (
	"strings"
	"testing"

	"github.com/charmbracelet/x/ansi"
)

// Test{{.BlockName}}Renderer proves the {{.block-name}} block renders its text
// THROUGH the registry — one assertion covering both the renderer and its
// DefaultRegistry registration.
func Test{{.BlockName}}Renderer(t *testing.T) {
	reg := testRegistry()
	b := Block{Type: "{{.block-name}}", Attrs: map[string]any{"text": "hello from {{.block-name}}"}}
	got := ansi.Strip(strings.Join(reg.Render(b, RenderCtx{Width: 60, Theme: DarkTheme(), Profile: NoColor}), "\n"))
	if !strings.Contains(got, "hello from {{.block-name}}") {
		t.Fatalf("{{.block-name}} render missing text, got %q", got)
	}
}

// Test{{.BlockName}}RendererEmptyIsSilent pins the honest empty state: a
// {{.block-name}} block with no text contributes zero lines.
func Test{{.BlockName}}RendererEmptyIsSilent(t *testing.T) {
	reg := testRegistry()
	b := Block{Type: "{{.block-name}}", Attrs: map[string]any{}}
	if lines := reg.Render(b, RenderCtx{Width: 60, Theme: DarkTheme(), Profile: NoColor}); len(lines) != 0 {
		t.Fatalf("empty {{.block-name}} should render nothing, got %d lines", len(lines))
	}
}
::: {{.block-name}} test :::

# Register in the DefaultRegistry block map (pdrender.go:249-389). The map is
