COMMAND "Add PortableDoc Block Type" DESCRIPTION "Scaffold a new PortableDoc block type across all three required code surfaces — Go pdrender (renderer + named test + DefaultRegistry entry), JS react SDK (emitter + coreEmitters entry + fail-closed test parity), Elixir compose (one compose_block clause before the unknown-type catch-all) — plus the cross-surface golden-parity harness leg (@inputs fixture, both count pins, regenerated golden mirrors: the exact gate CI runs on any compose.ex diff, closing the local-green/CI-red gap) — idempotently, with parity at birth: every surface emits the same starter form (the block's `text` in a `bp-<type>` wrapper)." LAST_UPDATED "17-07-2026-00-00-00" DOMAIN "barkpark" TAGS "portabledoc", "block", "render" CONCEPT "block-type" VARIANT "starter" DIRECTION "add" VARIABLES
  VARIABLE 1 "BlockName" TITLE "Name your block type" DESCRIPTION "PascalCase concept name. Drives every surface through the four spellings-as-transforms: {{.BlockName}} (Go test name, comments), {{.block-name}} (the PortableDoc `type` string, the `bp-` CSS class, MARK suffixes), {{.blockName}} (Go renderer type, JS emitter fn), {{.block_name}} (Go file paths — Go and Elixir paths derive via snake)." EXAMPLES "Timeline", "FactBox", "Milestone"
  VARIABLE 2 "CountBefore" OPAQUE TITLE "Registry count before this run" DESCRIPTION "The JS registry's current in-scope type count — the number inside expect(registered).toHaveLength(N) in js/packages/react/tests/PortableDoc.test.tsx (46 at authoring time). OPAQUE numeric literal, never re-cased. Scaffy has no arithmetic, so the count crosses as a declared pair; SUCCESSOR on CountAfter is what the validator lints." EXAMPLES "46"
  VARIABLE 3 "CountAfter" OPAQUE SUCCESSOR "CountBefore" TITLE "Registry count after this run" DESCRIPTION "CountBefore plus one — what the toHaveLength assertion must say once this block type is registered. OPAQUE numeric literal; SUCCESSOR declares the +1 relation the validator checks across the EXAMPLES pair." EXAMPLES "47"
  VARIABLE 4 "ParityCountBefore" OPAQUE TITLE "Golden-parity census before this run" DESCRIPTION "The compose-dispatch census the parity harness currently pins — the number in EXPECTED_COUNT= in scripts/pd-parity-completeness.sh AND inside `== N` in pd_golden_parity_test.exs (46 at authoring time). A DIFFERENT number line from the JS registry's CountBefore — the two pins move independently (compose.ex dispatches 60 types with 14 excluded; the react SDK scopes its own registry) and only coincidentally both read 46 today. OPAQUE numeric literal, never re-cased." EXAMPLES "46"
  VARIABLE 5 "ParityCountAfter" OPAQUE SUCCESSOR "ParityCountBefore" TITLE "Golden-parity census after this run" DESCRIPTION "ParityCountBefore plus one — what both parity count pins must say once the compose clause and its golden fixture exist. OPAQUE numeric literal; SUCCESSOR declares the +1 relation the validator checks across the EXAMPLES pair." EXAMPLES "47"

# ─────────────────────────────────────────────────────────────────────────────
# WHAT THIS COMMAND HONESTLY DOES
#
# 3 required code surfaces + fail-closed JS test parity + the required
# golden-parity harness leg + optional CSS and classification. Never
# "4 surfaces auto-injected":
#
#   ● internal/pdrender/{{.block_name}}.go          created — Go renderer
#   ● internal/pdrender/{{.block_name}}_test.go     created — named Go test
#   ○ internal/pdrender/pdrender.go                 injected — DefaultRegistry entry
#   ○ js/packages/react/src/blocks/core.ts          injected ×2 — emitter + map entry
#   ○ js/packages/react/tests/PortableDoc.test.tsx  injected ×2 — CASES fixture + count bump
#   ○ api/lib/barkpark/portable_doc/render/compose.ex injected — compose_block clause
#   ○ api/lib/mix/tasks/barkpark.portable_doc.gen_pd_parity.ex injected — @inputs parity fixture
#   ○ scripts/pd-parity-completeness.sh             injected — EXPECTED_COUNT pin bump
#   ○ api/test/barkpark/portable_doc/render/pd_golden_parity_test.exs injected — census pin bump
#
# The gen_pd_parity ASSERT CMD below additionally GENERATES (never injects) the
# frozen golden pair api/test/support/fixtures/pd-parity/{{.block-name}}.golden.json
# + js/packages/react/tests/fixtures/pd-golden/{{.block-name}}.golden.json —
# derived artifacts, receipt-unowned; manual step 5 is their rollback recipe.
#
# The JS surface is FAIL-CLOSED at four edits: the react test suite asserts
# CASES ≡ REGISTERED_TYPES and pins the exact count, so an emitter + map entry
# alone reds exactly one assertion (expect(registered).toHaveLength(N)). The Go
# registry is OPEN (no count test) and the Elixir clause set is OPEN (unknown
# types degrade through the catch-all) — for those two surfaces the MARK-planted
# injection is the whole story.
#
# The starter render is identical on every surface: the block's `text` attr in
# a `bp-{{.block-name}}` wrapper (terminal: sanitized + width-wrapped text).
# Grow each surface from its exemplar afterwards; the scaffold guarantees the
# block EXISTS everywhere with parity at birth, not that it is finished.
#
# GUARDS: every payload below plants a `scaffy:add-block-type … MARK:…` comment,
# so INSERT guards derive from the payload itself (D3c — the mark line IS the
# re-run check). The one REPLACE carries an explicit ASLONG because a REPLACE
# without a payload-derived guard is a lint error (A4).
#
# CONDITIONAL / MANUAL STEPS (prose, deliberately NOT blind ops — read these):
#
# 1. Composition tier (conditional). tiers.ex classifies every block type as
#    :element | :widget | :section (api/lib/barkpark/portable_doc/tiers.ex).
#    An UNCLASSIFIED type degrades safely to :element (slots.ex:98 —
#    `tier_of(block) || :element`), so a leaf block needs nothing. Add
#    "{{.block-name}}" to the tiers.ex word-list ONLY if the block composes
#    other blocks (:widget) or owns its children's layout (:section).
#
# 2. walk.ex kind dispatch (conditional — NOT needed here). walk.ex only needs
#    a new clause for a NEW Pd node kind. This scaffold composes to the `_raw`
#    pre-rendered-HTML kind, which walk.ex already passes through verbatim
#    (walk.ex:153, `def walk(%{"kind" => "_raw", "html" => html}, …), do: html`
#    — the same hatch ~68 sibling compose clauses use). If you later replace
#    the starter with a genuinely new node kind, THAT is when walk.ex gets a
#    clause — by hand, next to its siblings.
#
# 3. Block-view CSS (optional). If the block needs styling beyond bare text,
#    add a rule to api/assets/paper-surface/paper-surface.css scoped as
#    `.bp-paper-surface .bp-{{.block-name}} { … }` (exemplar: `.bp-callout` at
#    paper-surface.css:213). NEVER inject root.html.heex — it has no per-type
#    anchor, only ad-hoc editor-affordance rules. The dummy-block proof run
#    rendered fine with zero CSS; this step is genuinely optional.
#
# 4. Count prose (optional tidy). Comments mention the two censuses in prose
#    and go stale by one: the test title "covers EXACTLY the 46 in-scope
#    types" (PortableDoc.test.tsx:340), the CASES doc comment ("all 46 render",
#    PortableDoc.test.tsx:12), the REGISTERED_TYPES doc comment ("the 46
#    in-scope", src/blocks/registry.ts:32) — and on the
#    parity side the "46" mentions in gen_pd_parity.ex's moduledoc, the
#    pd_golden_parity_test.exs test title "the array holds exactly 46 in-scope
#    types" + its moduledoc, and pd-parity-completeness.sh's comments. Cosmetic
#    — no assertion reads them; tidy them when you touch those files.
#
# 5. Derived parity fixtures (rollback recipe). The gen_pd_parity ASSERT CMD
#    writes the golden PAIR
#    api/test/support/fixtures/pd-parity/{{.block-name}}.golden.json +
#    js/packages/react/tests/fixtures/pd-golden/{{.block-name}}.golden.json.
#    These are DERIVED artifacts — the receipt does NOT own them (the mix task
#    wrote the bytes, not scaffy), so `bp scaffy remove` alone cannot retract
#    them. Full rollback is three moves: `bp scaffy remove` (inverts every
#    .go/.ts/.tsx/.ex/.exs/.sh edit above), trash the two generated fixture
#    files by hand, then re-run `bash scripts/pd-parity-completeness.sh` to
#    prove the tree re-greened at the original {{.ParityCountBefore}} census.
# ─────────────────────────────────────────────────────────────────────────────

# ── Surface 1: Go (internal/pdrender) ────────────────────────────────────────

# Topical renderer file. Implements the Renderer interface
# (pdrender.go:168-170; the `Render(b Block, ctx RenderCtx) []string`
# signature is :169). Modeled on
# eyebrowRenderer (richblocks.go:389) — the minimal single-attr exemplar; see
# gaugelist.go for a full data block. Helpers used: attrStr (attrs.go:16),
# sanitizeText (inline.go:427 — strips control bytes so a hostile `text` can't
# inject ANSI), wrapLines (blocks.go:15).
CREATE FILE IF ABSENT "internal/pdrender/{{.block_name}}.go"
WITH
::: {{.block-name}} renderer :::
package pdrender

// ── {{.block-name}} ─────────────────────────────────────────────────────────
// Mirrors compose_block({{.block-name}}) (compose.ex): the starter render is
// the block's `text` attr, sanitized and width-wrapped. Empty text renders
// nothing (honest empty state — no phantom blank line in the document flow).
// Grow this into the block's real terminal form; eyebrowRenderer
// (richblocks.go) shows themed styling, gaugelist.go a full data block.
type {{.blockName}}Renderer struct{}

func ({{.blockName}}Renderer) Render(b Block, ctx RenderCtx) []string {
	text := sanitizeText(attrStr(b.Attrs, "text"))
	if text == "" {
		return nil
	}
	return wrapLines(text, ctx.Width)
}
::: {{.block-name}} renderer :::

# Named test — the scoped ASSERT CMD below runs exactly this (never the whole
# pdrender suite: worktree-pollution red). testRegistry() (render_test.go:27)
# pins the lipgloss profile so output is byte-stable; going through the
# registry (not the bare struct) also proves the DefaultRegistry injection.
CREATE FILE IF ABSENT "internal/pdrender/{{.block_name}}_test.go"
WITH
::: {{.block-name}} test :::
package pdrender

import (
	"strings"
	"testing"

	"github.com/charmbracelet/x/ansi"
)

// Test{{.BlockName}}Renderer proves the {{.block-name}} block renders its text
// THROUGH the registry — one assertion covering both the renderer and its
// DefaultRegistry registration.
func Test{{.BlockName}}Renderer(t *testing.T) {
	reg := testRegistry()
	b := Block{Type: "{{.block-name}}", Attrs: map[string]any{"text": "hello from {{.block-name}}"}}
	got := ansi.Strip(strings.Join(reg.Render(b, RenderCtx{Width: 60, Theme: DarkTheme(), Profile: NoColor}), "\n"))
	if !strings.Contains(got, "hello from {{.block-name}}") {
		t.Fatalf("{{.block-name}} render missing text, got %q", got)
	}
}

// Test{{.BlockName}}RendererEmptyIsSilent pins the honest empty state: a
// {{.block-name}} block with no text contributes zero lines.
func Test{{.BlockName}}RendererEmptyIsSilent(t *testing.T) {
	reg := testRegistry()
	b := Block{Type: "{{.block-name}}", Attrs: map[string]any{}}
	if lines := reg.Render(b, RenderCtx{Width: 60, Theme: DarkTheme(), Profile: NoColor}); len(lines) != 0 {
		t.Fatalf("empty {{.block-name}} should render nothing, got %d lines", len(lines))
	}
}
::: {{.block-name}} test :::

# Register in the DefaultRegistry block map (pdrender.go:249-389). The map is
# OPEN — assignments are order-independent and there is no count test (a 43rd
# type left the full suite green in the proof run). Anchor is the heading
# registration, the map's first and structurally most stable line (unique,
# grep -cF = 1). Guard derives from the payload's MARK line.
IN "internal/pdrender/pdrender.go"
### Register {{.block-name}} in the DefaultRegistry block map
INSERT AFTER FIRST
::: registry head anchor :::
	r.blocks["heading"] = headingRenderer{ir: ir}
::: registry head anchor :::
WITH
::: {{.block-name}} registration :::
	// scaffy:add-block-type {{.BlockName}} MARK:go-registry-{{.block-name}}
	r.blocks["{{.block-name}}"] = {{.blockName}}Renderer{}
::: {{.block-name}} registration :::
MARK "go-registry-{{.block-name}}"

# ── Surface 2: JS (js/packages/react) — FAIL-CLOSED, all four edits ─────────

# Edit 1/4: the emitter function. Anchor is the eyebrow emitter (core.ts:46,
