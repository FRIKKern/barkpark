{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "tsup.config.ts",
        "package.json",
        "tsconfig.json",
        "astro.config.mjs",
        "$TURBO_ROOT$/packages/react/tests/fixtures/pd-golden/**"
      ]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "src/**",
        "tests/**",
        "dist/**",
        "vitest.config.ts",
        "vitest.browser.config.ts",
        "vitest.workerd.config.ts",
        "wrangler.toml",
        "$TURBO_ROOT$/packages/react/tests/fixtures/pd-golden/**",
        "$TURBO_ROOT$/packages/react/tests/support/**"
      ]
    }
  }
}
