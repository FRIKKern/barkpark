    jobId?: string;
    lastCallbackAt?: string;
    provider?: string;
  };
  /** Processing status */
  bp_processing_status?: "failed" | "processing" | "ready";
  /** Delivery visibility */
  bp_visibility?: "private" | "public" | "token";
  /** Caption */
  caption?: Partial<Record<"eng" | "nob", string>>;
  /** Checked out at */
  checkedOutAt?: string;
  /** Checked out by */
  checkedOutBy?: string;
  /** Primary collection */
  collection?: BarkparkReference;
  /** Collections */
