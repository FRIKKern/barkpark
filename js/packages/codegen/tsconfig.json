{
  "extends": "../../tsconfig.base.json",
  // Both `test/**/*` (11 files) and `tests/**/*` (3) — this package really does
  // have both dirs. The build configs are here too because eslint runs with
  // `projectService: true`: a file outside every tsconfig `include` is a
  // PARSING ERROR, not a lint pass, so `lint` can only reach them from here.
  //
  // `lint` once carried a trailing `--ignore-pattern` for
  // `test/pinned-collator.test.ts` — turning the gate on over `test/` for the
  // first time found a dead binding in it. Both the binding and the flag are
  // gone (task-b48b8587e0935449); every file this `include` reaches is linted,
  // with no exclusions. Do not reintroduce one: pinned-collator.test.ts asserts
  // the `lint` script has no `--ignore-pattern`, so a new escape reds the suite.
  "include": ["src/**/*", "tests/**/*", "test/**/*", "tsup.config.ts", "vitest.config.ts"],
  "compilerOptions": {
    "rootDir": "."
  }
}
