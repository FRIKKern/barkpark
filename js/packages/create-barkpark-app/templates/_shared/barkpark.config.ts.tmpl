import { createClient } from '@barkpark/core'

const projectUrl = process.env.BARKPARK_API_URL ?? 'http://localhost:4000'
const dataset = process.env.BARKPARK_DATASET ?? 'production'

// Multi-workspace servers: uncomment these and set BARKPARK_SERVER_TOKEN.
// When both are set the client scopes every request to
// /w/<workspace>/p/<project>/v1/... which requires a token even for public
// reads. Leave them unset (or blank) to use the flat /v1/... path that works
// out-of-the-box against any Barkpark server.
//
// const workspace = process.env.BARKPARK_WORKSPACE
// const project   = process.env.BARKPARK_PROJECT

export const barkparkClient = createClient({
  projectUrl,
  dataset,
  apiVersion: '2026-01-01',
})

export const projectConfig = {
  name: '{{projectName}}',
  dataset,
  projectUrl,
}
