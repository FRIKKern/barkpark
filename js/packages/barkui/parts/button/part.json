{
  "name": "button",
  "family": "action",
  "element": "ui-button",
  "imports": ["@ui-sdk/web/button"],
  "summary": "Runs an action: primary, secondary, quiet and destructive, in three sizes, with a pending state that refuses a second press.",
  "textOnly": ["[data-variant=\"ghost\"]"],
  "paint": [
    { "selector": "#button-primary", "background-color": "--ui-primary", "color": "--ui-primary-foreground" },
    { "selector": "#button-secondary", "background-color": "--ui-background", "color": "--ui-foreground", "border-top-color": "--ui-input" },
    { "selector": "#button-quiet", "color": "--ui-foreground" },
    { "selector": "#button-destructive", "background-color": "--bark-danger-soft", "color": "--bark-danger-text" },
    { "selector": "#button-disabled", "background-color": "--ui-muted", "color": "--ui-muted-foreground" }
  ]
}
