{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "tsup.config.ts",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/scripts/post-build-dts.mjs",
        "$TURBO_ROOT$/../api/assets/paper-surface/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "src/**",
        "tests/**",
        "test/**",
        "templates/**",
        "tsconfig*.json",
        "dist/**",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "src/**",
        "tests/**",
        "test/**",
        "templates/**",
        "vitest*.config.*",
        "wrangler.toml",
        "README.md",
        "CHANGELOG.md",
        "dist/**",
        "$TURBO_ROOT$/.changeset/**",
        "$TURBO_ROOT$/test-utils/**",
        "$TURBO_ROOT$/../api/assets/paper-surface/**"
      ]
    }
  }
}
