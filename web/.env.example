# Public Barkpark API base URL (browser-exposed; used by SSR + client builds).
# Production: https://api.barkpark.cloud
# Local dev:  http://localhost:4000
NEXT_PUBLIC_API_URL=https://api.barkpark.cloud

# Server-side read token. SERVER-ONLY (no NEXT_PUBLIC_ prefix → never bundled to
# the browser). Passed into the @barkpark/core client as `token`, sent as
# `Authorization: Bearer <token>` on every SSR fetch. Required for the scoped
# `/w/:workspace/p/:project/...` routes and the workspace/project switcher's
# tenancy fetches — without it those go anonymous and the API returns 403/401.
# Single-server-token model: all SSR requests share this one read token
# (per-user / per-request tokens would be a separate auth design).
# Unset → anonymous reads (flat public `/` routes still work).
# The token also authenticates the same-origin SSE proxy
# (app/v1/data/listen/[dataset]/route.ts) for live updates — it must carry
# `listen` permission for that to work.
# BARKPARK_READ_TOKEN=

# Live updates (@barkpark/nextjs <BarkparkLive/>). Browser-exposed flag, OFF by
# default. Set to "1" ONLY once BARKPARK_READ_TOKEN (with listen permission) is
# provisioned — otherwise the client retry-loops the listen stream and logs
# 406s. With both set, content changes auto-refresh the flat published surface.
# NEXT_PUBLIC_BARKPARK_LIVE=0

