# Public Barkpark API base URL (browser-exposed; used by SSR + client builds).
# Production: https://api.barkpark.cloud
# Local dev:  http://localhost:4000
NEXT_PUBLIC_BARKPARK_API_URL=https://api.barkpark.cloud
# DEPRECATED alias — still read as a fallback (lib/bp-env.ts) so an existing
# Vercel deployment keeps working; prefer NEXT_PUBLIC_BARKPARK_API_URL above.
# NEXT_PUBLIC_API_URL=https://api.barkpark.cloud

# Server-side read token. SERVER-ONLY (no NEXT_PUBLIC_ prefix → never bundled to
# the browser). Passed into the @barkpark/core client as `token`, sent as
# `Authorization: Bearer <token>` on every SSR fetch. Required for the scoped
# `/w/:workspace/p/:project/...` routes and the workspace/project switcher's
# tenancy fetches — without it those go anonymous and the API returns 403/401.
# Single-server-token model: all SSR requests share this one read token
# (per-user / per-request tokens would be a separate auth design).
# Unset → anonymous reads (flat public `/` routes still work).
# The token also authenticates the same-origin SSE proxy
# (app/v1/data/listen/[dataset]/route.ts) for live updates — it must carry
# `listen` permission for that to work.
# BARKPARK_TOKEN=
# DEPRECATED alias — still read as a fallback (lib/bp-env.ts): BARKPARK_READ_TOKEN

# Live updates (@barkpark/nextjs <BarkparkLive/>). Browser-exposed flag, OFF by
# default. Set to "1" ONLY once BARKPARK_TOKEN (with listen permission) is
# provisioned — otherwise the client retry-loops the listen stream and logs
# 406s. With both set, content changes auto-refresh the flat published surface.
# NEXT_PUBLIC_BARKPARK_LIVE=0

# Live per-keystroke search over a direct WebSocket (browser → API, bypassing
# the Vercel hop). BOTH must be set for the finder to use it; with either unset
# the finder stays on the same-origin /api/find HTTP path. Ships dark, like
# BARKPARK_LIVE above.
#   - WS endpoint: the Phoenix UserSocket mount. Derive from NEXT_PUBLIC_BARKPARK_API_URL
#     by swapping the scheme (https→wss) and appending /socket.
# NEXT_PUBLIC_BARKPARK_WS_URL=wss://api.barkpark.cloud/socket
#   - A READ-ONLY token scoped to the public workspace/dataset. This token REACHES
#     THE BROWSER, so it must grant nothing beyond the already-public published
#     reads the demo serves anyway (never the full BARKPARK_TOKEN if that
#     carries write/admin/other-workspace scope). The SearchChannel authorizes it
#     for :read on the topic's workspace and serves only published docs.
# NEXT_PUBLIC_BARKPARK_WS_TOKEN=


# ── Listing-directory map landing ────────────────────────────────────────────
# The "/" right pane defaults to the Barkpark docs graph. Set this to "map" to
# turn the landing into the place-directory map demo instead (this is what the
# templates/place-directory starter flips). Unset / any other value → graph.
# NEXT_PUBLIC_FINDER_LANDING=map
#
# When the map landing is active it shows every listing (components/listings-map.tsx),
# sourced by lib/listings.ts. Out of the box it shows a bundled sample set so
# the map renders with zero setup.
#
# Point it at a live source: set LISTINGS_TYPE to the content/document type to
# query (SERVER-ONLY — no NEXT_PUBLIC_ prefix). Rows are read from the same API
# as the rest of the demo (BARKPARK_DATASET) and any with a coordinate
# (geo.latitude/longitude, or flat lat/lng) become pins. Unset → sample data.
# LISTINGS_TYPE=place
# LISTINGS_LIMIT=500

# Basemap tiles (browser-fetched at runtime). Default is OpenStreetMap; override
# with any {z}/{x}/{y} raster template, or set MAP_TILES=off for a pins-only map
# with no external tile requests. Attribution is shown automatically for OSM.
#
# The app's own Content-Security-Policy has to allow whatever host you point
# this at, so `lib/csp.ts` derives the `img-src` entry from this value — but
# ONLY when NEXT_PUBLIC_FINDER_LANDING=map above (an allowed image host is a
# place an injected payload could send bytes, so the policy widens just for the
# surface that needs it). Set the landing and the tiles load; leave it unset and
# the map warns in the console rather than drawing a silently empty basemap.
# A {s} subdomain template is expanded to all of a/b/c, and a same-origin
# template (/tiles/{z}/{x}/{y}.png) needs nothing added — 'self' covers it.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILES=off
