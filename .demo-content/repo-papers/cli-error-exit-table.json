{"id":"b19","type":"callout","tone":"info","content":[{"type":"text","value":"Internal-only codes — NOT exit-mapped.","marks":["strong"]},{"type":"text","value":" "},{"type":"text","value":"\"legacy\"","marks":["code"]},{"type":"text","value":" and "},{"type":"text","value":"\"unknown\"","marks":["code"]},{"type":"text","value":" appear as the "},{"type":"text","value":"code","marks":["code"]},{"type":"text","value":" field "},{"type":"text","value":"inside","marks":["strong"]},{"type":"text","value":" a v2 validation "},{"type":"text","value":"violation","marks":["strong"]},{"type":"text","value":" object (the "},{"type":"text","value":"errors","marks":["code"]},{"type":"text","value":"/"},{"type":"text","value":"warnings","marks":["code"]},{"type":"text","value":"/"},{"type":"text","value":"infos","marks":["code"]},{"type":"text","value":" tree), never as the top-level "},{"type":"text","value":"error.code","marks":["code"]},{"type":"text","value":". They are per-violation labels for display, not process-exit signals. The CLI uses the top-level "},{"type":"text","value":"validation_failed","marks":["code"]},{"type":"text","value":" → exit "},{"type":"text","value":"5","marks":["code"]},{"type":"text","value":" and renders these violation codes in the message body."}]},
{"id":"b20","type":"heading","level":2,"text":"Envelope-version note (does not change the table)"},
{"id":"b21","type":"paragraph","content":[{"type":"text","value":"The v2 envelope (opt-in via "},{"type":"text","value":"Accept-Version: 2","marks":["code"]},{"type":"text","value":") only reshapes the "},{"type":"text","value":"validation_failed","marks":["code"]},{"type":"text","value":" "},{"type":"text","value":"422","marks":["strong"]},{"type":"text","value":" body — it swaps the flat "},{"type":"text","value":"details","marks":["code"]},{"type":"text","value":" map for an "},{"type":"text","value":"errors","marks":["code"]},{"type":"text","value":"/"},{"type":"text","value":"warnings","marks":["code"]},{"type":"text","value":"/"},{"type":"text","value":"infos","marks":["code"]},{"type":"text","value":" JSON-pointer tree. The top-level "},{"type":"text","value":"error.code","marks":["code"]},{"type":"text","value":" is identical across versions, so the exit-code mapping above is version-invariant. Every other code/status is byte-identical between v1 and v2."}]},
{"id":"b22","type":"heading","level":2,"text":"Schema field references"},
{"id":"b23","type":"paragraph","content":[{"type":"text","value":"This document keys off the v1 error "},{"type":"text","value":"envelope","marks":["strong"]},{"type":"text","value":" ("},{"type":"text","value":"error.code","marks":["code"]},{"type":"text","value":", "},{"type":"text","value":"error.message","marks":["code"]},{"type":"text","value":", "},{"type":"text","value":"error.details","marks":["code"]},{"type":"text","value":", "},{"type":"text","value":"error.request_id","marks":["code"]},{"type":"text","value":"), which is the API wire contract — distinct from the capabilities "},{"type":"text","value":"manifest","marks":["strong"]},{"type":"text","value":". Where it touches the manifest, it uses the frozen field names from "},{"type":"text","value":"manifest.schema.json","marks":["code"]},{"type":"text","value":": each command's required "},{"type":"text","value":"auth_tier","marks":["code"]},{"type":"text","value":" is what the CLI sends a credential for, and "},{"type":"text","value":"dry_run: false","marks":["code"]},{"type":"text","value":" is why "},{"type":"text","value":"--dry-run","marks":["code"]},{"type":"text","value":" degrades to client-side request-printing (see the M0 decisions doc). The manifest's per-command "},{"type":"text","value":"default_output: \"minimal\"","marks":["code"]},{"type":"text","value":" governs the receipt the CLI prints on a successful (exit "},{"type":"text","value":"0","marks":["code"]},{"type":"text","value":") write."}]}
],"related":["cli-m0-decisions"]}
