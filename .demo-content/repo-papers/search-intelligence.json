{"slug": "search-intelligence", "title": "Search Intelligence (Barkpark core)", "blocks": [{"id": "b1", "type": "ingress", "content": [{"type": "text", "value": "Surface-agnostic search analytics, crystallization, and improvement signals."}]}, {"id": "b2", "type": "paragraph", "content": [{"type": "text", "value": "Product surfaces (Media DAM, document search) plug in via thin adapters: adapter translates native API params → core context map → "}, {"type": "text", "value": "Barkpark.Search.Intelligence", "marks": ["code"]}, {"type": "text", "value": " (record · suggestions · insights · prune) → Postgres "}, {"type": "text", "value": "search_intel_*", "marks": ["code"]}, {"type": "text", "value": " tables keyed by "}, {"type": "text", "value": "surface", "marks": ["code"]}, {"type": "text", "value": " + "}, {"type": "text", "value": "scope", "marks": ["code"]}, {"type": "text", "value": ". Quality gate: "}, {"type": "text", "value": "Barkpark.Search.Sanitizer", "marks": ["code"]}, {"type": "text", "value": "; rollups: "}, {"type": "text", "value": "Barkpark.Search.Crystallizer", "marks": ["code"]}, {"type": "text", "value": "."}]}, {"id": "b3", "type": "heading", "level": 2, "text": "Design principles (do not break)"}, {"id": "b4", "type": "list", "ordered": true, "items": [[{"type": "text", "value": "Intelligence stays in Postgres", "marks": ["strong"]}, {"type": "text", "value": " — events, crystals, synonyms, merge patterns. No analytics in Typesense/Algolia even if an external retriever lands later (Phase 10)."}], [{"type": "text", "value": "Surfaces stay thin", "marks": ["strong"]}, {"type": "text", "value": " — adapters translate params; core owns rollups and improvement signals."}], [{"type": "text", "value": "Search never blocks on analytics", "marks": ["strong"]}, {"type": "text", "value": " — the record path must remain async-safe (Phase 9 makes this strict)."}], [{"type": "text", "value": "Every ranking change is measurable", "marks": ["strong"]}, {"type": "text", "value": " — golden-query harness before/after ("}, {"type": "text", "value": "mix search.eval", "marks": ["code"]}, {"type": "text", "value": ")."}], [{"type": "text", "value": "Admin promotes evidence, not hunches", "marks": ["strong"]}, {"type": "text", "value": " — synonym candidates carry CTR, transitions, confidence."}]]}, {"id": "b5", "type": "heading", "level": 2, "text": "Analytics ops contract"}, {"id": "b6", "type": "list", "ordered": false, "items": [[{"type": "text", "value": "Crystallize", "marks": ["strong"]}, {"type": "text", "value": " nightly at "}, {"type": "text", "value": "03:30 UTC", "marks": ["strong"]}, {"type": "text", "value": " ("}, {"type": "text", "value": "Barkpark.Search.Workers.Crystallize", "marks": ["code"]}, {"type": "text", "value": ", Oban cron "}, {"type": "text", "value": "\"30 3 * * *\"", "marks": ["code"]}, {"type": "text", "value": ") — rolls raw events into day/week/month crystals + merge patterns."}], [{"type": "text", "value": "Prune", "marks": ["strong"]}, {"type": "text", "value": " raw events at "}, {"type": "text", "value": "04:00 UTC", "marks": ["strong"]}, {"type": "text", "value": " ("}, {"type": "text", "value": "Barkpark.Search.Workers.Prune", "marks": ["code"]}, {"type": "text", "value": ", cron "}, {"type": "text", "value": "\"0 4 * * *\"", "marks": ["code"]}, {"type": "text", "value": "); retention default "}, {"type": "text", "value": "90 days", "marks": ["strong"]}, {"type": "text", "value": " ("}, {"type": "text", "value": "@retention_days 90", "marks": ["code"]}, {"type": "text", "value": " in "}, {"type": "text", "value": "intelligence.ex", "marks": ["code"]}, {"type": "text", "value": "). "}, {"type": "text", "value": "Crystals persist indefinitely.", "marks": ["strong"]}], [{"type": "text", "value": "Lineage:", "marks": ["strong"]}, {"type": "text", "value": " "}, {"type": "text", "value": "X-BP-Search-Parent", "marks": ["code"]}, {"type": "text", "value": " carries the previous event id to link refinement chains; the crystallizer additionally infers chains within "}, {"type": "text", "value": "30 min", "marks": ["strong"]}, {"type": "text", "value": " per actor when the header is absent."}]]}, {"id": "b7", "type": "heading", "level": 2, "text": "Key concepts"}, {"id": "b8", "type": "table", "head": [[{"type": "text", "value": "Term"}], [{"type": "text", "value": "Meaning"}], [{"type": "text", "value": "Media DAM example"}]], "rows": [[[{"type": "text", "value": "surface", "marks": ["strong"]}], [{"type": "text", "value": "Product area"}], [{"type": "text", "value": "\"media\"", "marks": ["code"]}]], [[{"type": "text", "value": "scope", "marks": ["strong"]}], [{"type": "text", "value": "Tenant partition"}], [{"type": "text", "value": "\"production\"", "marks": ["code"]}, {"type": "text", "value": " (dataset)"}]], [[{"type": "text", "value": "context", "marks": ["strong"]}], [{"type": "text", "value": "Normalized search state"}], [{"type": "text", "value": "%{query, filters, offset}", "marks": ["code"]}]], [[{"type": "text", "value": "crystal", "marks": ["strong"]}], [{"type": "text", "value": "Day/week/month aggregate"}], [{"type": "text", "value": "Popular query + filter fingerprint"}]], [[{"type": "text", "value": "merge pattern", "marks": ["strong"]}], [{"type": "text", "value": "Refinement transition"}], [{"type": "text", "value": "zero_to_hit", "marks": ["code"]}, {"type": "text", "value": ", "}, {"type": "text", "value": "facet_add", "marks": ["code"]}]]]}, {"id": "b9", "type": "paragraph", "content": [{"type": "text", "value": "Schemas: "}, {"type": "text", "value": "Barkpark.Search.{Event, Crystal, MergePattern, Synonyms}", "marks": ["code"]}, {"type": "text", "value": " (synonym map + candidates, Phase 4)."}]}, {"id": "b10", "type": "heading", "level": 2, "text": "Adapters"}, {"id": "b11", "type": "paragraph", "content": [{"type": "text", "value": "Barkpark.Media.SearchIntelligence", "marks": ["code"]}, {"type": "text", "value": " is the only mod