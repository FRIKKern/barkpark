e":"text","value":" is sufficient."}]},{"id":"b5","type":"paragraph","content":[{"type":"text","value":"phx-update=\"ignore\"","marks":["code"]},{"type":"text","value":" on the wrapper.","marks":["strong"]},{"type":"text","value":" Without it, LV re-renders the inner DOM on every autosave reply, resetting the WC's internal state and dropping unsent keystrokes. This is the single most common pitfall; it is non-optional."}]},{"id":"b6","type":"paragraph","content":[{"type":"text","value":"execCommand(\"insertText\")","marks":["code"]},{"type":"text","value":" for paste (v1 richText).","marks":["strong"]},{"type":"text","value":" Strips formatting, inserts plain text. Safe XSS default. v2 will migrate to ProseMirror / TipTap or a manual paste sanitiser. The deprecated status is accepted for v1; document if a publisher complains."}]},{"id":"b7","type":"paragraph","content":[{"type":"text","value":"<script defer>","marks":["code"]},{"type":"text","value":" BEFORE "},{"type":"text","value":"phoenix.js","marks":["code"]},{"type":"text","value":".","marks":["strong"]},{"type":"text","value":" Custom element scripts must be loaded with "},{"type":"text","value":"defer","marks":["code"]},{"type":"text","value":" and placed BEFORE "},{"type":"text","value":"phoenix_live_view.js","marks":["code"]},{"type":"text","value":" in "},{"type":"text","value":"root.html.heex","marks":["code"]},{"type":"text","value":". Without "},{"type":"text","value":"defer","marks":["code"]},{"type":"text","value":", LV may mount before the element is registered — the unupgraded element renders empty until late upgrade fires."}]},{"id":"b8","type":"paragraph","content":[{"type":"text","value":"v2 deferral: "},{"type":"text","value":"setValue(v)","marks":["code"]},{"type":"text","value":" for server-pushed updates.","marks":["strong"]},{"type":"text","value":" "},{"type":"text","value":"phx-update=\"ignore\"","marks":["code"]},{"type":"text","value":" blocks server-driven value sync. v1 defers collaborative editing; if needed, a "},{"type":"text","value":"bp-set-value","marks":["code"]},{"type":"text","value":" "},{"type":"text","value":"push_event","marks":["code"]},{"type":"text","value":" channel would let the WC reflect updates via "},{"type":"text","value":"setValue(v)","marks":["code"]},{"type":"text","value":"."}]},{"id":"b9","type":"heading","level":2,"text":"Field-bridge pattern"},{"id":"b10","type":"paragraph","content":[{"type":"text","value":"BarkparkFieldBridge","marks":["code"]},{"type":"text","value":" hook — field-agnostic, mounts on a wrapper "},{"type":"text","value":"<div>","marks":["code"]},{"type":"text","value":" containing both the hidden input and the WC."}]},{"id":"b11","type":"paragraph","content":[{"type":"text","value":"The bridge listens for "},{"type":"text","value":"bp-change","marks":["code"]},{"type":"text","value":" on the wrapper, reads "},{"type":"text","value":"event.target.dataset.bridgeTarget","marks":["code"]},{"type":"text","value":" to find the hidden input by id, writes "},{"type":"text","value":"event.detail.value","marks":["code"]},{"type":"text","value":" into the input, dispatches a synthetic "},{"type":"text","value":"input","marks":["code"]},{"type":"text","value":" event → LV's existing debounce + serialize + push round-trip fires exactly as for native inputs."}]},{"id":"b12","type":"paragraph","content":[{"type":"text","value":"Required wrapper attributes:"}]},{"id":"b13","type":"list","ordered":false,"items":[[{"type":"text","value":"id","marks":["code"]},{"type":"text","value":" — required by "},{"type":"text","value":"phx-hook","marks":["code"]},{"type":"text","value":" (LV reconciliation) and "},{"type":"text","value":"phx-update=\"ignore\"","marks":["code"]},{"type":"text","value":" (element lookup)"}],[{"type":"text","value":"phx-update=\"ignore\"","marks":["code"]},{"type":"text","value":" — see above"}],[{"type":"text","value":"phx-hook=\"BarkparkFieldBridge\"","marks":["code"]}]]},{"id":"b14","type":"pa