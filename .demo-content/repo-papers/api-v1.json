[{"type":"text","value":"Does ","marks":["strong"]},{"type":"text","value":"delete","marks":["code","strong"]},{"type":"text","value":" require ","marks":["strong"]},{"type":"text","value":"type","marks":["code","strong"]},{"type":"text","value":"? — needs-verification against prod.","marks":["strong"]},{"type":"text","value":" In code, "},{"type":"text","value":"Content.apply_one/3","marks":["code"]},{"type":"text","value":" matches "},{"type":"text","value":"%{\"delete\" => %{\"id\" => _, \"type\" => _}}","marks":["code"]},{"type":"text","value":"; a "},{"type":"text","value":"delete","marks":["code"]},{"type":"text","value":" without "},{"type":"text","value":"type","marks":["code"]},{"type":"text","value":" falls to the catch-all → "},{"type":"text","value":"400 malformed","marks":["code"]},{"type":"text","value":", matching §6's shape. NOT yet tested against the prod mutate endpoint — confirm there before relying on the without-"},{"type":"text","value":"type","marks":["code"]},{"type":"text","value":" error shape; file a bd issue if prod diverges."}]
]}
