        [
          {
            "type": "text",
            "value": "Backlinks panel lists linked + unlinked mentions for the open doc; clicking navigates"
          }
        ],
        [
          {
            "type": "text",
            "value": "Properties panel edits bound fields (incl. aliases, tags) and round-trips through the projection"
          }
        ],
        [
          {
            "type": "text",
            "value": "Callouts fold/unfold; typing "
