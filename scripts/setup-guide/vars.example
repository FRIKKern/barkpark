# Vars for scripts/run-setup-guide.sh on docs/setup/SELF-HOST.md, Path A.
# Copy this directory out of the repository, fill it in, and run:
#   scripts/setup-guide/azure.sh up "$RG"
#   scripts/run-setup-guide.sh --path a --vars <copy>/vars
#   scripts/setup-guide/azure.sh down "$RG"
# <name> in the guide takes the value of key name. A value that starts with
# $( runs once, when a step first needs it. Keys holding SECRET, TOKEN,
# PASSWORD or KEY are masked in all output.

RG=rg-barkpark-guide-run
DNS_LABEL=bp-guide-run
host=bp-guide-run.swedencentral.cloudapp.azure.com
ip=$(az vm show -d -g "$RG" -n barkpark --query publicIps -o tsv)
vm_ssh=$(printf 'azureuser@%s' "$(az vm show -d -g "$RG" -n barkpark --query publicIps -o tsv)")

# Values the settings hook writes into barkpark.env.
owner_email=owner@example.com
operator_emails=owner@example.com
breakglass_email=breakglass@example.com
studio_origin=https://studio.example.com
