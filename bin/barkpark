#!/usr/bin/env bash
#
# barkpark — one-command entrypoint for a personal-local install (Wave 5).
#
#   barkpark up        ensure secrets → start managed Postgres → migrate →
#                      boot the server → print the URL. Safe to re-run: it says
#                      "already running" only when a listener on the port
#                      ANSWERS, never on the strength of a pidfile.
#   barkpark reload    restart the server so config changes take effect.
#                      (See "CONFIG-RELOAD FOOTGUN" below.)
#   barkpark stop      stop the server and the managed Postgres — killing only a
#                      process it can identify as ours, never a stranger that
#                      happens to hold the port.
#   barkpark status    report Postgres + the OBSERVED server state — one of
#                      ANSWERING / PROCESS-ALIVE-NOT-ANSWERING / STOPPED /
#                      UNKNOWN, decided from the port and an HTTP answer,
#                      never from a pidfile alone.
#   barkpark psql ...  open a psql shell on the managed Postgres.
#
# ── CONFIG-RELOAD FOOTGUN ─────────────────────────────────────────────────────
# Barkpark reads its secrets and tokens from ~/.barkpark/.env at BOOT only.
# Neither the dev server (`mix phx.server`) nor a `mix release` hot-reloads
# config/*.exs or re-reads the env file while running. So if you change a value
# in ~/.barkpark/.env — most commonly BARKPARK_INGEST_TOKEN — the running
# server keeps the OLD value until it is restarted.
#
#   THIS IS WHY `barkpark reload` EXISTS. It is a full stop + start of the
#   server process (Postgres keeps running), which re-sources ~/.barkpark/.env
#   and re-runs config/runtime.exs. Use it after editing the env file:
#
#       $EDITOR ~/.barkpark/.env      # change BARKPARK_INGEST_TOKEN
#       barkpark reload               # new token now in effect
#
# POSIX-friendly bash.
set -euo pipefail

# ── Paths ────────────────────────────────────────────────────────────────────

BIN_DIR="$(cd -P -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(cd -P -- "$BIN_DIR/.." && pwd)"
API_DIR="$REPO_ROOT/api"
PG="$BIN_DIR/barkpark-pg"

# Export BARKPARK_HOME (and the PG port, if set) so the child barkpark-pg always
# resolves the SAME data dir / port as this script — otherwise a user who set
# BARKPARK_HOME via the script's own default (not an exported env var) could end
# up with the parent and the PG helper disagreeing on locations.
export BARKPARK_HOME="${BARKPARK_HOME:-$HOME/.barkpark}"
if [ -n "${BARKPARK_PG_PORT:-}" ]; then export BARKPARK_PG_PORT; fi
ENV_FILE="$BARKPARK_HOME/.env"
SERVER_PID_FILE="$BARKPARK_HOME/server.pid"
SERVER_LOG="$BARKPARK_HOME/server.log"

PORT="${PORT:-4000}"
PHX_HOST="${PHX_HOST:-localhost}"

# `barkpark up` boots in :prod so config/runtime.exs's prod branch runs — that
# branch is the ONLY one that reads DATABASE_URL (→ managed Postgres on :5433),
# SECRET_KEY_BASE, PREVIEW_JWT_SECRET, PHX_HOST, and BARKPARK_CLOAK_KEY from the
# env file. Booting in :dev would silently use the hardcoded barkpark_dev DB on
# :5432 from config/dev.exs and ignore the managed instance entirely. Keeping
# MIX_ENV=prod here is what makes the managed-Postgres + first-run-secrets path
# actually load-bearing, and it leaves the dev database completely untouched.
export MIX_ENV="${BARKPARK_MIX_ENV:-prod}"
# runtime.exs reads PHX_SCHEME (default "http"); localhost over http is fine and
# avoids the https+IP check_origin trap documented in runtime.exs.
export PHX_SCHEME="${PHX_SCHEME:-http}"

log() { printf 'barkpark: %s\n' "$*"; }
die() { printf 'barkpark: %s\n' "$*" >&2; exit 1; }

# ── T5.4 secrets — first-run generation, idempotent reuse ────────────────────
#
# Delegates to Barkpark.Release.Secrets.write_env/1, which generates the three
# crypto secrets + placeholders into ~/.barkpark/.env on first run and only
# appends MISSING keys on later runs (existing values are never overwritten and
# never printed). Runs with --no-start so booting the supervision tree is not
# triggered just to write a file.
ensure_secrets() {
  if [ -f "$ENV_FILE" ]; then
    log "reusing secrets at $ENV_FILE"
  else
    log "generating first-run secrets at $ENV_FILE"
  fi
  # write_env/1 is idempotent either way; call it on every `up` so a partially
  # filled .env (e.g. user added DATABASE_URL but no secrets) is topped up.
  #
  # Run this step under MIX_ENV=dev, NOT prod: config/runtime.exs's prod branch
  # RAISES when SECRET_KEY_BASE/DATABASE_URL/… are missing, which is exactly the
  # state we are in on a first run. The dev branch has no such raise, and
  # Barkpark.Release.Secrets has zero compile-time coupling to the repo, so the
  # file write is unaffected by the env. (--no-start avoids booting the tree.)
  # Pass the explicit ENV_FILE path so the shell and Elixir can never disagree
  # on the location (write_env/1 also honors BARKPARK_HOME, but being explicit
  # is belt-and-suspenders and survives a future default-path change).
  ( cd "$API_DIR" && MIX_ENV=dev mix run --no-start -e \
      "Barkpark.Release.Secrets.write_env(\"$ENV_FILE\") |> elem(1) |> IO.puts()" \
      >/dev/null )
}

# ── PDS W1 — personal-local is the pull TARGET, so it opts into bundle import ──
#
# The free Personal-Local twin exists to PULL a cloud workspace's data down into
# it (bp cloud workspace import), so it turns the fail-closed
# BARKPARK_ALLOW_BUNDLE_IMPORT switch ON. Append only if the key is ABSENT — a
# user who set =0 by hand is never clobbered (mirrors write_env's idempotency).
# Runs after ensure_secrets so ENV_FILE always exists.
ensure_bundle_import_flag() {
  if grep -q '^BARKPARK_ALLOW_BUNDLE_IMPORT=' "$ENV_FILE" 2>/dev/null; then
    return 0
  fi
  printf 'BARKPARK_ALLOW_BUNDLE_IMPORT=1\n' >>"$ENV_FILE"
  log "enabled bundle import (BARKPARK_ALLOW_BUNDLE_IMPORT=1) — personal-local is a pull target"
}

# Load ~/.barkpark/.env into the environment, then override DATABASE_URL to the
# managed Postgres so the .env placeholder (default :5432) never wins. PORT and
# PHX_HOST come from the env file if set there, else the defaults above.
load_env() {
  if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
  fi
  # Managed Postgres URL is authoritative — it knows the real (non-default) port.
  DATABASE_URL="$("$PG" url)"
  export DATABASE_URL
  export PORT
  export PHX_HOST
}

# ── server lifecycle ─────────────────────────────────────────────────────────
#
# The pidfile records the PID of the ACTUAL beam.smp listening on $PORT — not
# the `mix phx.server` launcher. `mix phx.server` exec-replaces itself with (or
# detaches) the BEAM, so the launcher PID dies after boot and is useless for
# stop/reload. We resolve the listener PID via lsof after the port comes up and
# store that, so stop/reload always target the right process.

# PID of whatever is listening on our HTTP port, or empty.
listener_pid() {
  lsof -nP -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1
}

# `up` decides from the OBSERVED port, never from the pidfile alone — the same
# rule `status` follows (see cmd_status). A pidfile is a CLAIM: it can name a
# recycled PID or a leftover `sleep`, and deciding on a bare `kill -0` of it made
# `barkpark up` print "server already running" and exit 0 with NOTHING listening.
# On a personal instance nobody is watching that, so it is a silent no-op that
# reports success. The pidfile is bookkeeping to be reconciled, not evidence.
start_server() {
  local lpid claim
  lpid="$(listener_pid || true)"
  claim="$(cat "$SERVER_PID_FILE" 2>/dev/null || true)"

  if [ -n "$lpid" ]; then
    if server_answering; then
      # Corroborated: something holds the port AND serves the Barkpark API.
      if [ "$claim" != "$lpid" ]; then
        if [ -n "$claim" ]; then
          log "note: $SERVER_PID_FILE claimed pid $claim, which is NOT the process holding port $PORT — recording $lpid instead"
        fi
        mkdir -p "$BARKPARK_HOME"
        echo "$lpid" >"$SERVER_PID_FILE"
      fi
      log "server already running (pid $lpid) — ANSWERING on http://$PHX_HOST:$PORT/studio"
      return 0
    fi
    die "port $PORT is held by pid $lpid but http://$PHX_HOST:$PORT/api/schemas does not answer — a wedged server, one still booting, or something else entirely. Run 'barkpark status', then stop it (kill $lpid) or set PORT=<other>; see $SERVER_LOG"
  fi

  # Nothing is listening, so ANY pidfile here is a claim we cannot corroborate:
  # that pid — alive or not — is not serving Barkpark on this port. Say so and
  # discard it rather than reporting a running server that does not exist.
  if [ -n "$claim" ]; then
    if kill -0 "$claim" 2>/dev/null; then
      log "ignoring stale $SERVER_PID_FILE — it claims pid $claim is alive, but nothing is listening on port $PORT"
    fi
    rm -f "$SERVER_PID_FILE"
  fi

  log "booting server on http://$PHX_HOST:$PORT (MIX_ENV=$MIX_ENV)"
  mkdir -p "$BARKPARK_HOME"
  # Boot via mix phx.server in MIX_ENV=prod (exported at top): runtime.exs reads
  # the managed DATABASE_URL + the generated secrets from the now-loaded env.
  # PHX_SERVER=true flips the endpoint's server flag so it actually listens.
  # nohup so `up` returns to the shell; the real PID is captured below.
  ( cd "$API_DIR" && nohup env PHX_SERVER=true mix phx.server >>"$SERVER_LOG" 2>&1 & )
  wait_server
  # Record the actual listening beam PID (not the launcher) for stop/reload.
  local pid
  pid="$(listener_pid)"
  if [ -z "$pid" ]; then
    die "server answered but no listener PID found on port $PORT — see $SERVER_LOG"
  fi
  echo "$pid" >"$SERVER_PID_FILE"
  log "server up (pid $pid) — http://$PHX_HOST:$PORT/studio"
}

wait_server() {
  local i
  for i in $(seq 1 60); do
    if curl -sf "http://$PHX_HOST:$PORT/api/schemas" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  die "server did not answer on http://$PHX_HOST:$PORT within 60s — see $SERVER_LOG"
}

# `stop` proves identity BEFORE it kills. The old fallback took listener_pid()
# on $PORT — whose default is 4000 (:50) — whenever the pidfile was stale, so a
# leftover pidfile could make `barkpark stop` SIGKILL an unrelated process that
# happened to hold 4000. A process is ours on exactly two proofs: the pidfile
# names the pid that HOLDS the port, or the thing holding the port ANSWERS the
# Barkpark API. Anything else we refuse to kill, and we say why.
stop_server() {
  local claim lpid pid why
  claim="$(cat "$SERVER_PID_FILE" 2>/dev/null || true)"
  lpid="$(listener_pid || true)"
  pid=""
  why=""

  if [ -n "$claim" ] && [ "$claim" = "$lpid" ]; then
    pid="$claim"
    why="$SERVER_PID_FILE names the pid holding port $PORT"
  elif [ -n "$lpid" ] && server_answering; then
    pid="$lpid"
    why="it answers http://$PHX_HOST:$PORT/api/schemas"
  fi

  if [ -z "$pid" ]; then
    if [ -n "$lpid" ]; then
      log "refusing to stop pid $lpid — it holds port $PORT but does not answer http://$PHX_HOST:$PORT/api/schemas and $SERVER_PID_FILE does not name it, so it is not identifiably Barkpark. Nothing was killed (run 'kill $lpid' yourself if it is yours)."
    elif [ -n "$claim" ] && kill -0 "$claim" 2>/dev/null; then
      log "not stopping pid $claim — $SERVER_PID_FILE claims it, but nothing is listening on port $PORT. Stale pidfile: discarding it without killing anything."
    else
      log "server not running"
    fi
    rm -f "$SERVER_PID_FILE"
    return 0
  fi

  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    log "stopping server (pid $pid — $why)"
    kill "$pid" 2>/dev/null || true
    # Wait for it to actually release the port (graceful BEAM shutdown).
    local i
    for i in $(seq 1 15); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
    done
    kill -9 "$pid" 2>/dev/null || true
  else
    log "server not running"
  fi
  rm -f "$SERVER_PID_FILE"
}

# ── migrations ───────────────────────────────────────────────────────────────

migrate() {
  log "running migrations"
  ( cd "$API_DIR" && mix ecto.migrate )
}

# ── subcommands ──────────────────────────────────────────────────────────────

cmd_up() {
  command -v mix >/dev/null 2>&1 || die "mix not found on PATH — install Elixir"
  ensure_secrets        # T5.4
  ensure_bundle_import_flag  # PDS W1 — local twin is the pull target
  "$PG" start           # T5.2 — managed Postgres on :5433
  load_env              # pulls DATABASE_URL from the managed instance
  migrate               # apply schema to the managed DB
  start_server          # T5.3 — boot + wait + print URL
}

# T5.6 — restart the server so a changed ~/.barkpark/.env takes effect.
# Postgres is normally left running; only the BEAM is recycled. We still call
# `barkpark-pg start` (idempotent — a no-op if already up) so a reload after a
# machine reboot, where the managed Postgres is down, brings it back before the
# server boots in :prod and tries to connect to the managed DB.
cmd_reload() {
  log "reload: restarting server so config changes take effect"
  stop_server
  "$PG" start >/dev/null
  load_env
  start_server
}

cmd_stop() {
  stop_server
  "$PG" stop
}

# Does the server ANSWER? The same probe wait_server uses to decide the boot
# succeeded — liveness is "it serves HTTP", never "a pid exists".
server_answering() {
  curl -sf "http://$PHX_HOST:$PORT/api/schemas" >/dev/null 2>&1
}

# version + commit of the RUNNING server, read back from its own /status.json
# (public, unauthenticated). Empty when the endpoint is absent or unparseable —
# an older build answers /api/schemas but may not carry /status.json.
running_version() {
  local body version commit
  body="$(curl -sf "http://$PHX_HOST:$PORT/status.json" 2>/dev/null || true)"
  [ -n "$body" ] || return 0
  version="$(printf '%s' "$body" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')"
  commit="$(printf '%s' "$body" | sed -n 's/.*"commit":"\([^"]*\)".*/\1/p')"
  # The server reports version "unknown" when it was not built from a tag; the
  # commit sha is then the only real identity — do not print "running unknown".
  [ "$version" = "unknown" ] && version=""
  [ "$commit" = "unknown" ] && commit=""
  if [ -n "$version" ] && [ -n "$commit" ]; then
    echo "$version ($commit)"
  elif [ -n "$commit" ]; then
    echo "$commit"
  elif [ -n "$version" ]; then
    echo "$version"
  fi
}

# `status` reports what it can OBSERVE, never what a pidfile asserts. A pidfile
# is a claim; the port and an HTTP answer are the state. Both failure directions
# were observed on a dev box before this: a pidfile pointing at an unrelated
# `sleep` printed "server running", and with no pidfile at all it printed
# "server stopped" while beam.smp held :4000 and /api/schemas returned 200.
#
# FOUR OUTCOMES — there is no bare "running":
#   ANSWERING                    port held AND /api/schemas answers (+ version/commit)
#   PROCESS-ALIVE-NOT-ANSWERING  port held, HTTP does not answer (booting or wedged)
#   STOPPED                      nothing holds the port
#   UNKNOWN                      pidfile claims a live pid that does NOT hold the port
cmd_status() {
  "$PG" status || true

  local lpid ppid_claim ver
  # `|| true`: lsof exits non-zero when nothing holds the port, and under
  # `set -euo pipefail` that would abort status before it could report STOPPED.
  lpid="$(listener_pid || true)"
  ppid_claim="$(cat "$SERVER_PID_FILE" 2>/dev/null || true)"

  if [ -n "$lpid" ]; then
    if server_answering; then
      ver="$(running_version)"
      if [ -n "$ver" ]; then
        log "server ANSWERING (pid $lpid) — http://$PHX_HOST:$PORT — running $ver"
      else
        log "server ANSWERING (pid $lpid) — http://$PHX_HOST:$PORT — version unknown (/status.json not served)"
      fi
    else
      log "server PROCESS-ALIVE-NOT-ANSWERING — pid $lpid holds port $PORT but http://$PHX_HOST:$PORT/api/schemas did not answer — see $SERVER_LOG"
    fi
    if [ -n "$ppid_claim" ] && [ "$ppid_claim" != "$lpid" ]; then
      log "note: $SERVER_PID_FILE claims pid $ppid_claim, which is NOT the process holding port $PORT"
    fi
    return 0
  fi

  # Nothing is listening. A pidfile pointing at a live process is then a claim
  # we cannot corroborate — that process is not serving Barkpark on this port.
  if [ -n "$ppid_claim" ] && kill -0 "$ppid_claim" 2>/dev/null; then
    log "server UNKNOWN — $SERVER_PID_FILE claims pid $ppid_claim is alive, but nothing is listening on port $PORT (stale pidfile, or the server is on another port)"
    return 0
  fi

  log "server STOPPED — nothing is listening on port $PORT"
}

case "${1:-up}" in
  up)     cmd_up ;;
  reload) cmd_reload ;;
  stop)   cmd_stop ;;
  status) cmd_status ;;
  psql)   shift || true; exec "$PG" psql "$@" ;;
  *)
    echo "usage: barkpark {up|reload|stop|status|psql}" >&2
    exit 2
    ;;
esac
