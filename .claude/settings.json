{
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/doctor.sh --hook"
          },
          {
            "type": "command",
            "command": "bash scripts/ensure-bp.sh"
          }
        ]
      }
    ]
  }
}
